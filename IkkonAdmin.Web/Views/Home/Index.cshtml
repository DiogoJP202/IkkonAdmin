@model DashboardViewModel
@{
    ViewData["Title"] = I18n["Dashboard", "Dashboard"];

    var meses = new[]
    {
        new { Valor = 1, Nome = I18n["Janeiro", "January"] },
        new { Valor = 2, Nome = I18n["Fevereiro", "February"] },
        new { Valor = 3, Nome = I18n["Março", "March"] },
        new { Valor = 4, Nome = I18n["Abril", "April"] },
        new { Valor = 5, Nome = I18n["Maio", "May"] },
        new { Valor = 6, Nome = I18n["Junho", "June"] },
        new { Valor = 7, Nome = I18n["Julho", "July"] },
        new { Valor = 8, Nome = I18n["Agosto", "August"] },
        new { Valor = 9, Nome = I18n["Setembro", "September"] },
        new { Valor = 10, Nome = I18n["Outubro", "October"] },
        new { Valor = 11, Nome = I18n["Novembro", "November"] },
        new { Valor = 12, Nome = I18n["Dezembro", "December"] }
    };

    var anos = Enumerable.Range(Model.AnoReferencia - 1, 3);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var pendenciasCriticas = Model.Inadimplentes.Count(x => x.MaiorDiasAtraso >= 15);
    var vencemHoje = Model.ProximosVencimentos.Count(x => x.DiasParaVencimento == 0);
    var vencemAteTresDias = Model.ProximosVencimentos.Count(x => x.DiasParaVencimento >= 0 && x.DiasParaVencimento <= 3);
    var totalAbertoCompetencia = Model.ProximosVencimentos.Sum(x => x.Valor);
    var culturaAtual = System.Globalization.CultureInfo.CurrentCulture;
}

@functions {
    private static string VencimentoClasse(int diasParaVencimento, StatusMensalidadeEnum status)
    {
        if (diasParaVencimento < 0 || status == StatusMensalidadeEnum.Atrasado)
        {
            return "is-overdue";
        }

        if (diasParaVencimento == 0)
        {
            return "is-today";
        }

        if (diasParaVencimento <= 3)
        {
            return "is-soon";
        }

        return "is-open";
    }

    private static string VencimentoTexto(int diasParaVencimento, StatusMensalidadeEnum status)
    {
        var isEnglish = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase);

        if (diasParaVencimento < 0 || status == StatusMensalidadeEnum.Atrasado)
        {
            var dias = Math.Abs(diasParaVencimento);
            if (isEnglish)
            {
                return $"{dias} {(dias == 1 ? "day" : "days")} overdue";
            }

            return $"{dias} {(dias == 1 ? "dia" : "dias")} em atraso";
        }

        if (diasParaVencimento == 0)
        {
            return isEnglish ? "Due today" : "Vence hoje";
        }

        if (diasParaVencimento == 1)
        {
            return isEnglish ? "Due tomorrow" : "Vence amanhã";
        }

        return isEnglish ? $"Due in {diasParaVencimento} days" : $"Vence em {diasParaVencimento} dias";
    }

    private static string RiscoClasse(int maiorDiasAtraso)
    {
        if (maiorDiasAtraso >= 30)
        {
            return "is-critical";
        }

        if (maiorDiasAtraso >= 10)
        {
            return "is-attention";
        }

        return "is-moderate";
    }

    private static string InicialAluno(string nome)
    {
        return string.IsNullOrWhiteSpace(nome)
            ? "A"
            : nome.Trim()[0].ToString().ToUpperInvariant();
    }
}

<div class="dashboard-v2-page">
    <section class="dashboard-v2-hero mb-4">
        <div class="dashboard-v2-hero-copy">
            <span class="dashboard-v2-eyebrow">@I18n["Central operacional", "Operations center"]</span>
            <h1>@I18n["Dashboard administrativo", "Administrative dashboard"]</h1>
            <p>
                @I18n["Acompanhe alunos, mensalidades, inadimplência e atividades recentes em uma visão direta para a rotina da escola.", "Track students, monthly fees, overdue payments, and recent activity in a direct view for the school's routine."]
            </p>

            <div class="dashboard-v2-meta">
                <span>@I18n["Competência", "Period"] <strong>@Model.MesAnoReferenciaDescricao</strong></span>
                <span>@I18n["Inadimplentes", "Overdue students"] <strong>@Model.QuantidadeAlunosInadimplentes</strong></span>
                <span>@I18n["Pendências críticas", "Critical pending items"] <strong>@pendenciasCriticas</strong></span>
            </div>
        </div>

        <form asp-action="Index" method="get" class="dashboard-v2-filter-card">
            <div class="dashboard-v2-filter-heading">
                <strong>@I18n["Filtros do painel", "Dashboard filters"]</strong>
                <span>@I18n["Refine a operação por competência e turma.", "Refine the operation by period and group."]</span>
            </div>

            <div class="dashboard-v2-filter-grid">
                <div class="dashboard-v2-field">
                    <label for="mesReferencia">@I18n["Mês de referência", "Reference month"]</label>
                    <select id="mesReferencia" name="mesReferencia" class="form-select dashboard-v2-control" aria-label="@I18n["Mês de referência", "Reference month"]">
                        @foreach (var mes in meses)
                        {
                            if (mes.Valor == Model.MesReferencia)
                            {
                                <option value="@mes.Valor" selected>@mes.Nome</option>
                            }
                            else
                            {
                                <option value="@mes.Valor">@mes.Nome</option>
                            }
                        }
                    </select>
                </div>

                <div class="dashboard-v2-field">
                    <label for="anoReferencia">@I18n["Ano", "Year"]</label>
                    <select id="anoReferencia" name="anoReferencia" class="form-select dashboard-v2-control" aria-label="@I18n["Ano de referência", "Reference year"]">
                        @foreach (var ano in anos)
                        {
                            if (ano == Model.AnoReferencia)
                            {
                                <option value="@ano" selected>@ano</option>
                            }
                            else
                            {
                                <option value="@ano">@ano</option>
                            }
                        }
                    </select>
                </div>

                <div class="dashboard-v2-field dashboard-v2-field-wide">
                    <label for="turmaId">@I18n["Turma", "Group"]</label>
                    <select id="turmaId" name="turmaId" class="form-select dashboard-v2-control" aria-label="@I18n["Filtrar por turma", "Filter by group"]">
                        <option value="">@I18n["Todas as turmas", "All groups"]</option>
                        @foreach (var turma in Model.TurmasDisponiveis)
                        {
                            if (Model.TurmaIdFiltro.HasValue && turma.Id == Model.TurmaIdFiltro.Value)
                            {
                                <option value="@turma.Id" selected>@turma.Nome</option>
                            }
                            else
                            {
                                <option value="@turma.Id">@turma.Nome</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <button type="submit" class="btn dashboard-v2-btn dashboard-v2-btn-primary w-100">
                @I18n["Aplicar filtros", "Apply filters"]
            </button>
        </form>
    </section>

    <section class="dashboard-v2-actions mb-4" aria-label="@I18n["Ações rápidas", "Quick actions"]">
        <a asp-controller="Financeiro"
           asp-action="RegistrarPagamento"
           asp-route-returnUrl="@returnUrl"
           class="dashboard-v2-action-card">
            <span>@I18n["Pagamento", "Payment"]</span>
            <strong>@I18n["Registrar pagamento", "Register payment"]</strong>
            <small>@I18n["Baixe mensalidades manualmente.", "Settle monthly fees manually."]</small>
        </a>

        <a asp-controller="Financeiro" asp-action="Index" class="dashboard-v2-action-card">
            <span>@I18n["Financeiro", "Finance"]</span>
            <strong>@I18n["Abrir financeiro", "Open finance"]</strong>
            <small>@I18n["Consulte cobranças e histórico.", "Review charges and history."]</small>
        </a>

        <form asp-controller="Financeiro" asp-action="GerarMensalidades" method="post" class="dashboard-v2-action-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="anoCompetenciaGeracao" value="@Model.AnoReferencia" />
            <input type="hidden" name="mesCompetenciaGeracao" value="@Model.MesReferencia" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="dashboard-v2-action-card dashboard-v2-action-button">
                <span>@I18n["Competência", "Period"]</span>
                <strong>@I18n["Gerar mensalidades", "Generate monthly fees"]</strong>
                <small>@I18n["Crie cobranças para o mês selecionado.", "Create charges for the selected month."]</small>
            </button>
        </form>

        <a asp-controller="Alunos" asp-action="Create" class="dashboard-v2-action-card">
            <span>@I18n["Alunos", "Students"]</span>
            <strong>@I18n["Cadastrar aluno", "Register student"]</strong>
            <small>@I18n["Inclua um novo aluno na base.", "Add a new student to the database."]</small>
        </a>
    </section>

    <section class="dashboard-v2-kpi-grid mb-4" aria-label="@I18n["Indicadores principais", "Main indicators"]">
        <article class="dashboard-v2-kpi-card">
            <div class="dashboard-v2-kpi-top">
                <span>@I18n["Alunos ativos", "Active students"]</span>
                <b>@I18n["Base", "Base"]</b>
            </div>
            <strong>@Model.QuantidadeAlunosAtivos</strong>
            <small>@I18n["Alunos em operação na escola.", "Students active in the school."]</small>
        </article>

        <article class="dashboard-v2-kpi-card is-warning">
            <div class="dashboard-v2-kpi-top">
                <span>@I18n["Pendentes", "Pending"]</span>
                <b>@Model.MesAnoReferenciaDescricao</b>
            </div>
            <strong>@Model.MensalidadesPendentes</strong>
            <small>@totalAbertoCompetencia.ToString("C") @I18n["em cobranças abertas.", "in open charges."]</small>
        </article>

        <article class="dashboard-v2-kpi-card is-danger">
            <div class="dashboard-v2-kpi-top">
                <span>@I18n["Atrasadas", "Overdue"]</span>
                <b>@I18n["Prioridade", "Priority"]</b>
            </div>
            <strong>@Model.MensalidadesAtrasadas</strong>
            <small>@Model.QuantidadeAlunosInadimplentes @I18n["aluno(s) com atraso.", "student(s) overdue."]</small>
        </article>

        <article class="dashboard-v2-kpi-card is-success">
            <div class="dashboard-v2-kpi-top">
                <span>@I18n["Receita recebida", "Revenue received"]</span>
                <b>@I18n["Mês", "Month"]</b>
            </div>
            <strong>@Model.ReceitaRecebidaNoMes.ToString("C")</strong>
            <small>@I18n["Total em atraso", "Total overdue"]: @Model.TotalEmAtraso.ToString("C").</small>
        </article>
    </section>

    <section class="dashboard-v2-main-grid mb-4">
        <div class="dashboard-v2-panel dashboard-v2-panel-large">
            <div class="dashboard-v2-panel-heading">
                <div>
                    <span class="dashboard-v2-eyebrow">@I18n["Cobranças", "Charges"]</span>
                    <h2>@I18n["Agenda de cobrança", "Billing agenda"]</h2>
                    <p>@vencemHoje @I18n["vencendo hoje", "due today"], @vencemAteTresDias @I18n["vencendo em até 3 dias", "due within 3 days"].</p>
                </div>
                <a asp-controller="Financeiro" asp-action="Index" class="btn dashboard-v2-btn dashboard-v2-btn-ghost">
                    @I18n["Ver financeiro", "View finance"]
                </a>
            </div>

            <div class="table-responsive">
                <table class="table dashboard-v2-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@I18n["Aluno", "Student"]</th>
                            <th>@I18n["Turma", "Group"]</th>
                            <th>@I18n["Vencimento", "Due date"]</th>
                            <th class="text-end">@I18n["Valor", "Amount"]</th>
                            <th>Status</th>
                            <th class="text-end">@I18n["Ações", "Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ProximosVencimentos.Count == 0)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="dashboard-v2-empty-state">
                                        <strong>@I18n["Nenhuma cobrança em aberto.", "No open charges."]</strong>
                                        <span>@I18n["Os filtros atuais não retornaram mensalidades pendentes ou atrasadas.", "The current filters did not return pending or overdue monthly fees."]</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.ProximosVencimentos)
                            {
                                var vencimentoClasse = VencimentoClasse(item.DiasParaVencimento, item.Status);

                                <tr>
                                    <td>
                                        <div class="dashboard-v2-student-cell">
                                            <span>@InicialAluno(item.Aluno)</span>
                                            <div>
                                                <a asp-controller="Alunos" asp-action="Details" asp-route-id="@item.AlunoId">@item.Aluno</a>
                                                <small>@I18n["Mensalidade", "Monthly fee"] #@item.MensalidadeId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@(item.Turma ?? I18n["Sem turma", "No group"])</td>
                                    <td>
                                        <div class="dashboard-v2-date-cell">
                                            <strong>@item.Vencimento.ToString("dd/MM/yyyy")</strong>
                                            <small>@item.Vencimento.ToString("dddd", culturaAtual)</small>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold">@item.Valor.ToString("C")</td>
                                    <td>
                                        <span class="dashboard-v2-due-pill @vencimentoClasse">
                                            @VencimentoTexto(item.DiasParaVencimento, item.Status)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="dashboard-v2-row-actions">
                                            <a asp-controller="Alunos"
                                               asp-action="Details"
                                               asp-route-id="@item.AlunoId"
                                               class="btn dashboard-v2-btn-table">
                                                @I18n["Aluno", "Student"]
                                            </a>
                                            <a asp-controller="Financeiro"
                                               asp-action="RegistrarPagamento"
                                               asp-route-mensalidadeId="@item.MensalidadeId"
                                               asp-route-returnUrl="@returnUrl"
                                               class="btn dashboard-v2-btn-table dashboard-v2-btn-table-primary">
                                                @I18n["Registrar", "Register"]
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <aside class="dashboard-v2-panel">
            <div class="dashboard-v2-panel-heading">
                <div>
                    <span class="dashboard-v2-eyebrow">@I18n["Atenção", "Attention"]</span>
                    <h2>@I18n["Inadimplência", "Overdue payments"]</h2>
                    <p>@I18n["Priorize alunos com maior atraso e valor em aberto.", "Prioritize students with the longest overdue time and highest open balance."]</p>
                </div>
            </div>

            @if (Model.Inadimplentes.Count == 0)
            {
                <div class="dashboard-v2-empty-state dashboard-v2-empty-compact">
                    <strong>@I18n["Sem inadimplentes no filtro.", "No overdue students in this filter."]</strong>
                    <span>@I18n["A operação financeira está limpa para a seleção atual.", "The financial operation is clear for the current selection."]</span>
                </div>
            }
            else
            {
                <div class="dashboard-v2-risk-list">
                    @foreach (var item in Model.Inadimplentes)
                    {
                        var riscoClasse = RiscoClasse(item.MaiorDiasAtraso);

                        <article class="dashboard-v2-risk-card @riscoClasse">
                            <div class="dashboard-v2-risk-header">
                                <div>
                                    <a asp-controller="Alunos" asp-action="Details" asp-route-id="@item.AlunoId">@item.Aluno</a>
                                    <small>@(item.Turma ?? I18n["Sem turma", "No group"]) · @item.QuantidadeMensalidades @I18n["mensalidade(s)", "monthly fee(s)"]</small>
                                </div>
                                <span>@item.MaiorDiasAtraso d</span>
                            </div>
                            <div class="dashboard-v2-risk-footer">
                                <strong>@item.TotalEmAberto.ToString("C")</strong>
                                <div class="dashboard-v2-row-actions">
                                    <a asp-controller="Financeiro"
                                       asp-action="HistoricoAluno"
                                       asp-route-alunoId="@item.AlunoId"
                                       class="btn dashboard-v2-btn-table">
                                        @I18n["Histórico", "History"]
                                    </a>
                                    <a asp-controller="Financeiro"
                                       asp-action="RegistrarPagamento"
                                       asp-route-returnUrl="@returnUrl"
                                       class="btn dashboard-v2-btn-table dashboard-v2-btn-table-primary">
                                        @I18n["Cobrar", "Charge"]
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </aside>
    </section>

    <section class="dashboard-v2-bottom-grid">
        <div class="dashboard-v2-panel">
            <div class="dashboard-v2-panel-heading">
                <div>
                    <span class="dashboard-v2-eyebrow">@I18n["Histórico", "History"]</span>
                    <h2>@I18n["Atividades recentes", "Recent activity"]</h2>
                    <p>@I18n["Últimos movimentos registrados na base de alunos.", "Latest movements registered in the student database."]</p>
                </div>
            </div>

            @if (Model.AtividadesRecentes.Count == 0)
            {
                <div class="dashboard-v2-empty-state dashboard-v2-empty-compact">
                    <strong>@I18n["Sem atividades recentes.", "No recent activity."]</strong>
                    <span>@I18n["Nenhum evento foi registrado para os filtros aplicados.", "No event was registered for the applied filters."]</span>
                </div>
            }
            else
            {
                <div class="dashboard-v2-timeline">
                    @foreach (var item in Model.AtividadesRecentes)
                    {
                        <article class="dashboard-v2-timeline-item">
                            <span class="dashboard-v2-timeline-dot"></span>
                            <div>
                                <div class="dashboard-v2-timeline-meta">
                                    <strong>@item.TipoEvento</strong>
                                    <time>@item.Data.ToString("dd/MM/yyyy HH:mm")</time>
                                </div>
                                <p>@item.Descricao</p>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="dashboard-v2-priority-card">
            <span class="dashboard-v2-eyebrow">@I18n["Plano rápido", "Quick plan"]</span>
            <h2>@I18n["Prioridades do turno", "Shift priorities"]</h2>
            <p>@I18n["Use este bloco para decidir o que tratar primeiro na operação diária.", "Use this block to decide what to handle first in the daily operation."]</p>

            <ul>
                <li>
                    <span class="is-danger"></span>
                    <strong>@Model.MensalidadesAtrasadas @I18n["mensalidade(s) atrasada(s)", "overdue monthly fee(s)"]</strong>
                    <small>@I18n["Tratar cobranças vencidas antes de novas rotinas administrativas.", "Handle overdue charges before new administrative routines."]</small>
                </li>
                <li>
                    <span class="is-warning"></span>
                    <strong>@Model.MensalidadesPendentes @I18n["pendente(s) na competência", "pending in the period"]</strong>
                    <small>@I18n["Validar pagamentos recebidos e comprovantes enviados.", "Validate received payments and submitted receipts."]</small>
                </li>
                <li>
                    <span class="is-info"></span>
                    <strong>@Model.TotalEmAtraso.ToString("C") @I18n["em aberto", "open"]</strong>
                    <small>@I18n["Acompanhar acordos, descontos e casos recorrentes.", "Follow agreements, discounts, and recurring cases."]</small>
                </li>
                <li>
                    <span class="is-success"></span>
                    <strong>@Model.QuantidadeAlunosAtivos @I18n["aluno(s) ativo(s)", "active student(s)"]</strong>
                    <small>@I18n["Base atual para mensalidades e planejamento de turmas.", "Current base for monthly fees and group planning."]</small>
                </li>
            </ul>

            <div class="dashboard-v2-priority-actions">
                <a asp-controller="Financeiro" asp-action="Atrasados" class="btn dashboard-v2-btn dashboard-v2-btn-danger">@I18n["Ver atrasados", "View overdue"]</a>
                <a asp-controller="Admissoes" asp-action="Index" class="btn dashboard-v2-btn dashboard-v2-btn-ghost">@I18n["Admissões", "Admissions"]</a>
                <a asp-controller="Desligamentos" asp-action="Index" class="btn dashboard-v2-btn dashboard-v2-btn-ghost">@I18n["Desligamentos", "Deactivations"]</a>
            </div>
        </div>
    </section>
</div>
