@model AlunoFormViewModel
@{
    ViewData["Title"] = "Editar Aluno";
}

@functions {
    private static string StatusTexto(StatusAlunoEnum status)
    {
        return status switch
        {
            StatusAlunoEnum.EmAdmissao => "Em admissão",
            StatusAlunoEnum.Ativo => "Ativo",
            StatusAlunoEnum.Inativo => "Inativo",
            StatusAlunoEnum.Desligado => "Desligado",
            _ => status.ToString()
        };
    }
}

<div class="alunos-v2-page">
    <section class="alunos-v2-form-hero mb-4">
        <div>
            <span class="alunos-v2-eyebrow">Edição de cadastro</span>
            <h1>Editar aluno</h1>
            <p>
                Atualize dados cadastrais, contato, status e vínculo principal do aluno mantendo o histórico administrativo consistente.
            </p>
            <div class="alunos-v2-meta">
                <span>Aluno <strong>#@Model.Id</strong></span>
                <span>Status atual <strong>@StatusTexto(Model.Status)</strong></span>
            </div>
        </div>
        <div class="alunos-v2-hero-actions">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn alunos-v2-btn alunos-v2-btn-ghost">Ver detalhes</a>
            <a asp-action="Index" class="btn alunos-v2-btn alunos-v2-btn-ghost">Voltar para lista</a>
        </div>
    </section>

    <div class="alunos-v2-form-layout">
        <section class="alunos-v2-form-panel">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="alunos-v2-form">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alunos-v2-validation-summary"></div>

                <section class="alunos-v2-form-section">
                    <div class="alunos-v2-section-title">
                        <span>01</span>
                        <div>
                            <h2>Dados principais</h2>
                            <p>Identificação civil usada no cadastro administrativo.</p>
                        </div>
                    </div>

                    <div class="alunos-v2-form-grid">
                        <div class="alunos-v2-field alunos-v2-field-span-2">
                            <label asp-for="NomeCompleto">Nome completo</label>
                            <input asp-for="NomeCompleto"
                                   type="text"
                                   class="form-control alunos-v2-control"
                                   placeholder="Ex.: Kenji Tanaka"
                                   autocomplete="name"
                                   maxlength="150" />
                            <span asp-validation-for="NomeCompleto" class="text-danger"></span>
                        </div>

                        <div class="alunos-v2-field">
                            <label asp-for="CPF">CPF</label>
                            <input asp-for="CPF"
                                   type="text"
                                   class="form-control alunos-v2-control"
                                   placeholder="000.000.000-00"
                                   inputmode="numeric"
                                   autocomplete="off"
                                   maxlength="14" />
                            <span asp-validation-for="CPF" class="text-danger"></span>
                        </div>

                        <div class="alunos-v2-field">
                            <label asp-for="RG">RG</label>
                            <input asp-for="RG"
                                   type="text"
                                   class="form-control alunos-v2-control"
                                   placeholder="Ex.: 12.345.678-9"
                                   autocomplete="off"
                                   maxlength="20" />
                            <span asp-validation-for="RG" class="text-danger"></span>
                        </div>

                        <div class="alunos-v2-field">
                            <label asp-for="DataNascimento">Data de nascimento</label>
                            <input asp-for="DataNascimento"
                                   type="date"
                                   class="form-control alunos-v2-control"
                                   autocomplete="bday" />
                            <span asp-validation-for="DataNascimento" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="alunos-v2-form-section">
                    <div class="alunos-v2-section-title">
                        <span>02</span>
                        <div>
                            <h2>Contato</h2>
                            <p>Informações para comunicação com aluno e responsável de emergência.</p>
                        </div>
                    </div>

                    <div class="alunos-v2-form-grid">
                        <div class="alunos-v2-field">
                            <label asp-for="Celular">Celular</label>
                            <input asp-for="Celular"
                                   type="tel"
                                   class="form-control alunos-v2-control"
                                   placeholder="(11) 99999-9999"
                                   inputmode="tel"
                                   autocomplete="tel-national"
                                   maxlength="20" />
                            <span asp-validation-for="Celular" class="text-danger"></span>
                        </div>

                        <div class="alunos-v2-field alunos-v2-field-span-2">
                            <label asp-for="Email">E-mail</label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control alunos-v2-control"
                                   placeholder="aluno@exemplo.com"
                                   autocomplete="email"
                                   maxlength="150" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="alunos-v2-field alunos-v2-field-span-3">
                            <label asp-for="Endereco">Endereço</label>
                            <input asp-for="Endereco"
                                   type="text"
                                   class="form-control alunos-v2-control"
                                   placeholder="Rua, número, bairro, cidade"
                                   autocomplete="street-address"
                                   maxlength="200" />
                            <span asp-validation-for="Endereco" class="text-danger"></span>
                        </div>

                        <div class="alunos-v2-field alunos-v2-field-span-3">
                            <label asp-for="ContatoEmergencia">Contato de emergência</label>
                            <input asp-for="ContatoEmergencia"
                                   type="text"
                                   class="form-control alunos-v2-control"
                                   placeholder="Nome, parentesco e telefone"
                                   autocomplete="off"
                                   maxlength="150" />
                            <span asp-validation-for="ContatoEmergencia" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="alunos-v2-form-section">
                    <div class="alunos-v2-section-title">
                        <span>03</span>
                        <div>
                            <h2>Vínculo interno</h2>
                            <p>Status e turma principal usados pela equipe administrativa.</p>
                        </div>
                    </div>

                    <div class="alunos-v2-form-grid">
                        <div class="alunos-v2-field">
                            <label asp-for="DataEntrada">Data de entrada</label>
                            <input asp-for="DataEntrada"
                                   type="date"
                                   class="form-control alunos-v2-control"
                                   autocomplete="off" />
                            <span asp-validation-for="DataEntrada" class="text-danger"></span>
                        </div>

                        <div class="alunos-v2-field">
                            <label asp-for="Status">Status</label>
                            <select asp-for="Status" class="form-select alunos-v2-control">
                                @foreach (var status in Enum.GetValues<StatusAlunoEnum>())
                                {
                                    if (Model.Status == status)
                                    {
                                        <option value="@status" selected>@StatusTexto(status)</option>
                                    }
                                    else
                                    {
                                        <option value="@status">@StatusTexto(status)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="alunos-v2-field">
                            <label asp-for="TurmaId">Turma principal</label>
                            <select asp-for="TurmaId" asp-items="ViewBag.Turmas" class="form-select alunos-v2-control">
                                <option value="">Sem turma definida</option>
                            </select>
                            <span asp-validation-for="TurmaId" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="alunos-v2-form-section">
                    <div class="alunos-v2-section-title">
                        <span>04</span>
                        <div>
                            <h2>Observações internas</h2>
                            <p>Atualize informações úteis para acompanhamento administrativo.</p>
                        </div>
                    </div>

                    <div class="alunos-v2-field">
                        <label asp-for="Observacoes">Anotações</label>
                        <textarea asp-for="Observacoes"
                                  class="form-control alunos-v2-control"
                                  rows="4"
                                  placeholder="Ex.: observações de turma, integração, comunicação ou atendimento."></textarea>
                        <span asp-validation-for="Observacoes" class="text-danger"></span>
                    </div>
                </section>

                <div class="alunos-v2-form-actions">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn alunos-v2-btn alunos-v2-btn-ghost">Cancelar</a>
                    <button type="submit" class="btn alunos-v2-btn alunos-v2-btn-primary">Salvar alterações</button>
                </div>
            </form>
        </section>

        <aside class="alunos-v2-assist-card">
            <span class="alunos-v2-eyebrow">Revisão recomendada</span>
            <h2>Antes de atualizar</h2>
            <ul>
                <li>Confirme mudanças de status para não gerar divergência com o financeiro.</li>
                <li>Atualize a turma principal quando houver remanejamento confirmado.</li>
                <li>Mantenha observações curtas, objetivas e úteis para atendimento interno.</li>
                <li>Se o aluno participa de mais de uma turma, ajuste os vínculos no módulo de Turmas.</li>
            </ul>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
