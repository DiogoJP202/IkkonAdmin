@using IkkonAdmin.Web.Security
@model AlunoIndexViewModel
@{
    ViewData["Title"] = "Alunos";

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var canCreateAluno = User.HasPermission(AppPermissions.AlunosCreate);
    var canEditAluno = User.HasPermission(AppPermissions.AlunosEdit);
    var canFinanceiroView = User.HasPermission(AppPermissions.FinanceiroView);
    var canAdmissoesView = User.HasPermission(AppPermissions.AdmissoesView);

    var alunosAtivos = Model.Alunos.Count(x => x.Status == StatusAlunoEnum.Ativo);
    var alunosEmAdmissao = Model.Alunos.Count(x => x.Status == StatusAlunoEnum.EmAdmissao);
    var alunosSemTurma = Model.Alunos.Count(x => string.IsNullOrWhiteSpace(x.Turma));
    var alunosEmAtencao = Model.Alunos.Count(x => x.Status is StatusAlunoEnum.Inativo or StatusAlunoEnum.Desligado);

    var filtrosAplicados =
        !string.IsNullOrWhiteSpace(Model.Busca) ||
        Model.Status.HasValue ||
        Model.TurmaId.HasValue;

    var totalPaginas = Math.Max(1, Model.TotalPaginas);
    var paginaAtual = Math.Clamp(Model.PaginaAtual, 1, totalPaginas);
    var paginaInicial = Math.Max(1, paginaAtual - 2);
    var paginaFinal = Math.Min(totalPaginas, paginaAtual + 2);
    var primeiroRegistro = Model.TotalRegistros == 0 ? 0 : ((paginaAtual - 1) * Model.TamanhoPagina) + 1;
    var ultimoRegistro = Math.Min(Model.TotalRegistros, paginaAtual * Model.TamanhoPagina);
}

@functions {
    private static string StatusTexto(StatusAlunoEnum status)
    {
        return status switch
        {
            StatusAlunoEnum.EmAdmissao => "Em admissão",
            StatusAlunoEnum.Ativo => "Ativo",
            StatusAlunoEnum.Inativo => "Inativo",
            StatusAlunoEnum.Desligado => "Desligado",
            _ => status.ToString()
        };
    }

    private static string StatusBadgeClass(StatusAlunoEnum status)
    {
        return status switch
        {
            StatusAlunoEnum.Ativo => "is-success",
            StatusAlunoEnum.Inativo => "is-muted",
            StatusAlunoEnum.Desligado => "is-danger",
            _ => "is-warning"
        };
    }

    private static string InicialAluno(string nome)
    {
        return string.IsNullOrWhiteSpace(nome)
            ? "A"
            : nome.Trim()[0].ToString().ToUpperInvariant();
    }
}

<div class="alunos-v2-page">
    <section class="alunos-v2-hero mb-4">
        <div class="alunos-v2-hero-copy">
            <span class="alunos-v2-eyebrow">Gestão de alunos</span>
            <h1>Cadastro operacional da escola</h1>
            <p>
                Consulte status, turma, contato e histórico de alunos com uma navegação rápida para atendimento, financeiro e acompanhamento interno.
            </p>

            <div class="alunos-v2-meta">
                <span>Total filtrado <strong>@Model.TotalRegistros</strong></span>
                <span>Nesta página <strong>@Model.Alunos.Count</strong></span>
                <span>Sem turma <strong>@alunosSemTurma</strong></span>
            </div>
        </div>

        <div class="alunos-v2-hero-actions">
            @if (canCreateAluno)
            {
                <a asp-action="Create" class="btn alunos-v2-btn alunos-v2-btn-primary">Novo aluno</a>
            }
            @if (canFinanceiroView)
            {
                <a asp-controller="Financeiro" asp-action="Index" class="btn alunos-v2-btn alunos-v2-btn-ghost">Ver financeiro</a>
            }
            @if (canAdmissoesView)
            {
                <a asp-controller="Admissoes" asp-action="Index" class="btn alunos-v2-btn alunos-v2-btn-ghost">Admissões</a>
            }
        </div>
    </section>

    <section class="alunos-v2-kpi-grid mb-4" aria-label="Indicadores de alunos">
        <article class="alunos-v2-kpi-card">
            <div class="alunos-v2-kpi-top">
                <span>Total</span>
                <b>Filtro</b>
            </div>
            <strong>@Model.TotalRegistros</strong>
            <small>Registros encontrados na busca atual.</small>
        </article>

        <article class="alunos-v2-kpi-card is-success">
            <div class="alunos-v2-kpi-top">
                <span>Ativos</span>
                <b>Página</b>
            </div>
            <strong>@alunosAtivos</strong>
            <small>Alunos ativos nesta página da listagem.</small>
        </article>

        <article class="alunos-v2-kpi-card is-warning">
            <div class="alunos-v2-kpi-top">
                <span>Admissão</span>
                <b>Onboarding</b>
            </div>
            <strong>@alunosEmAdmissao</strong>
            <small>Requerem contrato, integração ou turma.</small>
        </article>

        <article class="alunos-v2-kpi-card is-danger">
            <div class="alunos-v2-kpi-top">
                <span>Atenção</span>
                <b>Status</b>
            </div>
            <strong>@alunosEmAtencao</strong>
            <small>Inativos ou desligados nesta página.</small>
        </article>
    </section>

    <section class="alunos-v2-filter-card mb-4">
        <div class="alunos-v2-card-heading">
            <div>
                <span class="alunos-v2-eyebrow">Filtros</span>
                <h2>Encontrar aluno</h2>
                <p>Busque por nome, CPF ou telefone e refine por turma ou status.</p>
            </div>
        </div>

        <form asp-action="Index" method="get" class="alunos-v2-filter-grid">
            <div class="alunos-v2-field alunos-v2-field-search">
                <label asp-for="Busca">Busca</label>
                <input asp-for="Busca"
                       type="search"
                       class="form-control alunos-v2-control"
                       placeholder="Digite nome, CPF ou celular"
                       autocomplete="off"
                       inputmode="search" />
            </div>

            <div class="alunos-v2-field">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" class="form-select alunos-v2-control">
                    <option value="">Todos os status</option>
                    @foreach (var status in Enum.GetValues<StatusAlunoEnum>())
                    {
                        if (Model.Status == status)
                        {
                            <option value="@status" selected>@StatusTexto(status)</option>
                        }
                        else
                        {
                            <option value="@status">@StatusTexto(status)</option>
                        }
                    }
                </select>
            </div>

            <div class="alunos-v2-field">
                <label asp-for="TurmaId">Turma</label>
                <select asp-for="TurmaId" class="form-select alunos-v2-control">
                    <option value="">Todas as turmas</option>
                    @foreach (var turma in Model.Turmas)
                    {
                        if (Model.TurmaId == turma.Id)
                        {
                            <option value="@turma.Id" selected>@turma.Nome</option>
                        }
                        else
                        {
                            <option value="@turma.Id">@turma.Nome</option>
                        }
                    }
                </select>
            </div>

            <div class="alunos-v2-field">
                <label asp-for="TamanhoPagina">Registros</label>
                <select asp-for="TamanhoPagina" name="tamanhoPagina" class="form-select alunos-v2-control">
                    @if (Model.TamanhoPagina == 10)
                    {
                        <option value="10" selected>10 por página</option>
                    }
                    else
                    {
                        <option value="10">10 por página</option>
                    }

                    @if (Model.TamanhoPagina == 20)
                    {
                        <option value="20" selected>20 por página</option>
                    }
                    else
                    {
                        <option value="20">20 por página</option>
                    }

                    @if (Model.TamanhoPagina == 30)
                    {
                        <option value="30" selected>30 por página</option>
                    }
                    else
                    {
                        <option value="30">30 por página</option>
                    }
                </select>
            </div>

            <div class="alunos-v2-filter-actions">
                <button type="submit" class="btn alunos-v2-btn alunos-v2-btn-primary">Aplicar filtros</button>
                <a asp-action="Index" class="btn alunos-v2-btn alunos-v2-btn-ghost">Limpar</a>
            </div>
        </form>

        @if (filtrosAplicados)
        {
            <div class="alunos-v2-active-filters">
                @if (!string.IsNullOrWhiteSpace(Model.Busca))
                {
                    <span>Busca: <strong>@Model.Busca</strong></span>
                }
                @if (Model.Status.HasValue)
                {
                    <span>Status: <strong>@StatusTexto(Model.Status.Value)</strong></span>
                }
                @if (Model.TurmaId.HasValue)
                {
                    var turmaSelecionada = Model.Turmas.FirstOrDefault(x => x.Id == Model.TurmaId.Value);
                    if (turmaSelecionada is not null)
                    {
                        <span>Turma: <strong>@turmaSelecionada.Nome</strong></span>
                    }
                }
            </div>
        }
    </section>

    <section class="alunos-v2-table-panel">
        <div class="alunos-v2-panel-heading">
            <div>
                <span class="alunos-v2-eyebrow">Listagem</span>
                <h2>Alunos cadastrados</h2>
                <p>Exibindo @primeiroRegistro-@ultimoRegistro de @Model.TotalRegistros registro(s).</p>
            </div>
            @if (canCreateAluno)
            {
                <a asp-action="Create" class="btn alunos-v2-btn alunos-v2-btn-primary">Novo aluno</a>
            }
        </div>

        <div class="table-responsive">
            <table class="table alunos-v2-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Contato</th>
                        <th>CPF</th>
                        <th>Turma</th>
                        <th>Status</th>
                        <th>Entrada</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Alunos.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="alunos-v2-empty-state">
                                    <strong>Nenhum aluno encontrado.</strong>
                                    <span>Revise os filtros aplicados ou cadastre um novo aluno.</span>
                                    @if (canCreateAluno)
                                    {
                                        <a asp-action="Create" class="btn alunos-v2-btn alunos-v2-btn-primary">Cadastrar aluno</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var aluno in Model.Alunos)
                        {
                            <tr>
                                <td>
                                    <div class="alunos-v2-student-cell">
                                        <span>@InicialAluno(aluno.NomeCompleto)</span>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@aluno.Id">@aluno.NomeCompleto</a>
                                            <small>ID @aluno.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="alunos-v2-contact-cell">
                                        <strong>@(string.IsNullOrWhiteSpace(aluno.Celular) ? "Sem celular" : aluno.Celular)</strong>
                                        <small>Contato principal</small>
                                    </div>
                                </td>
                                <td>@aluno.CPF</td>
                                <td>@(string.IsNullOrWhiteSpace(aluno.Turma) ? "Sem turma" : aluno.Turma)</td>
                                <td>
                                    <span class="alunos-v2-status-pill @StatusBadgeClass(aluno.Status)">
                                        @StatusTexto(aluno.Status)
                                    </span>
                                </td>
                                <td>@aluno.DataEntrada.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <div class="alunos-v2-row-actions">
                                        <a asp-action="Details"
                                           asp-route-id="@aluno.Id"
                                           class="btn alunos-v2-btn-table">
                                            Detalhes
                                        </a>
                                        @if (canEditAluno)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@aluno.Id"
                                               class="btn alunos-v2-btn-table">
                                                Editar
                                            </a>
                                        }
                                        @if (canFinanceiroView)
                                        {
                                            <a asp-controller="Financeiro"
                                               asp-action="HistoricoAluno"
                                               asp-route-alunoId="@aluno.Id"
                                               class="btn alunos-v2-btn-table">
                                                Financeiro
                                            </a>
                                        }
                                    </div>

                                    @if (canEditAluno)
                                    {
                                        <form asp-action="AlterarStatus" method="post" class="alunos-v2-status-form mt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@aluno.Id" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <select name="status" class="form-select alunos-v2-control" aria-label="Alterar status de @aluno.NomeCompleto">
                                                @foreach (var status in Enum.GetValues<StatusAlunoEnum>())
                                                {
                                                    if (status == aluno.Status)
                                                    {
                                                        <option value="@status" selected>@StatusTexto(status)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@status">@StatusTexto(status)</option>
                                                    }
                                                }
                                            </select>
                                            <button type="submit" class="btn alunos-v2-btn-table alunos-v2-btn-table-primary">
                                                Atualizar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (totalPaginas > 1)
    {
        <nav class="alunos-v2-pagination" aria-label="Paginação de alunos">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(paginaAtual <= 1 ? "disabled" : string.Empty)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-busca="@Model.Busca"
                       asp-route-status="@Model.Status"
                       asp-route-turmaId="@Model.TurmaId"
                       asp-route-tamanhoPagina="@Model.TamanhoPagina"
                       asp-route-pagina="@(paginaAtual - 1)">Anterior</a>
                </li>

                @for (var p = paginaInicial; p <= paginaFinal; p++)
                {
                    <li class="page-item @(p == paginaAtual ? "active" : string.Empty)">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-busca="@Model.Busca"
                           asp-route-status="@Model.Status"
                           asp-route-turmaId="@Model.TurmaId"
                           asp-route-tamanhoPagina="@Model.TamanhoPagina"
                           asp-route-pagina="@p">@p</a>
                    </li>
                }

                <li class="page-item @(paginaAtual >= totalPaginas ? "disabled" : string.Empty)">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-busca="@Model.Busca"
                       asp-route-status="@Model.Status"
                       asp-route-turmaId="@Model.TurmaId"
                       asp-route-tamanhoPagina="@Model.TamanhoPagina"
                       asp-route-pagina="@(paginaAtual + 1)">Próxima</a>
                </li>
            </ul>
        </nav>
    }
</div>
