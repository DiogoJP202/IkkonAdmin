@using IkkonAdmin.Web.Security
@model AlunoDetalhesViewModel
@{
    ViewData["Title"] = "Detalhes do Aluno";

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var canEditAluno = User.HasPermission(AppPermissions.AlunosEdit);
    var canFinanceiroView = User.HasPermission(AppPermissions.FinanceiroView);
    var canFinanceiroCreate = User.HasPermission(AppPermissions.FinanceiroCreate);

    var inicialNome = string.IsNullOrWhiteSpace(Model.NomeCompleto)
        ? "A"
        : Model.NomeCompleto.Trim()[0].ToString().ToUpperInvariant();

    var mensalidadesPendentes = Model.Mensalidades.Count(x => x.Status is StatusMensalidadeEnum.Pendente or StatusMensalidadeEnum.Atrasado);
    var ultimaAtividade = Model.Historico.FirstOrDefault()?.DataEvento;
}

@functions {
    private static string StatusAlunoTexto(StatusAlunoEnum status)
    {
        return status switch
        {
            StatusAlunoEnum.EmAdmissao => "Em admissão",
            StatusAlunoEnum.Ativo => "Ativo",
            StatusAlunoEnum.Inativo => "Inativo",
            StatusAlunoEnum.Desligado => "Desligado",
            _ => status.ToString()
        };
    }

    private static string StatusMensalidadeTexto(StatusMensalidadeEnum status)
    {
        return status switch
        {
            StatusMensalidadeEnum.Pendente => "Pendente",
            StatusMensalidadeEnum.Pago => "Pago",
            StatusMensalidadeEnum.Atrasado => "Atrasado",
            StatusMensalidadeEnum.Cancelado => "Cancelado",
            _ => status.ToString()
        };
    }

    private static string AlunoStatusClass(StatusAlunoEnum status)
    {
        return status switch
        {
            StatusAlunoEnum.Ativo => "is-success",
            StatusAlunoEnum.Inativo => "is-muted",
            StatusAlunoEnum.Desligado => "is-danger",
            _ => "is-warning"
        };
    }

    private static string MensalidadeStatusClass(StatusMensalidadeEnum status)
    {
        return status switch
        {
            StatusMensalidadeEnum.Pago => "is-success",
            StatusMensalidadeEnum.Pendente => "is-warning",
            StatusMensalidadeEnum.Atrasado => "is-danger",
            _ => "is-muted"
        };
    }
}

<div class="alunos-v2-page">
    <section class="alunos-v2-profile-hero mb-4">
        <div class="alunos-v2-profile-main">
            <div class="alunos-v2-avatar">@inicialNome</div>
            <div>
                <span class="alunos-v2-eyebrow">Perfil administrativo</span>
                <h1>@Model.NomeCompleto</h1>
                <div class="alunos-v2-profile-meta">
                    <span>CPF @Model.CPF</span>
                    <span>Turma @(string.IsNullOrWhiteSpace(Model.Turma) ? "Sem turma" : Model.Turma)</span>
                    <span>Entrada @Model.DataEntrada.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>

        <div class="alunos-v2-profile-actions">
            <span class="alunos-v2-status-pill @AlunoStatusClass(Model.Status)">
                @StatusAlunoTexto(Model.Status)
            </span>
            @if (canEditAluno)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn alunos-v2-btn alunos-v2-btn-primary">Editar cadastro</a>
            }
            <a asp-action="Index" class="btn alunos-v2-btn alunos-v2-btn-ghost">Voltar para lista</a>
        </div>
    </section>

    @if (canEditAluno)
    {
        <section class="alunos-v2-status-panel mb-4">
            <div>
                <strong>Alterar status do aluno</strong>
                <span>Use com cuidado, pois o status impacta operação, financeiro e histórico.</span>
            </div>
            <div class="alunos-v2-status-actions">
                @foreach (var status in Enum.GetValues<StatusAlunoEnum>())
                {
                    <form asp-action="AlterarStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@status" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        @if (Model.Status == status)
                        {
                            <button type="submit" class="btn alunos-v2-btn alunos-v2-btn-primary" disabled>
                                @StatusAlunoTexto(status)
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn alunos-v2-btn alunos-v2-btn-ghost">
                                @StatusAlunoTexto(status)
                            </button>
                        }
                    </form>
                }
            </div>
        </section>
    }

    <section class="alunos-v2-kpi-grid mb-4" aria-label="Resumo do aluno">
        <article class="alunos-v2-kpi-card is-success">
            <div class="alunos-v2-kpi-top">
                <span>Total pago</span>
                <b>Financeiro</b>
            </div>
            <strong>@Model.TotalPago.ToString("C")</strong>
            <small>Pagamentos registrados no histórico.</small>
        </article>

        <article class="alunos-v2-kpi-card is-warning">
            <div class="alunos-v2-kpi-top">
                <span>Em aberto</span>
                <b>Pendências</b>
            </div>
            <strong>@Model.TotalEmAberto.ToString("C")</strong>
            <small>@mensalidadesPendentes mensalidade(s) pendente(s).</small>
        </article>

        <article class="alunos-v2-kpi-card is-danger">
            <div class="alunos-v2-kpi-top">
                <span>Atrasadas</span>
                <b>Risco</b>
            </div>
            <strong>@Model.MensalidadesAtrasadas</strong>
            <small>Mensalidades com atraso ativo.</small>
        </article>

        <article class="alunos-v2-kpi-card">
            <div class="alunos-v2-kpi-top">
                <span>Última atividade</span>
                <b>Histórico</b>
            </div>
            <strong>@(ultimaAtividade.HasValue ? ultimaAtividade.Value.ToString("dd/MM") : "-")</strong>
            <small>@(ultimaAtividade.HasValue ? ultimaAtividade.Value.ToString("dd/MM/yyyy HH:mm") : "Sem histórico recente.")</small>
        </article>
    </section>

    <div class="alunos-v2-details-grid">
        <section class="alunos-v2-detail-panel">
            <div class="alunos-v2-panel-heading">
                <div>
                    <span class="alunos-v2-eyebrow">Cadastro</span>
                    <h2>Informações do aluno</h2>
                    <p>Dados visíveis para a equipe administrativa.</p>
                </div>
            </div>

            <ul class="nav nav-pills alunos-v2-tabs" id="alunoDetailsTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="geral-tab" data-bs-toggle="tab" data-bs-target="#geral" type="button" role="tab" aria-controls="geral" aria-selected="true">
                        Dados cadastrais
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="financeiro-tab" data-bs-toggle="tab" data-bs-target="#financeiro" type="button" role="tab" aria-controls="financeiro" aria-selected="false">
                        Financeiro
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="historico-tab" data-bs-toggle="tab" data-bs-target="#historico" type="button" role="tab" aria-controls="historico" aria-selected="false">
                        Histórico
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="geral" role="tabpanel" aria-labelledby="geral-tab">
                    <div class="alunos-v2-data-grid">
                        <article class="alunos-v2-data-card">
                            <span>RG</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.RG) ? "-" : Model.RG)</strong>
                        </article>
                        <article class="alunos-v2-data-card">
                            <span>Data de nascimento</span>
                            <strong>@(Model.DataNascimento.HasValue ? Model.DataNascimento.Value.ToString("dd/MM/yyyy") : "-")</strong>
                        </article>
                        <article class="alunos-v2-data-card">
                            <span>Celular</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Celular) ? "-" : Model.Celular)</strong>
                        </article>
                        <article class="alunos-v2-data-card">
                            <span>E-mail</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</strong>
                        </article>
                        <article class="alunos-v2-data-card alunos-v2-data-card-wide">
                            <span>Contato de emergência</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.ContatoEmergencia) ? "-" : Model.ContatoEmergencia)</strong>
                        </article>
                        <article class="alunos-v2-data-card alunos-v2-data-card-wide">
                            <span>Endereço</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Endereco) ? "-" : Model.Endereco)</strong>
                        </article>
                        <article class="alunos-v2-data-card alunos-v2-data-card-wide">
                            <span>Observações internas</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Observacoes) ? "-" : Model.Observacoes)</strong>
                        </article>
                    </div>
                </div>

                <div class="tab-pane fade" id="financeiro" role="tabpanel" aria-labelledby="financeiro-tab">
                    <div class="table-responsive">
                        <table class="table alunos-v2-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Competência</th>
                                    <th>Vencimento</th>
                                    <th>Status</th>
                                    <th class="text-end">Valor</th>
                                    <th>Pagamento</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Mensalidades.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5">
                                            <div class="alunos-v2-empty-state">
                                                <strong>Nenhuma mensalidade registrada.</strong>
                                                <span>O histórico financeiro do aluno aparecerá aqui.</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model.Mensalidades)
                                    {
                                        <tr>
                                            <td>@item.Competencia.ToString("MM/yyyy")</td>
                                            <td>@item.DataVencimento.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <span class="alunos-v2-status-pill @MensalidadeStatusClass(item.Status)">
                                                    @StatusMensalidadeTexto(item.Status)
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold">@item.ValorFinal.ToString("C")</td>
                                            <td>@(item.DataPagamento.HasValue ? item.DataPagamento.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="historico" role="tabpanel" aria-labelledby="historico-tab">
                    @if (Model.Historico.Count == 0)
                    {
                        <div class="alunos-v2-empty-state">
                            <strong>Nenhuma atividade registrada.</strong>
                            <span>As movimentações do aluno aparecerão aqui.</span>
                        </div>
                    }
                    else
                    {
                        <div class="alunos-v2-timeline">
                            @foreach (var item in Model.Historico)
                            {
                                <article class="alunos-v2-timeline-item">
                                    <span class="alunos-v2-timeline-dot"></span>
                                    <div>
                                        <div class="alunos-v2-timeline-meta">
                                            <strong>@item.TipoEvento</strong>
                                            <time>@item.DataEvento.ToString("dd/MM/yyyy HH:mm")</time>
                                        </div>
                                        <p>@item.Descricao</p>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>

        <aside class="alunos-v2-side-stack">
            <section class="alunos-v2-side-card">
                <span class="alunos-v2-eyebrow">Resumo rápido</span>
                <h2>Operação</h2>
                <dl class="alunos-v2-summary-list">
                    <div>
                        <dt>Turma</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Turma) ? "Sem turma" : Model.Turma)</dd>
                    </div>
                    <div>
                        <dt>Pendências financeiras</dt>
                        <dd>@mensalidadesPendentes mensalidade(s)</dd>
                    </div>
                    <div>
                        <dt>Última atividade</dt>
                        <dd>@(ultimaAtividade.HasValue ? ultimaAtividade.Value.ToString("dd/MM/yyyy HH:mm") : "Sem histórico")</dd>
                    </div>
                    <div>
                        <dt>Contato</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Celular) ? "-" : Model.Celular)</dd>
                    </div>
                </dl>
            </section>

            <section class="alunos-v2-assist-card alunos-v2-assist-card-compact">
                <span class="alunos-v2-eyebrow">Ações rápidas</span>
                <h2>Próximos passos</h2>
                <div class="alunos-v2-side-actions">
                    @if (canEditAluno)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn alunos-v2-btn alunos-v2-btn-primary">Editar cadastro</a>
                    }
                    @if (canFinanceiroView)
                    {
                        <a asp-controller="Financeiro" asp-action="HistoricoAluno" asp-route-alunoId="@Model.Id" class="btn alunos-v2-btn alunos-v2-btn-dark-ghost">Histórico financeiro</a>
                    }
                    @if (canFinanceiroCreate)
                    {
                        <a asp-controller="Financeiro"
                           asp-action="RegistrarPagamento"
                           asp-route-returnUrl="@returnUrl"
                           class="btn alunos-v2-btn alunos-v2-btn-dark-ghost">
                            Registrar pagamento
                        </a>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>
