@model BlogPublicDetailsViewModel
@using System.Globalization

@{
    Layout = "_PublicLayout";
    ViewData["PublicSection"] = "blog";
    ViewData["ContactMode"] = "geral";
    ViewData["JapanesePublicEnabled"] = true;

    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString() ?? $"/blog/{Model.Slug}";
    var encodedShareUrl = Uri.EscapeDataString(canonicalUrl);
    var encodedShareText = Uri.EscapeDataString($"{Model.Title} - {canonicalUrl}");
}

@functions {
    private static string FormatDate(DateTime utcDate)
    {
        try
        {
            var timeZone = GetSaoPauloTimeZone();
            var localDate = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utcDate, DateTimeKind.Utc), timeZone);
            return localDate.ToString("dd MMM yyyy", CultureInfo.CurrentUICulture);
        }
        catch
        {
            return utcDate.ToString("dd MMM yyyy", CultureInfo.CurrentUICulture);
        }
    }

    private static TimeZoneInfo GetSaoPauloTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("E. South America Standard Time");
        }
    }

    private static string BuildBlogUrl(string slug) => $"/blog/{slug}";
}

<div class="institucional-page public-blog-page public-blog-detail-page">
    <partial name="_PublicHeader" />

    <article class="public-blog-detail">
        <header class="public-blog-detail-hero">
            <div class="container-xxl px-3 px-lg-4">
                <a class="public-blog-back-link" href="/blog">Blog</a>

                <div class="public-blog-detail-heading">
                    <div class="public-blog-detail-meta">
                        <span>@FormatDate(Model.PublishedAtUtc)</span>
                        @if (!string.IsNullOrWhiteSpace(Model.AuthorName))
                        {
                            <span>@Model.AuthorName</span>
                        }
                        <span>@Math.Max(1, Model.ReadingTimeMinutes) @I18n["min de leitura", "min read", "分で読めます"]</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                    {
                        <a class="public-blog-detail-category" href="@Url.Action("Index", "Blog", new { categoria = Model.CategorySlug })">@Model.CategoryName</a>
                    }

                    <h1>@Model.Title</h1>

                    @if (!string.IsNullOrWhiteSpace(Model.Summary))
                    {
                        <p>@Model.Summary</p>
                    }

                    @if (Model.Tags.Any())
                    {
                        <div class="public-blog-detail-tags">
                            @foreach (var tag in Model.Tags)
                            {
                                <a href="@Url.Action("Index", "Blog", new { tag = tag.Slug })">#@tag.Name</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <section class="public-blog-detail-cover-section">
                <div class="container-xxl px-3 px-lg-4">
                    <img class="public-blog-detail-cover" src="@Model.CoverImageUrl" alt="@I18n["Imagem de capa de", "Cover image for", "カバー画像:"] @Model.Title" />
                </div>
            </section>
        }

        <section class="public-blog-detail-body">
            <div class="container-xxl px-3 px-lg-4">
                <div class="public-blog-detail-layout">
                    <aside class="public-blog-detail-aside" aria-label="@I18n["Informações do post", "Post information", "記事情報"]">
                        <div>
                            <span>@I18n["Publicado em", "Published on", "公開日"]</span>
                            <strong>@FormatDate(Model.PublishedAtUtc)</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                        {
                            <div>
                                <span>@I18n["Categoria", "Category", "カテゴリ"]</span>
                                <a href="@Url.Action("Index", "Blog", new { categoria = Model.CategorySlug })">@Model.CategoryName</a>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.AuthorName))
                        {
                            <div>
                                <span>@I18n["Autor", "Author", "著者"]</span>
                                <strong>@Model.AuthorName</strong>
                            </div>
                        }
                        <div>
                            <span>@I18n["Compartilhar", "Share", "共有"]</span>
                            <div class="public-blog-share-links">
                                <a href="https://wa.me/?text=@encodedShareText" target="_blank" rel="noopener noreferrer">WhatsApp</a>
                                <a href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedShareUrl" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                            </div>
                        </div>
                    </aside>

                    <div class="public-blog-detail-content">
                        @Html.Raw(Model.ContentHtml)
                    </div>
                </div>
            </div>
        </section>
    </article>

    @if (Model.RelatedPosts.Any())
    {
        <section class="institucional-section public-blog-related">
            <div class="container-xxl px-3 px-lg-4">
                <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
                    <div>
                        <p class="institucional-kicker mb-2">@I18n["Continuar lendo", "Keep reading", "続きを読む"]</p>
                        <h2 class="institucional-section-title">@I18n["Posts relacionados", "Related posts", "関連記事"]</h2>
                    </div>
                    <a class="public-blog-clear" href="/blog">@I18n["Ver todos os posts", "View all posts", "すべての記事を見る"]</a>
                </div>

                <div class="public-blog-grid">
                    @foreach (var post in Model.RelatedPosts)
                    {
                        <article class="public-blog-card">
                            <a class="public-blog-card-media" href="@BuildBlogUrl(post.Slug)" aria-label="@I18n["Ler", "Read", "読む"] @post.Title">
                                <img src="@(string.IsNullOrWhiteSpace(post.CoverImageUrl) ? Url.Content("~/Images/Ikkon_Icon.png") : post.CoverImageUrl)" alt="@I18n["Imagem de capa de", "Cover image for", "カバー画像:"] @post.Title" loading="lazy" />
                            </a>
                            <div class="public-blog-card-body">
                                <div class="public-blog-meta">
                                    <span>@FormatDate(post.PublishedAtUtc)</span>
                                    @if (!string.IsNullOrWhiteSpace(post.AuthorName))
                                    {
                                        <span>@post.AuthorName</span>
                                    }
                                </div>
                                <h3><a href="@BuildBlogUrl(post.Slug)">@post.Title</a></h3>
                                @if (!string.IsNullOrWhiteSpace(post.Summary))
                                {
                                    <p>@post.Summary</p>
                                }
                                <div class="public-blog-card-footer">
                                    @if (!string.IsNullOrWhiteSpace(post.CategoryName))
                                    {
                                        <a class="public-blog-taxonomy" href="@Url.Action("Index", "Blog", new { categoria = post.CategorySlug })">@post.CategoryName</a>
                                    }
                                    <span>@Math.Max(1, post.ReadingTimeMinutes) @I18n["min de leitura", "min read", "分で読めます"]</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    }

    <partial name="_PublicContactCta" />
    <partial name="_PublicFooter" />
</div>
