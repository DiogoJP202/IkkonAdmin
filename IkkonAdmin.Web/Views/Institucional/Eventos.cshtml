@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Apresentações de Taiko para Eventos | IKKON SPTD";
    ViewData["PublicSection"] = "eventos";
    ViewData["ContactMode"] = "eventos";

    var videosEventos = new List<PublicVideoCardViewModel>
    {
        new("2n3U_-pqmZY", "Apresentação de taiko", "Energia, impacto visual e presença sonora para eventos."),
        new("ts0OQIXZ5m4", "Taiko em palco", "Performance artística com tambores japoneses e movimento coletivo."),
        new("2IDfcF9q_Wc", "Evento especial", "Repertório e formato adaptados para diferentes contextos de apresentação.")
    };
}

<div class="institucional-page public-eventos-page">
    <partial name="_PublicHeader" />

    <section class="institucional-hero public-area-hero public-eventos-hero reveal">
        <div class="institucional-hero-media" aria-hidden="true"></div>
        <div class="institucional-hero-overlay"></div>
        <div class="container-xxl px-3 px-lg-4 position-relative">
            <div class="row justify-content-center justify-content-lg-start">
                <div class="col-12 col-lg-8 col-xl-7">
                    <p class="institucional-kicker mb-2">Grupo artístico e eventos</p>
                    <h1 class="institucional-hero-title">Apresentações de taiko para eventos</h1>
                    <p class="institucional-hero-subtitle">
                        Impacto visual, energia dos tambores japoneses, cultura e presença de palco para eventos culturais, corporativos e ações especiais.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a class="btn btn-danger btn-lg" href="https://wa.me/5511937799916?text=Ol%C3%A1%21%20Gostaria%20de%20solicitar%20uma%20apresenta%C3%A7%C3%A3o%20da%20Ikkon%20SPTD%20para%20evento." target="_blank" rel="noopener">Solicitar apresentação</a>
                        <a class="btn btn-outline-light btn-lg" href="#galeria">Ver galeria</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="institucional-section public-eventos-intro reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-lg-5">
                    <p class="institucional-kicker mb-2">Grupo artístico</p>
                    <h2 class="institucional-section-title">A força do taiko fora da sala de aula</h2>
                </div>
                <div class="col-12 col-lg-7">
                    <p class="institucional-copy mb-0">
                        Além da escola, o IKKON atua com apresentações culturais e artísticas. Levamos a força do taiko para eventos, shows e celebrações, com presença de palco, disciplina musical e impacto cultural.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="institucional-section public-event-types reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-section-head text-center mx-auto">
                <p class="institucional-kicker mb-2">Formatos</p>
                <h2 class="institucional-section-title">Tipos de eventos</h2>
            </div>
            <div class="public-event-type-grid mt-4">
                <article class="institucional-card"><h3>Eventos culturais</h3><p>Programações ligadas à cultura japonesa, música, comunidade e arte.</p></article>
                <article class="institucional-card"><h3>Festivais japoneses</h3><p>Apresentações com energia coletiva e repertório adequado ao público.</p></article>
                <article class="institucional-card"><h3>Eventos corporativos</h3><p>Aberturas, ativações, celebrações e momentos de impacto ao vivo.</p></article>
                <article class="institucional-card"><h3>Cerimônias e celebrações</h3><p>Presença marcante para ocasiões especiais e encontros institucionais.</p></article>
                <article class="institucional-card"><h3>Escolas e instituições</h3><p>Experiências culturais para públicos educacionais e projetos sociais.</p></article>
                <article class="institucional-card"><h3>Ações especiais</h3><p>Formatos adaptados para eventos esportivos, lançamentos e produções.</p></article>
            </div>
        </div>
    </section>

    <section id="galeria" class="institucional-section institucional-eventos reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-eventos-wrap">
                <div class="institucional-eventos-content">
                    <p class="institucional-kicker mb-2">Destaques</p>
                    <h2 class="institucional-section-title">Presença cultural em diferentes palcos</h2>
                    <p class="institucional-copy institucional-eventos-copy mb-0">
                        A apresentação é pensada para cada contexto, preservando a força dos tambores japoneses e a leitura do público presente.
                    </p>

                    <article class="institucional-mma-box mt-4">
                        <p class="institucional-mma-question mb-2">"Vocês tocam em eventos de MMA?"</p>
                        <p class="mb-0">
                            Sim. A IKKON também participa de eventos esportivos, festivais culturais, shows e apresentações especiais.
                        </p>
                    </article>

                    <div class="row g-3 mt-1">
                        <div class="col-12 col-sm-6">
                            <article class="institucional-evento-stat">
                                <strong>10+</strong>
                                <span>Anos de trajetória</span>
                            </article>
                        </div>
                        <div class="col-12 col-sm-6">
                            <article class="institucional-evento-stat">
                                <strong>100+</strong>
                                <span>Apresentações</span>
                            </article>
                        </div>
                    </div>
                </div>

                <partial name="_PublicEventosGallery" />
            </div>
        </div>
    </section>

    <section class="institucional-section public-video-section reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-section-head text-center mx-auto">
                <p class="institucional-kicker mb-2">Vídeos de eventos</p>
                <h2 class="institucional-section-title">Apresentações e shows</h2>
            </div>
            @await Html.PartialAsync("_PublicVideoGrid", videosEventos)
        </div>
    </section>

    <partial name="_PublicContactCta" />
    <partial name="_PublicFooter" />
</div>
