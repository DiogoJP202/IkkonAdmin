@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Escola de Taiko em São Paulo | IKKON SPTD";
    ViewData["PublicSection"] = "escola";
    ViewData["ContactMode"] = "escola";

    var videosAulas = new List<PublicVideoCardViewModel>
    {
        new("4iX-E6uIAXI", "Primeiros caminhos no taiko", "Prática, ritmo e presença corporal para desenvolver base com segurança."),
        new("b7DFAQNTpAg", "Treino em grupo", "A evolução acontece com escuta coletiva, disciplina e repetição orientada."),
        new("FlwgqLo6yBI", "Musicalidade e movimento", "Coordenação, intenção musical e conexão com a cultura japonesa.")
    };
}

<div class="institucional-page public-escola-page">
    <partial name="_PublicHeader" />

    <section class="institucional-hero public-area-hero public-escola-hero reveal">
        <div class="institucional-hero-media" aria-hidden="true"></div>
        <div class="institucional-hero-overlay"></div>
        <div class="container-xxl px-3 px-lg-4 position-relative">
            <div class="row justify-content-center justify-content-lg-start">
                <div class="col-12 col-lg-8 col-xl-7">
                    <p class="institucional-kicker mb-2">Escola de Taiko</p>
                    <h1 class="institucional-hero-title">Aprenda taiko em São Paulo</h1>
                    <p class="institucional-hero-subtitle">
                        Comece do zero, desenvolva ritmo, disciplina, musicalidade e presença em grupo com uma prática ligada à cultura japonesa.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a class="btn btn-danger btn-lg" href="https://wa.me/5511937799916?text=Ol%C3%A1%21%20Gostaria%20de%20agendar%20uma%20aula%20experimental%20na%20Ikkon%20SPTD." target="_blank" rel="noopener">Agendar aula experimental</a>
                        <a class="btn btn-outline-light btn-lg" href="#cursos">Ver cursos</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="sobre" class="institucional-section institucional-about reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-about-wrap">
                <figure class="institucional-about-media mb-0">
                    <img src="~/Images/AulaTaiko.png" asp-append-version="true" alt="Aula de taiko com tambores japoneses na IKKON SPTD" class="institucional-about-image" loading="lazy" />
                </figure>
                <article class="institucional-about-content">
                    <h2 class="institucional-about-title">Tradição e contemporaneidade em São Paulo</h2>
                    <p class="institucional-about-text">
                        A IKKON SPTD é uma escola dedicada ao ensino de percussão japonesa e música tradicional, com 10 anos de trajetória em São Paulo.
                    </p>
                    <p class="institucional-about-text">
                        Aqui, você encontra um espaço acolhedor para desenvolver musicalidade, disciplina, expressão corporal e conexão com a cultura japonesa, seja você iniciante absoluto ou alguém que já tem experiência musical.
                    </p>
                    <p class="institucional-about-text mb-0">
                        Acreditamos no poder transformador da música em grupo, na energia que surge quando tocamos juntos e no respeito profundo pela tradição que nos inspira.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <section id="cursos" class="institucional-section institucional-cursos reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-section-head text-center mx-auto">
                <p class="institucional-kicker mb-2">Cursos</p>
                <h2 class="institucional-section-title">Formação musical com base cultural e prática de grupo</h2>
            </div>
            <partial name="_PublicCourseCards" />
        </div>
    </section>

    <section class="institucional-section institucional-publico reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-lg-5">
                    <div class="institucional-section-head">
                        <p class="institucional-kicker mb-2">Para quem é</p>
                        <h2 class="institucional-section-title">Um espaço para começar, evoluir e pertencer</h2>
                    </div>
                    <p class="institucional-copy mb-0">
                        A IKKON recebe iniciantes, pessoas sem experiência musical, crianças, jovens e adultos. Seja por hobby, por interesse cultural ou por desejo de palco, o caminho começa com orientação clara e progressão real.
                    </p>
                </div>
                <div class="col-12 col-lg-7">
                    <div class="institucional-tags">
                        <span>Iniciantes absolutos</span>
                        <span>Sem experiência prévia</span>
                        <span>Crianças, jovens e adultos</span>
                        <span>Interesse em cultura japonesa</span>
                        <span>Prática por hobby</span>
                        <span>Participação em apresentações</span>
                        <span>Disciplina e desenvolvimento pessoal</span>
                        <span>Treino em comunidade</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="institucional-section institucional-diferenciais reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-section-head text-center mx-auto">
                <p class="institucional-kicker mb-2">Diferenciais</p>
                <h2 class="institucional-section-title">Por que aprender na IKKON SPTD</h2>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-12 col-md-6 col-xl-3"><article class="institucional-pillar"><h3>Ensino do zero</h3><p>Metodologia acessível para quem está começando sem base musical.</p></article></div>
                <div class="col-12 col-md-6 col-xl-3"><article class="institucional-pillar"><h3>Ambiente acolhedor</h3><p>Disciplina com escuta, respeito e integração entre os alunos.</p></article></div>
                <div class="col-12 col-md-6 col-xl-3"><article class="institucional-pillar"><h3>Cultura japonesa</h3><p>Contato com repertório, prática coletiva e respeito à tradição.</p></article></div>
                <div class="col-12 col-md-6 col-xl-3"><article class="institucional-pillar"><h3>Vivência em grupo</h3><p>Escuta coletiva, presença, cooperação e possibilidade de palco.</p></article></div>
            </div>
        </div>
    </section>

    <section class="institucional-section public-video-section reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-section-head text-center mx-auto">
                <p class="institucional-kicker mb-2">Vídeos de aulas</p>
                <h2 class="institucional-section-title">Um pouco da prática na escola</h2>
            </div>
            @await Html.PartialAsync("_PublicVideoGrid", videosAulas)
        </div>
    </section>

    <section id="faq" class="institucional-section reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-section-head text-center mx-auto">
                <p class="institucional-kicker mb-2">FAQ</p>
                <h2 class="institucional-section-title">Dúvidas frequentes de alunos</h2>
            </div>
            <partial name="_PublicFaqAlunos" />
        </div>
    </section>

    <partial name="_PublicContactCta" />
    <partial name="_PublicFooter" />
</div>
