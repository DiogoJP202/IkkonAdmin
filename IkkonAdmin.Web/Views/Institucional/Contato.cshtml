@*
    Página de Contato conforme ClaudeDesign/SiteIkkon.dc.html (seção "Contato") e
    os textos de `t.contato` em ClaudeDesign/i18n.js, nos três idiomas.

    O design vai da seção direto ao rodapé: aqui não entra `_PublicContactCta`,
    senão endereços e mapas apareceriam duas vezes na mesma página.
*@
@{
    Layout = "_PublicLayout";
    ViewData["HeroCarouselMode"] = "home";

    var unidades = PublicContentCatalog.Unidades(I18n);
    var rotaLabel = I18n["Como chegar", "Directions", "ルート案内"];
}

<div class="institucional-page public-contact-page">
    <partial name="_PublicHeader" />
    <partial name="_PublicHeroCarousel" />
    <partial name="_PublicBreadcrumbs" />

    <section class="institucional-section ikkon-editorial-section reveal">
        <div class="ikkon-editorial-column ikkon-editorial-column-wide">
            <h1 class="ikkon-editorial-title">@I18n["Contato", "Contact", "お問い合わせ"]</h1>
            <span class="ikkon-editorial-rule ikkon-editorial-rule-tight" aria-hidden="true"></span>
            <p class="ikkon-editorial-intro">@I18n[
                "Venha conhecer o taiko de perto — agende uma aula experimental ou fale com a gente.",
                "Come experience taiko up close — book a trial class or talk to us.",
                "太鼓を間近で体験してください。体験レッスンのご予約やご相談はこちらから。"]</p>

            <div class="ikkon-contact-grid">
                <div class="ikkon-contact-places">
                    @foreach (var unidade in unidades)
                    {
                        <article class="ikkon-place-card">
                            <strong>@unidade.Name</strong>
                            <span>@unidade.Address</span>
                            @* O mapa inteiro é o link para as direções; o iframe fica sem
                               captura de ponteiro para o clique chegar ao <a>. *@
                            <a class="ikkon-place-map"
                               href="@unidade.DirectionsUrl"
                               target="_blank"
                               rel="noopener"
                               title="@rotaLabel">
                                <iframe src="@unidade.EmbedUrl"
                                        title="@unidade.Name"
                                        loading="lazy"
                                        referrerpolicy="no-referrer-when-downgrade"></iframe>
                                <span class="ikkon-place-map-pill">@rotaLabel <span aria-hidden="true">⟶</span></span>
                            </a>
                        </article>
                    }

                    <p class="ikkon-contact-hours">
                        <img src="~/design-ikkon/assets/selo-pequeno.png" asp-append-version="true" alt="" aria-hidden="true" />
                        <span>@I18n["Aulas de segunda a sábado", "Classes Monday to Saturday", "レッスンは月曜〜土曜"]</span>
                    </p>
                </div>

                <div class="ikkon-contact-channels">
                    @* No design o botão é inerte. Aqui ele abre o WhatsApp com a
                       mensagem já montada — ver `data-whatsapp-form` em landing.js. *@
                    <form class="ikkon-contact-form" data-whatsapp-form data-whatsapp-number="5511937799916">
                        <label>
                            <span>@I18n["Nome", "Name", "お名前"]</span>
                            <input type="text" name="nome" autocomplete="name" required />
                        </label>
                        <label>
                            <span>@I18n["E-mail", "E-mail", "メールアドレス"]</span>
                            <input type="email" name="email" autocomplete="email" required />
                        </label>
                        <label>
                            <span>@I18n["Mensagem", "Message", "メッセージ"]</span>
                            <textarea name="mensagem" rows="5" required></textarea>
                        </label>
                        <button type="submit" class="btn btn-danger">
                            <span>@I18n["Enviar mensagem", "Send message", "送信"]</span>
                            <span class="ikkon-cta-arrow" aria-hidden="true">⟶</span>
                        </button>
                        <p class="ikkon-contact-form-note">@I18n[
                            "O formulário abre o WhatsApp com a sua mensagem já escrita.",
                            "The form opens WhatsApp with your message ready to send.",
                            "フォームを送信すると、入力内容が入ったWhatsAppが開きます。"]</p>
                    </form>

                    @* Ícones declarados uma vez e reaproveitados via <use>. *@
                    <svg class="ikkon-icon-sprite" aria-hidden="true" focusable="false">
                        <symbol id="ikkon-icon-whatsapp" viewBox="0 0 24 24">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                        </symbol>
                        <symbol id="ikkon-icon-instagram" viewBox="0 0 24 24">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                        </symbol>
                    </svg>

                    <div class="ikkon-contact-links">
                        <a class="ikkon-social-pill is-solid" href="https://wa.me/5511937799916" target="_blank" rel="noopener">
                            <svg aria-hidden="true" focusable="false"><use href="#ikkon-icon-whatsapp" /></svg>
                            <span>WhatsApp</span>
                        </a>
                        <a class="ikkon-social-pill" href="https://www.instagram.com/ikkontaiko" target="_blank" rel="noopener">
                            <svg aria-hidden="true" focusable="false"><use href="#ikkon-icon-instagram" /></svg>
                            <span>@I18n["Escola", "School", "教室"] @@ikkontaiko</span>
                        </a>
                        <a class="ikkon-social-pill" href="https://www.instagram.com/ikkonensemble" target="_blank" rel="noopener">
                            <svg aria-hidden="true" focusable="false"><use href="#ikkon-icon-instagram" /></svg>
                            <span>Ensemble @@ikkonensemble</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <partial name="_PublicFooter" />
</div>
