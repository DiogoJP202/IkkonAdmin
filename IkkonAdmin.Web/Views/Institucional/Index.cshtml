@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "IKKON SPTD | Taiko em São Paulo";
    ViewData["PublicSection"] = "home";
    ViewData["ContactMode"] = "geral";

    var videosDestaque = new List<PublicVideoCardViewModel>
    {
        new("4iX-E6uIAXI", "Aula e prática de taiko", "Um recorte da vivência de treino, ritmo e presença em grupo."),
        new("2n3U_-pqmZY", "Taiko em apresentação", "Energia dos tambores japoneses em contexto de palco e evento."),
        new("b7DFAQNTpAg", "Desenvolvimento musical", "Estudo técnico para quem começa do zero e quer evoluir com consistência.")
    };
}

<div class="institucional-page public-home-page">
    <partial name="_PublicHeader" />

    <section class="institucional-hero reveal">
        <div class="institucional-hero-media" aria-hidden="true"></div>
        <div class="institucional-hero-overlay"></div>
        <div class="container-xxl px-3 px-lg-4 position-relative">
            <div class="row justify-content-center justify-content-lg-start">
                <div class="col-12 col-lg-8 col-xl-7">
                    <p class="institucional-kicker mb-2">A força do taiko em São Paulo</p>
                    <h1 class="institucional-hero-title">IKKON SPTD</h1>
                    <p class="institucional-hero-subtitle">
                        Escola de taiko, fue e teoria musical em São Paulo, também atuando como grupo artístico para eventos, shows e apresentações culturais.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a class="btn btn-danger btn-lg" href="/escola">Conhecer a escola</a>
                        <a class="btn btn-outline-light btn-lg" href="/eventos">Ver apresentações</a>
                    </div>
                    <div class="institucional-hero-badge mt-4">Aulas para todos e agenda aberta para eventos</div>
                </div>
            </div>
        </div>
    </section>

    <section class="institucional-section public-home-paths reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-section-head text-center mx-auto">
                <p class="institucional-kicker mb-2">Duas frentes, uma mesma cultura</p>
                <h2 class="institucional-section-title">Escolha o caminho que faz sentido para você</h2>
            </div>
            <div class="public-path-grid mt-4">
                <article class="public-path-card public-path-card-escola">
                    <span>Escola de Taiko</span>
                    <h3>Aprenda taiko em São Paulo</h3>
                    <p>Aulas, aprendizado musical, cultura japonesa e acolhimento para quem quer começar ou evoluir.</p>
                    <a class="btn btn-dark" href="/escola">Conhecer a escola</a>
                </article>
                <article class="public-path-card public-path-card-eventos">
                    <span>Grupo artístico e eventos</span>
                    <h3>Apresentações com energia de palco</h3>
                    <p>Shows, festivais, eventos corporativos e apresentações especiais com tambores japoneses.</p>
                    <a class="btn btn-danger" href="/eventos">Ver apresentações</a>
                </article>
            </div>
        </div>
    </section>

    <section class="institucional-section public-home-about reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-lg-5">
                    <p class="institucional-kicker mb-2">Sobre o IKKON</p>
                    <h2 class="institucional-section-title">Tradição, disciplina e comunidade</h2>
                </div>
                <div class="col-12 col-lg-7">
                    <p class="institucional-copy mb-0">
                        O IKKON SPTD une ensino de percussão japonesa, prática musical em grupo e apresentações culturais. A escola recebe iniciantes e alunos em evolução, enquanto o grupo artístico leva a força do taiko para diferentes palcos e públicos.
                    </p>
                </div>
            </div>
            <div class="row g-3 mt-4">
                <div class="col-12 col-md-6 col-xl-3"><article class="institucional-pillar"><h3>10 anos de trajetória</h3><p>Experiência no ensino e na difusão do taiko em São Paulo.</p></article></div>
                <div class="col-12 col-md-6 col-xl-3"><article class="institucional-pillar"><h3>Ensino acessível</h3><p>Base clara para quem começa sem experiência musical.</p></article></div>
                <div class="col-12 col-md-6 col-xl-3"><article class="institucional-pillar"><h3>Cultura japonesa</h3><p>Respeito à tradição com prática contemporânea e viva.</p></article></div>
                <div class="col-12 col-md-6 col-xl-3"><article class="institucional-pillar"><h3>Presença de palco</h3><p>Vivência artística em eventos, shows e apresentações.</p></article></div>
            </div>
        </div>
    </section>

    <section class="institucional-section public-video-section reveal">
        <div class="container-xxl px-3 px-lg-4">
            <div class="institucional-section-head text-center mx-auto">
                <p class="institucional-kicker mb-2">Vídeos em destaque</p>
                <h2 class="institucional-section-title">Aulas, treino e apresentações</h2>
            </div>
            @await Html.PartialAsync("_PublicVideoGrid", videosDestaque)
        </div>
    </section>

    <partial name="_PublicContactCta" />
    <partial name="_PublicFooter" />
</div>
