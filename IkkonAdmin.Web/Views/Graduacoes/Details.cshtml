@using IkkonAdmin.Web.Enums
@using IkkonAdmin.Web.Security
@model GraduacaoDetalhesViewModel
@{
    ViewData["Title"] = "Detalhes da Graduação";

    var canGraduacoesCreate = User.HasPermission(AppPermissions.GraduacoesCreate);
    var canAlunosView = User.HasPermission(AppPermissions.AlunosView);
    var totalHistorico = Model.HistoricoAluno.Count;
    var aprovadosHistorico = Model.HistoricoAluno.Count(x => x.ResultadoAprovado);
    var reprovadosHistorico = Model.HistoricoAluno.Count(x => !x.ResultadoAprovado);
    var posAprovacaoCompleta = !Model.ResultadoAprovado || (Model.CertificadoEmitido && Model.OmamoriAtualizado);
    var inicialPessoa = string.IsNullOrWhiteSpace(Model.AlunoNome)
        ? "G"
        : Model.AlunoNome.Trim()[0].ToString().ToUpperInvariant();
}

@functions {
    private static string NivelTexto(NivelGraduacaoEnum? nivel)
    {
        return nivel switch
        {
            NivelGraduacaoEnum.Iniciante => "Iniciante",
            NivelGraduacaoEnum.Basico => "Básico",
            NivelGraduacaoEnum.Intermediario => "Intermediário",
            NivelGraduacaoEnum.Avancado => "Avançado",
            NivelGraduacaoEnum.Instrutor => "Instrutor",
            _ => "-"
        };
    }
}

<div class="graduacoes-v2-page">
    <section class="graduacoes-v2-profile-hero mb-4">
        <div class="graduacoes-v2-profile-title">
            <div class="graduacoes-v2-avatar">@inicialPessoa</div>
            <div>
                <span class="graduacoes-v2-eyebrow">Detalhes do resultado</span>
                <h1>@Model.AlunoNome</h1>
                <div class="graduacoes-v2-meta">
                    <span>Resultado <strong>#@Model.Id</strong></span>
                    <span>Turma <strong>@(Model.TurmaNome ?? "-")</strong></span>
                    <span>Data <strong>@Model.DataResultado.ToString("dd/MM/yyyy")</strong></span>
                    @if (Model.ExameGraduacaoId.HasValue)
                    {
                        <span>Exame <strong>#@Model.ExameGraduacaoId</strong></span>
                    }
                </div>
            </div>
        </div>

        <div class="graduacoes-v2-hero-actions">
            <span class="graduacoes-v2-status-pill @(Model.ResultadoAprovado ? "is-success" : "is-danger")">
                @(Model.ResultadoAprovado ? "Aprovado" : "Reprovado")
            </span>
            @if (canAlunosView)
            {
                <a asp-controller="Alunos" asp-action="Details" asp-route-id="@Model.AlunoId" class="btn graduacoes-v2-btn graduacoes-v2-btn-ghost">Abrir aluno</a>
            }
            <a asp-action="Index" class="btn graduacoes-v2-btn graduacoes-v2-btn-ghost">Voltar</a>
        </div>
    </section>

    <section class="graduacoes-v2-kpi-grid mb-4" aria-label="Resumo da graduação">
        <article class="graduacoes-v2-kpi-card @(Model.ResultadoAprovado ? "is-success" : "is-danger")">
            <div class="graduacoes-v2-kpi-top">
                <span>Resultado</span>
                <b>Status</b>
            </div>
            <strong>@(Model.ResultadoAprovado ? "Aprovado" : "Reprovado")</strong>
            <small>Resultado registrado em @Model.DataResultado.ToString("dd/MM/yyyy").</small>
        </article>

        <article class="graduacoes-v2-kpi-card">
            <div class="graduacoes-v2-kpi-top">
                <span>Nível</span>
                <b>Progressão</b>
            </div>
            <strong>@NivelTexto(Model.NivelNovo ?? Model.NivelAnterior)</strong>
            <small>Anterior: @NivelTexto(Model.NivelAnterior).</small>
        </article>

        <article class="graduacoes-v2-kpi-card @(posAprovacaoCompleta ? "is-success" : "is-warning")">
            <div class="graduacoes-v2-kpi-top">
                <span>Pós-aprovação</span>
                <b>Operação</b>
            </div>
            <strong>@(posAprovacaoCompleta ? "OK" : "Pendente")</strong>
            <small>Certificado e omamori/colar.</small>
        </article>

        <article class="graduacoes-v2-kpi-card">
            <div class="graduacoes-v2-kpi-top">
                <span>Histórico</span>
                <b>Aluno</b>
            </div>
            <strong>@totalHistorico</strong>
            <small>@aprovadosHistorico aprovado(s), @reprovadosHistorico reprovado(s).</small>
        </article>
    </section>

    <div class="graduacoes-v2-details-grid mb-4">
        <section class="graduacoes-v2-form-panel">
            <div class="graduacoes-v2-panel-heading">
                <div>
                    <span class="graduacoes-v2-eyebrow">Resultado</span>
                    <h2>Registro de graduação</h2>
                    <p>Resumo pedagógico e administrativo do resultado selecionado.</p>
                </div>
            </div>

            <div class="graduacoes-v2-detail-body">
                <div class="graduacoes-v2-detail-grid">
                    <article>
                        <span>Data do resultado</span>
                        <strong>@Model.DataResultado.ToString("dd/MM/yyyy")</strong>
                    </article>
                    <article>
                        <span>Nível anterior</span>
                        <strong>@NivelTexto(Model.NivelAnterior)</strong>
                    </article>
                    <article>
                        <span>Nível novo</span>
                        <strong>@NivelTexto(Model.NivelNovo)</strong>
                    </article>
                    <article>
                        <span>Certificado</span>
                        <strong>@(Model.CertificadoEmitido ? "Emitido" : "Pendente")</strong>
                    </article>
                    <article>
                        <span>Omamori/colar</span>
                        <strong>@(Model.OmamoriAtualizado ? "Atualizado" : "Pendente")</strong>
                    </article>
                    <article>
                        <span>Status</span>
                        <strong>@(Model.ResultadoAprovado ? "Aprovado" : "Reprovado")</strong>
                    </article>
                </div>

                <div class="graduacoes-v2-note-box">
                    <span>Observações</span>
                    <p>@(string.IsNullOrWhiteSpace(Model.Observacoes) ? "Nenhuma observação registrada." : Model.Observacoes)</p>
                </div>
            </div>
        </section>

        <aside class="graduacoes-v2-side-stack">
            <section class="graduacoes-v2-side-card">
                <span class="graduacoes-v2-eyebrow">Exame vinculado</span>
                <h2>Dados do exame</h2>

                @if (Model.ExameGraduacaoId.HasValue)
                {
                    <div class="graduacoes-v2-detail-list">
                        <div>
                            <span>ID</span>
                            <strong>#@Model.ExameGraduacaoId</strong>
                        </div>
                        <div>
                            <span>Data</span>
                            <strong>@(Model.DataExame?.ToString("dd/MM/yyyy") ?? "-")</strong>
                        </div>
                        <div>
                            <span>Local</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.LocalExame) ? "-" : Model.LocalExame)</strong>
                        </div>
                        <div>
                            <span>Nível pretendido</span>
                            <strong>@NivelTexto(Model.NivelPretendidoExame)</strong>
                        </div>
                    </div>
                }
                else
                {
                    <div class="graduacoes-v2-empty-state graduacoes-v2-empty-compact">
                        <strong>Sem exame vinculado</strong>
                        <span>Resultado registrado como avulso.</span>
                    </div>
                }
            </section>

            <section class="graduacoes-v2-side-card">
                <span class="graduacoes-v2-eyebrow">Ações rápidas</span>
                <h2>Continuar fluxo</h2>
                <div class="graduacoes-v2-action-stack">
                    @if (canGraduacoesCreate)
                    {
                        <a asp-action="Create" class="btn graduacoes-v2-btn graduacoes-v2-btn-primary">Novo resultado</a>
                    }
                    @if (canAlunosView)
                    {
                        <a asp-controller="Alunos" asp-action="Details" asp-route-id="@Model.AlunoId" class="btn graduacoes-v2-btn graduacoes-v2-btn-ghost">Abrir perfil do aluno</a>
                    }
                    <a asp-action="Index" class="btn graduacoes-v2-btn graduacoes-v2-btn-ghost">Voltar para graduações</a>
                </div>
            </section>
        </aside>
    </div>

    <section class="graduacoes-v2-table-panel">
        <div class="graduacoes-v2-panel-heading">
            <div>
                <span class="graduacoes-v2-eyebrow">Linha do tempo</span>
                <h2>Histórico de graduação do aluno</h2>
                <p>Use esta linha do tempo para validar consistência da progressão técnica.</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table graduacoes-v2-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Resultado</th>
                        <th>Nível</th>
                        <th class="text-end">Detalhe</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.HistoricoAluno.Count == 0)
                    {
                        <tr>
                            <td colspan="4">
                                <div class="graduacoes-v2-empty-state">
                                    <strong>Nenhum histórico encontrado</strong>
                                    <span>O aluno ainda não possui outros registros de graduação.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.HistoricoAluno)
                        {
                            <tr class="@(item.Id == Model.Id ? "is-current" : string.Empty)">
                                <td>@item.DataResultado.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="graduacoes-v2-status-pill @(item.ResultadoAprovado ? "is-success" : "is-danger")">
                                        @(item.ResultadoAprovado ? "Aprovado" : "Reprovado")
                                    </span>
                                </td>
                                <td>
                                    <div class="graduacoes-v2-level-flow">
                                        <span>@NivelTexto(item.NivelAnterior)</span>
                                        <b>→</b>
                                        <span>@NivelTexto(item.NivelNovo)</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    @if (item.Id == Model.Id)
                                    {
                                        <span class="graduacoes-v2-count-pill">Atual</span>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn graduacoes-v2-btn-table graduacoes-v2-btn-table-primary">Abrir</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
