@using IkkonAdmin.Web.Enums
@using IkkonAdmin.Web.Security
@model GraduacaoViewModel
@{
    ViewData["Title"] = "Registrar Resultado";

    var canAlunosView = User.HasPermission(AppPermissions.AlunosView);
    var canTurmasView = User.HasPermission(AppPermissions.TurmasView);
}

@functions {
    private static string NivelTexto(NivelGraduacaoEnum? nivel)
    {
        return nivel switch
        {
            NivelGraduacaoEnum.Iniciante => "Iniciante",
            NivelGraduacaoEnum.Basico => "Básico",
            NivelGraduacaoEnum.Intermediario => "Intermediário",
            NivelGraduacaoEnum.Avancado => "Avançado",
            NivelGraduacaoEnum.Instrutor => "Instrutor",
            _ => "-"
        };
    }
}

<div class="graduacoes-v2-page">
    <section class="graduacoes-v2-form-hero mb-4">
        <div>
            <span class="graduacoes-v2-eyebrow">Novo resultado</span>
            <h1>Registrar resultado de graduação</h1>
            <p>
                Vincule o aluno a um exame existente ou crie um novo exame no mesmo fluxo, registrando resultado e pendências pós-aprovação.
            </p>
        </div>

        <div class="graduacoes-v2-hero-actions">
            <a asp-action="Index" class="btn graduacoes-v2-btn graduacoes-v2-btn-ghost">Voltar para lista</a>
            @if (canAlunosView)
            {
                <a asp-controller="Alunos" asp-action="Index" class="btn graduacoes-v2-btn graduacoes-v2-btn-ghost">Consultar alunos</a>
            }
            @if (canTurmasView)
            {
                <a asp-controller="Turmas" asp-action="Index" class="btn graduacoes-v2-btn graduacoes-v2-btn-ghost">Consultar turmas</a>
            }
        </div>
    </section>

    <div class="graduacoes-v2-form-layout">
        <section class="graduacoes-v2-form-panel">
            <form asp-action="Create" method="post" class="graduacoes-v2-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="graduacoes-v2-validation-summary"></div>

                <section class="graduacoes-v2-form-section">
                    <div class="graduacoes-v2-section-title">
                        <span>01</span>
                        <div>
                            <h2>Aluno e resultado</h2>
                            <p>Selecione o aluno, registre a data do resultado e informe se houve aprovação.</p>
                        </div>
                    </div>

                    <div class="graduacoes-v2-form-grid">
                        <div class="graduacoes-v2-field graduacoes-v2-field-span-2">
                            <label asp-for="AlunoId">Aluno</label>
                            <select asp-for="AlunoId" class="form-select graduacoes-v2-control">
                                <option value="">Selecione um aluno</option>
                                @foreach (var aluno in Model.AlunosDisponiveis)
                                {
                                    var label = $"{aluno.Nome} | Turma: {(aluno.TurmaNome ?? "-")} | Nível atual: {NivelTexto(aluno.NivelAtual)}";
                                    if (aluno.Id == Model.AlunoId)
                                    {
                                        <option value="@aluno.Id" selected>@label</option>
                                    }
                                    else
                                    {
                                        <option value="@aluno.Id">@label</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="AlunoId" class="text-danger"></span>
                        </div>

                        <div class="graduacoes-v2-field">
                            <label asp-for="DataResultado">Data do resultado</label>
                            <input asp-for="DataResultado"
                                   type="date"
                                   class="form-control graduacoes-v2-control" />
                            <span asp-validation-for="DataResultado" class="text-danger"></span>
                        </div>

                        <label class="graduacoes-v2-check-card">
                            <input asp-for="ResultadoAprovado" class="form-check-input" />
                            <span>
                                <strong>Resultado aprovado</strong>
                                <small>Marque quando o aluno avançou no exame.</small>
                            </span>
                        </label>

                        <div class="graduacoes-v2-field">
                            <label asp-for="NivelNovo">Novo nível</label>
                            <select asp-for="NivelNovo" class="form-select graduacoes-v2-control">
                                <option value="">Não se aplica</option>
                                @foreach (var nivel in Enum.GetValues<NivelGraduacaoEnum>())
                                {
                                    if (Model.NivelNovo == nivel)
                                    {
                                        <option value="@((int)nivel)" selected>@NivelTexto(nivel)</option>
                                    }
                                    else
                                    {
                                        <option value="@((int)nivel)">@NivelTexto(nivel)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="NivelNovo" class="text-danger"></span>
                        </div>

                        <div class="graduacoes-v2-result-note">
                            <span>Pós-aprovação</span>
                            <strong>Certificado e omamori</strong>
                            <small>Esses campos ajudam a manter a fila de pendências atualizada.</small>
                        </div>
                    </div>

                    <div class="graduacoes-v2-check-grid mt-3">
                        <label class="graduacoes-v2-check-card">
                            <input asp-for="CertificadoEmitido" class="form-check-input" />
                            <span>
                                <strong>Certificado emitido</strong>
                                <small>Documento de graduação preparado ou entregue.</small>
                            </span>
                        </label>

                        <label class="graduacoes-v2-check-card">
                            <input asp-for="OmamoriAtualizado" class="form-check-input" />
                            <span>
                                <strong>Omamori/colar atualizado</strong>
                                <small>Registro físico ou visual da graduação atualizado.</small>
                            </span>
                        </label>
                    </div>
                </section>

                <section class="graduacoes-v2-form-section">
                    <div class="graduacoes-v2-section-title">
                        <span>02</span>
                        <div>
                            <h2>Exame de graduação</h2>
                            <p>Use um exame existente ou preencha os dados de um novo exame para criar junto com o resultado.</p>
                        </div>
                    </div>

                    <div class="graduacoes-v2-form-grid">
                        <div class="graduacoes-v2-field graduacoes-v2-field-span-3">
                            <label asp-for="ExameGraduacaoId">Exame existente</label>
                            <select asp-for="ExameGraduacaoId" class="form-select graduacoes-v2-control">
                                <option value="">Criar novo exame com os dados abaixo</option>
                                @foreach (var exame in Model.ExamesDisponiveis)
                                {
                                    var label = $"#{exame.Id} | {exame.DataExame:dd/MM/yyyy} | {NivelTexto(exame.NivelPretendido)} | {(string.IsNullOrWhiteSpace(exame.Local) ? "Sem local" : exame.Local)}";
                                    if (Model.ExameGraduacaoId.HasValue && Model.ExameGraduacaoId.Value == exame.Id)
                                    {
                                        <option value="@exame.Id" selected>@label</option>
                                    }
                                    else
                                    {
                                        <option value="@exame.Id">@label</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ExameGraduacaoId" class="text-danger"></span>
                        </div>

                        <div class="graduacoes-v2-field">
                            <label asp-for="DataExameNovo">Novo exame: data</label>
                            <input asp-for="DataExameNovo"
                                   type="date"
                                   class="form-control graduacoes-v2-control" />
                            <span asp-validation-for="DataExameNovo" class="text-danger"></span>
                        </div>

                        <div class="graduacoes-v2-field">
                            <label asp-for="NivelPretendidoExameNovo">Novo exame: nível</label>
                            <select asp-for="NivelPretendidoExameNovo" class="form-select graduacoes-v2-control">
                                @foreach (var nivel in Enum.GetValues<NivelGraduacaoEnum>())
                                {
                                    if (Model.NivelPretendidoExameNovo == nivel)
                                    {
                                        <option value="@((int)nivel)" selected>@NivelTexto(nivel)</option>
                                    }
                                    else
                                    {
                                        <option value="@((int)nivel)">@NivelTexto(nivel)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="graduacoes-v2-field">
                            <label asp-for="LocalExameNovo">Novo exame: local</label>
                            <input asp-for="LocalExameNovo"
                                   type="text"
                                   class="form-control graduacoes-v2-control"
                                   maxlength="150"
                                   placeholder="Ex.: Dojô Ikkon, palco principal ou sala de aula" />
                            <span asp-validation-for="LocalExameNovo" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="graduacoes-v2-form-section">
                    <div class="graduacoes-v2-section-title">
                        <span>03</span>
                        <div>
                            <h2>Observações</h2>
                            <p>Registre informações pedagógicas e administrativas relevantes para o acompanhamento.</p>
                        </div>
                    </div>

                    <div class="graduacoes-v2-field">
                        <label asp-for="Observacoes">Observações</label>
                        <textarea asp-for="Observacoes"
                                  rows="3"
                                  class="form-control graduacoes-v2-control"
                                  placeholder="Ex.: orientar fundamentos específicos, revisar postura, emitir certificado na próxima aula."></textarea>
                        <span asp-validation-for="Observacoes" class="text-danger"></span>
                    </div>
                </section>

                <div class="graduacoes-v2-form-actions">
                    <a asp-action="Index" class="btn graduacoes-v2-btn graduacoes-v2-btn-ghost">Cancelar</a>
                    <button type="submit" class="btn graduacoes-v2-btn graduacoes-v2-btn-primary">Salvar resultado</button>
                </div>
            </form>
        </section>

        <aside class="graduacoes-v2-assist-card">
            <span class="graduacoes-v2-eyebrow">Guia rápido</span>
            <h2>Registro consistente</h2>
            <ul>
                <li>Vincule ao exame correto sempre que existir uma data já cadastrada.</li>
                <li>Se o aluno foi aprovado, informe o novo nível para manter o histórico coerente.</li>
                <li>Atualize certificado e omamori para evitar pendências pós-aprovação.</li>
                <li>Use observações para feedback pedagógico objetivo, sem textos longos.</li>
            </ul>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
