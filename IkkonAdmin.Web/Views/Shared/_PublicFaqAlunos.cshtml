@{
    var faqItems = PublicContentCatalog.StudentFaq(I18n);
}

<div class="accordion institucional-faq mt-3" id="faqAccordion">
    @for (var index = 0; index < faqItems.Count; index++)
    {
        var item = faqItems[index];
        var itemNumber = index + 1;
        var itemId = $"faq{itemNumber}";
        var isFirst = index == 0;

        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button @(!isFirst ? "collapsed" : null)"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#@itemId"
                        aria-expanded="@(isFirst ? "true" : "false")"
                        aria-controls="@itemId">@item.Question</button>
            </h3>
            <div id="@itemId"
                 class="accordion-collapse collapse @(isFirst ? "show" : null)"
                 data-bs-parent="#faqAccordion">
                <div class="accordion-body">@item.Answer</div>
            </div>
        </div>
    }
</div>
