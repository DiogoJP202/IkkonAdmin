@using IkkonAdmin.Web.Enums
@using IkkonAdmin.Web.Security
@{
    var temaPreferencia = User.FindFirst(AppClaimTypes.TemaPreferencia)?.Value;
    var isDarkTheme = string.Equals(temaPreferencia, TemaPreferenciaEnum.Escuro.ToString(), StringComparison.OrdinalIgnoreCase);
    var themeClass = isDarkTheme ? "admin-theme-dark" : "admin-theme-light";
    var themeName = isDarkTheme ? "dark" : "light";
    var htmlLang = I18n.IsEnglish ? "en" : "pt-BR";
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var adminCssModules = AdminCssModuleResolver.Resolve(controllerName);
}
<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IkkonAdmin</title>
    <link rel="icon" type="image/png" href="~/Images/Ikkon_Icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/ikkon-internal-foundation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ikkon-admin-core.css" asp-append-version="true" />
    @foreach (var cssModule in adminCssModules)
    {
        <link rel="stylesheet" href="~/css/@cssModule" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/ikkon-internal-themes.css" asp-append-version="true" />
</head>
<body class="admin-body @themeClass" data-theme="@themeName">
    <div class="admin-shell">
        @await Html.PartialAsync("_Sidebar")
        <div class="admin-sidebar-backdrop" data-admin-sidebar-close aria-hidden="true"></div>

        <div class="admin-content">
            @await Html.PartialAsync("_Topbar")
            <main class="admin-main">
                <div class="container-fluid">
                    @await Html.PartialAsync("_Alerts")
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/i18n-ui.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
