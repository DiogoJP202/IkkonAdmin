@using System.Security.Claims
@using Microsoft.AspNetCore.Html
@using IkkonAdmin.Web.Data
@using IkkonAdmin.Web.Enums
@using IkkonAdmin.Web.Security
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    string IsActive(string controller) => currentController == controller.ToLowerInvariant() ? "active" : string.Empty;

    var canDashboard = User.HasPermission(AppPermissions.DashboardView);
    var canAlunos = User.HasPermission(AppPermissions.AlunosView);
    var canTurmas = User.HasPermission(AppPermissions.TurmasView);
    var canFinanceiro = User.HasPermission(AppPermissions.FinanceiroView);
    var canAdmissoes = User.HasPermission(AppPermissions.AdmissoesView);
    var canDesligamentos = User.HasPermission(AppPermissions.DesligamentosView);
    var canGraduacoes = User.HasPermission(AppPermissions.GraduacoesView);
    var canAgenda = User.HasAnyPermission(AppPermissions.GoogleAgendaView, AppPermissions.GoogleAgendaManage);
    var canInventario = User.HasAnyPermission(AppPermissions.InventarioView, AppPermissions.InventarioManage);
    var canBlog = User.HasPermission(AppPermissions.BlogView);
    var canAreaAluno = User.HasAnyPermission(
        AppPermissions.AreaAlunoView,
        AppPermissions.AulasView,
        AppPermissions.FrequenciaView,
        AppPermissions.DocumentosView,
        AppPermissions.ComunicadosView,
        AppPermissions.EventosAlunoView,
        AppPermissions.ConquistasView);
    var canConfiguracoes = User.HasPermission(AppPermissions.ConfiguracoesView);

    var canAdminPanel = User.IsInRole(AppRoles.Admin) && User.HasAnyPermission(
        AppPermissions.VisualizarDados,
        AppPermissions.GerenciarUsuarios,
        AppPermissions.GerenciarCargos,
        AppPermissions.GerenciarSistema,
        AppPermissions.EditarPermissoes);

    var userName = User.Identity?.Name ?? I18n["Usuário interno", "Internal user"];
    var userPhotoUrl = User.FindFirst(AppClaimTypes.FotoPerfilUrl)?.Value;
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value;
    var userRoleLabel = User.IsInRole(AppRoles.Admin) ? I18n["Administrador", "Administrator"] : I18n["Funcionário", "Employee"];

    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId))
    {
        var sidebarUser = await DbContext.UsuariosSistema
            .AsNoTracking()
            .Where(x => x.Id == currentUserId)
            .Select(x => new
            {
                x.NomeExibicao,
                x.Email,
                x.FotoPerfilUrl,
                x.TipoAcesso
            })
            .FirstOrDefaultAsync();

        if (sidebarUser is not null)
        {
            userName = sidebarUser.NomeExibicao;
            userEmail = sidebarUser.Email;
            userPhotoUrl = sidebarUser.FotoPerfilUrl;
            userRoleLabel = sidebarUser.TipoAcesso == TipoAcessoEnum.Admin ? I18n["Administrador", "Administrator"] : I18n["Funcionário", "Employee"];
        }
    }

    var initialsParts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var userInitials = string.Concat(initialsParts.Take(2).Select(part => part[0])).ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(userInitials))
    {
        userInitials = "U";
    }
}

@functions {
    private static IHtmlContent SidebarIcon(string icon)
    {
        var content = icon switch
        {
            "dashboard" => """<rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect>""",
            "users" => """<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>""",
            "layers" => """<path d="M12 2 2 7l10 5 10-5-10-5Z"></path><path d="m2 12 10 5 10-5"></path><path d="m2 17 10 5 10-5"></path>""",
            "wallet" => """<path d="M19 7V5a2 2 0 0 0-2-2H5a3 3 0 0 0 0 6h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V6"></path><path d="M16 13h.01"></path>""",
            "user-plus" => """<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M19 8v6"></path><path d="M22 11h-6"></path>""",
            "user-x" => """<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="m17 8 5 5"></path><path d="m22 8-5 5"></path>""",
            "award" => """<circle cx="12" cy="8" r="5"></circle><path d="M8.5 12.5 7 22l5-3 5 3-1.5-9.5"></path>""",
            "calendar" => """<rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path>""",
            "package" => """<path d="m21 8-9-5-9 5 9 5 9-5Z"></path><path d="M3 8v8l9 5 9-5V8"></path><path d="M12 13v8"></path>""",
            "graduation" => """<path d="M22 10 12 5 2 10l10 5 10-5Z"></path><path d="M6 12v5c3.5 2 8.5 2 12 0v-5"></path><path d="M22 10v6"></path>""",
            "settings" => """<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.05.05a2 2 0 1 1-2.83 2.83l-.05-.05A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6V20a2 2 0 1 1-4 0v-.08a1.7 1.7 0 0 0-1-.6 1.7 1.7 0 0 0-1.88.34l-.05.05a2 2 0 1 1-2.83-2.83l.05-.05A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1H4a2 2 0 1 1 0-4h.08a1.7 1.7 0 0 0 .6-1 1.7 1.7 0 0 0-.34-1.88l-.05-.05a2 2 0 1 1 2.83-2.83l.05.05A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6V4a2 2 0 1 1 4 0v.08a1.7 1.7 0 0 0 1 .6 1.7 1.7 0 0 0 1.88-.34l.05-.05a2 2 0 1 1 2.83 2.83l-.05.05A1.7 1.7 0 0 0 19.4 9c.23.35.43.68.6 1H20a2 2 0 1 1 0 4h-.08a1.7 1.7 0 0 0-.52 1Z"></path>""",
            "shield" => """<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-5"></path>""",
            "file-text" => """<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path><path d="M14 2v6h6"></path><path d="M16 13H8"></path><path d="M16 17H8"></path><path d="M10 9H8"></path>""",
            _ => """<circle cx="12" cy="12" r="8"></circle>"""
        };

        return new HtmlString($"""<span class="sidebar-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">{content}</svg></span>""");
    }
}

<aside id="adminSidebar" class="admin-sidebar" aria-label="@I18n["Menu administrativo", "Admin menu"]">
    <div class="sidebar-control">
        <button type="button"
                class="sidebar-toggle"
                data-admin-sidebar-toggle
                aria-controls="adminSidebar"
                aria-expanded="true"
                aria-label="@I18n["Expandir ou minimizar menu", "Expand or collapse menu"]">
            <span class="sidebar-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="sidebar-toggle-label">@I18n["Menu", "Menu"]</span>
        </button>
    </div>

    <nav class="nav flex-column sidebar-nav">
        @if (canDashboard)
        {
            <a href="/admin" class="nav-link @IsActive("Home")" data-short="D" title="Dashboard">@SidebarIcon("dashboard")<span class="sidebar-nav-label">Dashboard</span></a>
        }
        @if (canAlunos)
        {
            <a href="/admin/Alunos" class="nav-link @IsActive("Alunos")" data-short="AL" title="@I18n["Alunos", "Students"]">@SidebarIcon("users")<span class="sidebar-nav-label">@I18n["Alunos", "Students"]</span></a>
        }
        @if (canTurmas)
        {
            <a href="/admin/Turmas" class="nav-link @IsActive("Turmas")" data-short="T" title="@I18n["Turmas", "Groups"]">@SidebarIcon("layers")<span class="sidebar-nav-label">@I18n["Turmas", "Groups"]</span></a>
        }
        @if (canFinanceiro)
        {
            <a href="/admin/Financeiro" class="nav-link @IsActive("Financeiro")" data-short="F" title="@I18n["Financeiro", "Finance"]">@SidebarIcon("wallet")<span class="sidebar-nav-label">@I18n["Financeiro", "Finance"]</span></a>
        }
        @if (canAdmissoes)
        {
            <a href="/admin/Admissoes" class="nav-link @IsActive("Admissoes")" data-short="AD" title="@I18n["Admissões", "Admissions"]">@SidebarIcon("user-plus")<span class="sidebar-nav-label">@I18n["Admissões", "Admissions"]</span></a>
        }
        @if (canDesligamentos)
        {
            <a href="/admin/Desligamentos" class="nav-link @IsActive("Desligamentos")" data-short="DE" title="@I18n["Desligamentos", "Deactivations"]">@SidebarIcon("user-x")<span class="sidebar-nav-label">@I18n["Desligamentos", "Deactivations"]</span></a>
        }
        @if (canGraduacoes)
        {
            <a href="/admin/Graduacoes" class="nav-link @IsActive("Graduacoes")" data-short="G" title="@I18n["Graduações", "Graduations"]">@SidebarIcon("award")<span class="sidebar-nav-label">@I18n["Graduações", "Graduations"]</span></a>
        }
        @if (canAgenda)
        {
            <a href="/admin/agenda" class="nav-link @IsActive("GoogleAgenda")" data-short="AG" title="@I18n["Agenda", "Calendar"]">@SidebarIcon("calendar")<span class="sidebar-nav-label">@I18n["Agenda", "Calendar"]</span></a>
        }
        @if (canInventario)
        {
            <a href="/admin/inventario" class="nav-link @IsActive("Inventario")" data-short="I" title="@I18n["Inventário", "Inventory"]">@SidebarIcon("package")<span class="sidebar-nav-label">@I18n["Inventário", "Inventory"]</span></a>
        }
        @if (canAreaAluno)
        {
            <a href="/admin/area-aluno" class="nav-link @IsActive("AreaAlunoAdmin")" data-short="AA" title="@I18n["Área do Aluno", "Student Area"]">@SidebarIcon("graduation")<span class="sidebar-nav-label">@I18n["Área do Aluno", "Student Area"]</span></a>
        }
        @if (canConfiguracoes)
        {
            <a href="/configuracoes" class="nav-link @IsActive("Configuracoes")" data-short="C" title="@I18n["Configurações", "Settings"]">@SidebarIcon("settings")<span class="sidebar-nav-label">@I18n["Configurações", "Settings"]</span></a>
        }
        @if (canAdminPanel)
        {
            <a href="/admin/painel" class="nav-link @IsActive("PainelAdmin")" data-short="ADM" title="@I18n["Administração", "Administration"]">@SidebarIcon("shield")<span class="sidebar-nav-label">@I18n["Administração", "Administration"]</span></a>
        }
        @if (canBlog)
        {
            <a href="/admin/blog" class="nav-link @(currentController is "blogadmin" or "blogcategorias" ? "active" : string.Empty)" data-short="B" title="Blog">@SidebarIcon("file-text")<span class="sidebar-nav-label">Blog</span></a>
        }
    </nav>

    <div class="sidebar-user">
        @if (canConfiguracoes)
        {
            <a href="/configuracoes" class="sidebar-user-card" title="@userName">
                <span class="sidebar-user-avatar">
                    @if (!string.IsNullOrWhiteSpace(userPhotoUrl))
                    {
                        <img src="@userPhotoUrl" alt="@I18n["Foto de", "Photo of"] @userName" />
                    }
                    else
                    {
                        <span>@userInitials</span>
                    }
                </span>
                <span class="sidebar-user-details">
                    <strong>@userName</strong>
                    <small>@userRoleLabel</small>
                    @if (!string.IsNullOrWhiteSpace(userEmail))
                    {
                        <em>@userEmail</em>
                    }
                </span>
            </a>
        }
        else
        {
            <div class="sidebar-user-card" title="@userName">
                <span class="sidebar-user-avatar">
                    @if (!string.IsNullOrWhiteSpace(userPhotoUrl))
                    {
                        <img src="@userPhotoUrl" alt="@I18n["Foto de", "Photo of"] @userName" />
                    }
                    else
                    {
                        <span>@userInitials</span>
                    }
                </span>
                <span class="sidebar-user-details">
                    <strong>@userName</strong>
                    <small>@userRoleLabel</small>
                    @if (!string.IsNullOrWhiteSpace(userEmail))
                    {
                        <em>@userEmail</em>
                    }
                </span>
            </div>
        }
    </div>
</aside>
