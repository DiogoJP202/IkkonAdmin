@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Ikkon SPTD";
    var japaneseLandingEnabled = ViewData["JapaneseLandingEnabled"] as bool? == true;
    var japanesePublicEnabled = ViewData["JapanesePublicEnabled"] as bool? == true;
    var publicConstructionTagEnabled = ViewData["PublicConstructionTagEnabled"] as bool? == true;
    var japaneseContentEnabled = japaneseLandingEnabled || japanesePublicEnabled;
    var pageDescription = ViewData["Description"]?.ToString() ?? (japaneseContentEnabled
        ? I18n["Ikkon SPTD | Escola de Taiko. Ensino de percussão japonesa para todos em São Paulo, com aulas, eventos e shows.", "Ikkon SPTD | Taiko school. Japanese percussion classes for everyone in Sao Paulo, with classes, events, and shows.", "IKKON SPTD | サンパウロの和太鼓教室。レッスン、イベント、公演を通じて日本の打楽器を学べる場所です。"]
        : I18n["Ikkon SPTD | Escola de Taiko. Ensino de percussão japonesa para todos em São Paulo, com aulas, eventos e shows.", "Ikkon SPTD | Taiko school. Japanese percussion classes for everyone in Sao Paulo, with classes, events, and shows."]);
    var canonicalUrl = ViewData["CanonicalUrl"]?.ToString();
    var ogTitle = ViewData["OgTitle"]?.ToString() ?? pageTitle;
    var ogDescription = ViewData["OgDescription"]?.ToString() ?? pageDescription;
    var ogType = ViewData["OgType"]?.ToString() ?? "website";
    var ogImage = ViewData["OgImage"]?.ToString();
    var htmlLang = I18n.IsJapanese && japaneseContentEnabled ? "ja" : I18n.IsEnglish ? "en" : "pt-BR";
}
<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:url" content="@canonicalUrl" />
    }
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@ogDescription" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:site_name" content="IKKON SPTD" />
    @if (!string.IsNullOrWhiteSpace(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    <link rel="icon" type="image/png" href="~/Images/Ikkon_Icon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ikkon-public-foundation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ikkon-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ikkon-editorial.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ikkon-editorial-responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ikkon-compositions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ikkon-responsive.css" asp-append-version="true" />
    @if (publicConstructionTagEnabled)
    {
        <link rel="stylesheet" href="~/css/public-construction-tag.css" asp-append-version="true" />
    }
</head>
<body class="institucional-body">
    @if (publicConstructionTagEnabled)
    {
        <partial name="_PublicConstructionTag" />
    }

    @RenderBody()

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/i18n-ui.js" asp-append-version="true"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>
    @if (publicConstructionTagEnabled)
    {
        <script src="~/js/public-construction-tag.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
