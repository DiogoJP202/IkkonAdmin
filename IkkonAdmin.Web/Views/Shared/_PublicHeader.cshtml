@{
    var current = (ViewData["PublicSection"] as string ?? "home").ToLowerInvariant();
    var currentRequestPath = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    string LanguageReturnUrl(string culture) => I18n.PathForCulture(currentRequestPath, culture);
    string LanguageClass(string culture) => string.Equals(I18n.CurrentCulture, culture, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;
}

<header class="institucional-header fixed-top">
    <nav class="navbar navbar-expand-lg">
        <div class="container-xxl px-3 px-lg-4">
            <a class="navbar-brand institucional-brand" href="@I18n.LocalizePath("/?entrada=1")">
                <span class="institucional-brand-mark" aria-hidden="true">
                    <img src="~/design-ikkon/assets/emblema-mitsudomoe.png" asp-append-version="true" alt="" class="institucional-brand-logo" />
                    <img src="~/design-ikkon/assets/selo-pequeno.png" asp-append-version="true" alt="" class="institucional-brand-seal" />
                </span>
                <span class="institucional-brand-lines">
                    <strong>IKKON</strong>
                    <small>São Paulo Taiko Dojo</small>
                </span>
            </a>
            <button class="navbar-toggler institucional-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navLanding" aria-controls="navLanding" aria-expanded="false" aria-label="@I18n["Alternar navegação", "Toggle navigation", "ナビゲーションを切り替える"]">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navLanding">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link @(current == "home" ? "active" : string.Empty)" href="@I18n.LocalizePath("/")" aria-current="@(current == "home" ? "page" : null)">@I18n["Home", "Home", "ホーム"]</a></li>
                    <li class="nav-item"><a class="nav-link @(current == "sobre" ? "active" : string.Empty)" href="@I18n.LocalizePath("/sobre")" aria-current="@(current == "sobre" ? "page" : null)">@I18n["Sobre Nós", "About Us", "私たちについて"]</a></li>
                    <li class="nav-item"><a class="nav-link @(current == "aulas" ? "active" : string.Empty)" href="@I18n.LocalizePath("/aulas")" aria-current="@(current == "aulas" ? "page" : null)">@I18n["Aulas", "Classes", "クラス"]</a></li>
                    <li class="nav-item"><a class="nav-link @(current == "eventos" ? "active" : string.Empty)" href="@I18n.LocalizePath("/eventos")" aria-current="@(current == "eventos" ? "page" : null)">@I18n["Eventos", "Events", "イベント"]</a></li>
                    <li class="nav-item"><a class="nav-link @(current == "galeria" ? "active" : string.Empty)" href="@I18n.LocalizePath("/galeria")" aria-current="@(current == "galeria" ? "page" : null)">@I18n["Galeria", "Gallery", "ギャラリー"]</a></li>
                    <li class="nav-item"><a class="nav-link @(current == "blog" ? "active" : string.Empty)" href="@I18n.LocalizePath("/blog")" aria-current="@(current == "blog" ? "page" : null)">Blog</a></li>
                    <li class="nav-item"><a class="nav-link" href="@I18n.LocalizePath("/aulas#faq")">FAQ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/aluno/login">@I18n["Área do aluno", "Student area", "生徒エリア"]</a></li>
                    <li class="nav-item"><a class="nav-link" href="/auth/login">@I18n["Área interna", "Staff area", "スタッフエリア"]</a></li>
                    <li class="nav-item ms-lg-2">
                        <div class="institucional-language-list" aria-label="@I18n["Selecionar idioma", "Select language", "言語を選択"]">
                            <a class="institucional-language-link @LanguageClass("pt-BR")"
                               asp-controller="Idioma"
                               asp-action="Alterar"
                               asp-route-culture="pt-BR"
                               asp-route-returnUrl="@LanguageReturnUrl("pt-BR")">PT</a>
                            <a class="institucional-language-link @LanguageClass("en-US")"
                               asp-controller="Idioma"
                               asp-action="Alterar"
                               asp-route-culture="en-US"
                               asp-route-returnUrl="@LanguageReturnUrl("en-US")">EN</a>
                            <a class="institucional-language-link @LanguageClass("ja-JP")"
                               asp-controller="Idioma"
                               asp-action="Alterar"
                               asp-route-culture="ja-JP"
                               asp-route-returnUrl="@LanguageReturnUrl("ja-JP")">日本語</a>
                        </div>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-sm btn-danger institucional-nav-cta" href="@I18n.LocalizePath("/contato")">@I18n["Contato", "Contact", "お問い合わせ"]</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
