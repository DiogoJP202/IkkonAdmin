@{
    var modo = (ViewData["ContactMode"] as string ?? "geral").ToLowerInvariant();
    var titulo = modo switch
    {
        "escola" => I18n["Quer começar nas aulas de taiko?", "Ready to start taiko classes?", "和太鼓レッスンを始めてみませんか？"],
        "eventos" => I18n["Quer levar o taiko para o seu evento?", "Want to bring taiko to your event?", "あなたのイベントに太鼓を届けませんか？"],
        _ => I18n["Quer falar com o IKKON?", "Want to talk to IKKON?", "IKKONに問い合わせる"]
    };
    var texto = modo switch
    {
        "escola" => I18n["Fale com a escola para agendar uma aula experimental e entender a melhor turma para começar.", "Talk to the school to schedule a trial class and find the best group to start with.", "体験レッスンの予約や、始めるのに合うクラスについてお気軽にご相談ください。"],
        "eventos" => I18n["Fale com a equipe para apresentações, shows, eventos culturais e projetos especiais.", "Talk to the team about performances, shows, cultural events, and special projects.", "公演、ショー、文化イベント、特別企画についてチームにご相談ください。"],
        _ => I18n["Entre em contato para aulas, apresentações e projetos especiais.", "Get in touch for classes, performances, and special projects.", "レッスン、公演、特別企画についてお気軽にお問い合わせください。"]
    };
    var primaryHref = modo == "eventos"
        ? "https://wa.me/5511937799916?text=Ol%C3%A1%21%20Gostaria%20de%20solicitar%20uma%20apresenta%C3%A7%C3%A3o%20da%20Ikkon%20SPTD%20para%20evento."
        : "https://wa.me/5511937799916?text=Ol%C3%A1%21%20Gostaria%20de%20agendar%20uma%20aula%20experimental%20na%20Ikkon%20SPTD.";
    var primaryText = modo == "eventos" ? I18n["Solicitar apresentação", "Request a performance", "公演を依頼する"] : I18n["Agendar aula experimental", "Schedule a trial class", "体験レッスンを予約する"];
    var unidades = PublicContentCatalog.Unidades(I18n);
}

<section id="contato" class="institucional-section institucional-contato reveal">
    <div class="container-xxl px-3 px-lg-4">
        <div class="row g-4 align-items-stretch">
            <div class="col-12 col-lg-6">
                <div class="institucional-contact-content h-100">
                    <p class="institucional-kicker mb-2">@I18n["Contato", "Contact", "お問い合わせ"]</p>
                    <h2 class="institucional-section-title">@titulo</h2>
                    <p class="institucional-copy mb-0">@texto</p>
                    <ul class="institucional-address-list">
                        @foreach (var unidade in unidades)
                        {
                            <li>
                                <strong>@unidade.Name</strong>
                                <span>@unidade.Address</span>
                            </li>
                        }
                    </ul>

                    <div class="institucional-cta-box d-grid gap-2 mt-4">
                        <a class="btn btn-danger btn-lg" href="@primaryHref" target="_blank" rel="noopener">@primaryText</a>
                        <a class="btn btn-outline-dark btn-lg" href="https://wa.me/5511937799916?text=Ol%C3%A1%21%20Vim%20pelo%20site%20da%20Ikkon%20SPTD%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es." target="_blank" rel="noopener">@I18n["Entrar em contato no WhatsApp", "Contact us on WhatsApp", "WhatsAppで問い合わせる"]</a>
                        @if (modo == "geral")
                        {
                            <a class="btn btn-outline-dark btn-lg" href="https://wa.me/5511937799916?text=Ol%C3%A1%21%20Gostaria%20de%20solicitar%20uma%20apresenta%C3%A7%C3%A3o%20da%20Ikkon%20SPTD%20para%20evento." target="_blank" rel="noopener">@I18n["Solicitar apresentação", "Request a performance", "公演を依頼する"]</a>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="institucional-map-stack h-100">
                    @foreach (var unidade in unidades)
                    {
                        <article class="institucional-map-card" aria-label="@unidade.Name">
                            <div class="institucional-map-header">
                                <span>@I18n["Localização", "Location", "所在地"]</span>
                                <strong>@unidade.Name</strong>
                            </div>
                            <div class="institucional-map-frame">
                                <iframe
                                    title="@unidade.Name — @unidade.Address"
                                    src="@unidade.EmbedUrl"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    allowfullscreen>
                                </iframe>
                            </div>
                            <a class="institucional-map-link" href="@unidade.DirectionsUrl" target="_blank" rel="noopener">
                                @I18n["Como chegar", "Directions", "ルート案内"]
                            </a>
                        </article>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
