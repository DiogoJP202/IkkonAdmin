@{
    var modo = (ViewData["ContactMode"] as string ?? "geral").ToLowerInvariant();
    var titulo = modo switch
    {
        "escola" => "Quer começar nas aulas de taiko?",
        "eventos" => "Quer levar o taiko para o seu evento?",
        _ => "Quer falar com o IKKON?"
    };
    var texto = modo switch
    {
        "escola" => "Fale com a escola para agendar uma aula experimental e entender a melhor turma para começar.",
        "eventos" => "Fale com a equipe para apresentações, shows, eventos culturais e projetos especiais.",
        _ => "Entre em contato para aulas, apresentações e projetos especiais."
    };
    var primaryHref = modo == "eventos"
        ? "https://wa.me/5511937799916?text=Ol%C3%A1%21%20Gostaria%20de%20solicitar%20uma%20apresenta%C3%A7%C3%A3o%20da%20Ikkon%20SPTD%20para%20evento."
        : "https://wa.me/5511937799916?text=Ol%C3%A1%21%20Gostaria%20de%20agendar%20uma%20aula%20experimental%20na%20Ikkon%20SPTD.";
    var primaryText = modo == "eventos" ? "Solicitar apresentação" : "Agendar aula experimental";
    var endereco = "Rua Domingos de Morais, 2975, São Paulo, Brazil";
    var mapsQuery = "Rua%20Domingos%20de%20Morais%2C%202975%2C%20S%C3%A3o%20Paulo%2C%20Brazil";
}

<section id="contato" class="institucional-section institucional-contato reveal">
    <div class="container-xxl px-3 px-lg-4">
        <div class="row g-4 align-items-stretch">
            <div class="col-12 col-lg-6">
                <div class="institucional-contact-content h-100">
                    <p class="institucional-kicker mb-2">Contato</p>
                    <h2 class="institucional-section-title">@titulo</h2>
                    <p class="institucional-copy mb-0">@texto</p>
                    <p class="institucional-address mt-3 mb-0">@endereco</p>

                    <div class="institucional-cta-box d-grid gap-2 mt-4">
                        <a class="btn btn-danger btn-lg" href="@primaryHref" target="_blank" rel="noopener">@primaryText</a>
                        <a class="btn btn-outline-dark btn-lg" href="https://wa.me/5511937799916?text=Ol%C3%A1%21%20Vim%20pelo%20site%20da%20Ikkon%20SPTD%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es." target="_blank" rel="noopener">Entrar em contato no WhatsApp</a>
                        @if (modo == "geral")
                        {
                            <a class="btn btn-outline-dark btn-lg" href="https://wa.me/5511937799916?text=Ol%C3%A1%21%20Gostaria%20de%20solicitar%20uma%20apresenta%C3%A7%C3%A3o%20da%20Ikkon%20SPTD%20para%20evento." target="_blank" rel="noopener">Solicitar apresentação</a>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <article class="institucional-map-card h-100" aria-label="Localização da IKKON SPTD no mapa">
                    <div class="institucional-map-header">
                        <span>Localização</span>
                        <strong>IKKON SPTD em São Paulo</strong>
                    </div>
                    <div class="institucional-map-frame">
                        <iframe
                            title="Mapa da IKKON SPTD - Rua Domingos de Morais, 2975, São Paulo"
                            src="https://www.google.com/maps?q=@mapsQuery&output=embed"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            allowfullscreen>
                        </iframe>
                    </div>
                    <a class="institucional-map-link" href="https://www.google.com/maps/search/?api=1&query=@mapsQuery" target="_blank" rel="noopener">
                        Abrir rota no Google Maps
                    </a>
                </article>
            </div>
        </div>
    </div>
</section>
