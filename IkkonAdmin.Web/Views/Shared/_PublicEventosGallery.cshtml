<div class="institucional-eventos-media-wrap">
    <div class="institucional-eventos-media-card" id="eventosGaleria" aria-live="polite" aria-label="@I18n["Galeria de apresentações da IKKON SPTD", "IKKON SPTD performance gallery", "IKKON SPTD公演ギャラリー"]">
        <img class="institucional-eventos-photo is-active" src="~/design-ikkon/photos/galeria-1.webp" asp-append-version="true" alt="@I18n["Apresentação de taiko em evento cultural", "Taiko performance at a cultural event", "文化イベントでの和太鼓公演"]" loading="lazy" aria-hidden="false" />
        <img class="institucional-eventos-photo" src="~/design-ikkon/photos/galeria-2.webp" asp-append-version="true" alt="@I18n["Performance de percussão japonesa no palco", "Japanese percussion performance on stage", "舞台での日本の打楽器パフォーマンス"]" loading="lazy" aria-hidden="true" />
        <img class="institucional-eventos-photo" src="~/design-ikkon/photos/galeria-3.webp" asp-append-version="true" alt="@I18n["Grupo em apresentação com tambores japoneses", "Group performance with Japanese drums", "日本の太鼓で演奏するグループ"]" loading="lazy" aria-hidden="true" />
    </div>
    <div class="institucional-eventos-dots" role="tablist" aria-label="@I18n["Selecionar foto da galeria de eventos", "Select event gallery photo", "イベントギャラリーの写真を選択"]">
        <button type="button" class="institucional-evento-dot is-active" data-index="0" role="tab" aria-label="@I18n["Exibir foto 1", "Show photo 1", "写真1を表示"]" aria-selected="true"></button>
        <button type="button" class="institucional-evento-dot" data-index="1" role="tab" aria-label="@I18n["Exibir foto 2", "Show photo 2", "写真2を表示"]" aria-selected="false" tabindex="-1"></button>
        <button type="button" class="institucional-evento-dot" data-index="2" role="tab" aria-label="@I18n["Exibir foto 3", "Show photo 3", "写真3を表示"]" aria-selected="false" tabindex="-1"></button>
    </div>
</div>
