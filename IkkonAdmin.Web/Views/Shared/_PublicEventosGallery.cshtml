<div class="institucional-eventos-media-wrap">
    <div class="institucional-eventos-media-card" id="eventosGaleria" aria-live="polite" aria-label="Galeria de apresentações da IKKON SPTD">
        <img class="institucional-eventos-photo is-active" src="~/Images/Apresentação3.jpg" asp-append-version="true" alt="Apresentação de taiko em evento cultural" loading="lazy" aria-hidden="false" />
        <img class="institucional-eventos-photo" src="~/Images/FotoAlunos.jpg" asp-append-version="true" alt="Performance de percussão japonesa no palco" loading="lazy" aria-hidden="true" />
        <img class="institucional-eventos-photo" src="~/Images/Alunos2.jfif" asp-append-version="true" alt="Grupo em apresentação com tambores japoneses" loading="lazy" aria-hidden="true" />
    </div>
    <div class="institucional-eventos-dots" role="tablist" aria-label="Selecionar foto da galeria de eventos">
        <button type="button" class="institucional-evento-dot is-active" data-index="0" role="tab" aria-label="Exibir foto 1" aria-selected="true"></button>
        <button type="button" class="institucional-evento-dot" data-index="1" role="tab" aria-label="Exibir foto 2" aria-selected="false" tabindex="-1"></button>
        <button type="button" class="institucional-evento-dot" data-index="2" role="tab" aria-label="Exibir foto 3" aria-selected="false" tabindex="-1"></button>
    </div>
</div>
