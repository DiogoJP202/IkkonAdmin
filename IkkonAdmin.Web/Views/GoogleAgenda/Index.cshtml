@using IkkonAdmin.Web.Security
@using IkkonAdmin.Web.Helpers
@model GoogleAgendaIndexViewModel
@{
    ViewData["Title"] = "Google Agenda";
    var canCreate = User.HasAnyPermission(AppPermissions.GoogleAgendaCreate, AppPermissions.GoogleAgendaManage);
    var canEdit = User.HasAnyPermission(AppPermissions.GoogleAgendaEdit, AppPermissions.GoogleAgendaManage);
    var canDelete = User.HasAnyPermission(AppPermissions.GoogleAgendaDelete, AppPermissions.GoogleAgendaManage);
    var canManage = User.HasPermission(AppPermissions.GoogleAgendaManage);

    var agora = DateTime.Now;
    var limiteProximosDias = agora.AddDays(7);
    var totalEventos = Model.Eventos.Count;
    var proximosSeteDias = Model.Eventos.Count(x => x.Inicio >= agora && x.Inicio <= limiteProximosDias);
    var aulasEnsaios = Model.Eventos.Count(x => x.Tipo is GoogleAgendaTipoEventoEnum.Aula or GoogleAgendaTipoEventoEnum.Ensaio);
    var eventosExternos = Model.Eventos.Count(x => x.Tipo is GoogleAgendaTipoEventoEnum.Apresentacao or GoogleAgendaTipoEventoEnum.EventoCultural);
    var visualizacaoCalendario = Model.Filtro.Visualizacao == GoogleAgendaVisualizacaoEnum.CalendarioAnual;
    var culturaPtBr = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var eventosAno = Model.Eventos
        .Where(x => x.Inicio.Year == Model.Filtro.Ano)
        .OrderBy(x => x.Inicio)
        .ToList();
    var eventosPorMes = eventosAno
        .GroupBy(x => x.Inicio.Month)
        .ToDictionary(x => x.Key, x => x.OrderBy(e => e.Inicio).ToList());
    var diasComEvento = eventosAno.Select(x => x.Inicio.Date).Distinct().Count();
    var quantidadeMesMaisMovimentado = eventosPorMes.Count == 0 ? 0 : eventosPorMes.Max(x => x.Value.Count);
}

@functions {
    private static string TipoLabel(GoogleAgendaTipoEventoEnum tipo)
    {
        return tipo switch
        {
            GoogleAgendaTipoEventoEnum.Apresentacao => "Apresentação",
            GoogleAgendaTipoEventoEnum.EventoCultural => "Evento cultural",
            GoogleAgendaTipoEventoEnum.Reuniao => "Reunião",
            _ => tipo.ToString()
        };
    }

    private static string TipoClass(GoogleAgendaTipoEventoEnum tipo)
    {
        return tipo switch
        {
            GoogleAgendaTipoEventoEnum.Aula => "aula",
            GoogleAgendaTipoEventoEnum.Ensaio => "ensaio",
            GoogleAgendaTipoEventoEnum.Apresentacao => "apresentacao",
            GoogleAgendaTipoEventoEnum.EventoCultural => "evento-cultural",
            GoogleAgendaTipoEventoEnum.Reuniao => "reuniao",
            _ => "outro"
        };
    }

    private static string StatusLabel(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "Confirmado",
            "tentative" => "Tentativo",
            "cancelled" => "Cancelado",
            _ => string.IsNullOrWhiteSpace(status) ? "Sem status" : status
        };
    }

    private static string StatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "confirmed" => "confirmed",
            "tentative" => "tentative",
            "cancelled" => "cancelled",
            _ => "default"
        };
    }

    private static string FormatarDuracao(DateTime inicio, DateTime fim)
    {
        var duracao = fim - inicio;
        if (duracao.TotalMinutes <= 0)
        {
            return "Duração não informada";
        }

        if (duracao.TotalHours >= 24)
        {
            return $"{Math.Round(duracao.TotalDays, 1)} dia(s)";
        }

        var horas = (int)duracao.TotalHours;
        var minutos = duracao.Minutes;
        return horas == 0 ? $"{minutos} min" : $"{horas}h{minutos:00}";
    }
}

<div class="agenda-page agenda-dashboard">
    <section class="agenda-hero-panel mb-4">
        <div class="agenda-hero-content">
            <span class="agenda-eyebrow">Google Agenda</span>
            <h1>Agenda operacional do IKKON</h1>
            <p>Centralize aulas, ensaios, apresentações, reuniões e eventos culturais em uma visão rápida para a equipe.</p>
            <div class="agenda-hero-meta">
                <span class="agenda-connection-pill @(Model.OAuthConectado ? "is-connected" : "is-disconnected")">
                    @(Model.OAuthConectado ? "Google conectado" : "Google não conectado")
                </span>
                <span>Calendário: @(Model.CalendarId ?? "não configurado")</span>
                <span>@Model.Filtro.Inicio.ToString("dd/MM/yyyy") até @Model.Filtro.Fim.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
        <div class="agenda-hero-actions">
            @if (canManage)
            {
                if (Model.OAuthConectado)
                {
                    <form asp-action="Disconnect" method="post" onsubmit="return confirm('Remover conexão OAuth com Google Agenda?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn agenda-btn agenda-btn-ghost">Desconectar Google</button>
                    </form>
                }
                else
                {
                    <a asp-action="Connect" class="btn agenda-btn agenda-btn-outline">Conectar Google Agenda</a>
                }
            }
            @if (canCreate)
            {
                <a asp-action="Create" class="btn agenda-btn agenda-btn-primary">Novo evento</a>
            }
        </div>
    </section>

    @if (Model.ConfiguracaoPendente)
    {
        <div class="agenda-config-alert mb-4">
            <strong>Integração pendente</strong>
            <span>@Model.MensagemConfiguracao</span>
        </div>
    }

    <section class="agenda-kpi-grid mb-4">
        <article class="agenda-kpi-card">
            <span>Total no período</span>
            <strong>@totalEventos</strong>
            <small>Eventos retornados nos filtros</small>
        </article>
        <article class="agenda-kpi-card agenda-kpi-accent">
            <span>Próximos 7 dias</span>
            <strong>@proximosSeteDias</strong>
            <small>Demandam atenção imediata</small>
        </article>
        <article class="agenda-kpi-card">
            <span>Aulas e ensaios</span>
            <strong>@aulasEnsaios</strong>
            <small>Rotina pedagógica e prática</small>
        </article>
        <article class="agenda-kpi-card">
            <span>Eventos externos</span>
            <strong>@eventosExternos</strong>
            <small>Apresentações e cultura</small>
        </article>
    </section>

    <section class="agenda-view-shell mb-4">
        <div class="agenda-view-tabs" role="tablist" aria-label="Modo de visualização da agenda">
            <a asp-action="Index"
               asp-route-Visualizacao="@((int)GoogleAgendaVisualizacaoEnum.Lista)"
               asp-route-Inicio="@Model.Filtro.Inicio.ToString("yyyy-MM-dd")"
               asp-route-Fim="@Model.Filtro.Fim.ToString("yyyy-MM-dd")"
               asp-route-Tipo="@(Model.Filtro.Tipo?.ToString())"
               class="agenda-view-tab @(visualizacaoCalendario ? string.Empty : "is-active")">
                <span>Lista</span>
                <small>Operação detalhada</small>
            </a>
            <a asp-action="Index"
               asp-route-Visualizacao="@((int)GoogleAgendaVisualizacaoEnum.CalendarioAnual)"
               asp-route-Ano="@Model.Filtro.Ano"
               asp-route-Tipo="@(Model.Filtro.Tipo?.ToString())"
               class="agenda-view-tab @(visualizacaoCalendario ? "is-active" : string.Empty)">
                <span>Calendário anual</span>
                <small>Visão horizontal do ano</small>
            </a>
        </div>
    </section>

    <section class="agenda-filter-card mb-4">
        <div class="agenda-card-heading">
            <div>
                <h2>Filtros da agenda</h2>
                <p>@(visualizacaoCalendario ? "Selecione o ano e o tipo para montar a visão anual." : "Defina período e tipo de evento para reduzir ruído operacional.")</p>
            </div>
            <a asp-action="Index" asp-route-Visualizacao="@(visualizacaoCalendario ? (int)GoogleAgendaVisualizacaoEnum.CalendarioAnual : (int)GoogleAgendaVisualizacaoEnum.Lista)" class="btn agenda-btn agenda-btn-ghost">Limpar filtros</a>
        </div>

        @if (visualizacaoCalendario)
        {
            <form asp-action="Index" method="get" class="agenda-filter-grid agenda-filter-grid-year">
                <input type="hidden" name="Visualizacao" value="@((int)GoogleAgendaVisualizacaoEnum.CalendarioAnual)" />
                <div class="agenda-field">
                    <label for="agendaAnoFiltro">Ano</label>
                    <input id="agendaAnoFiltro" name="Ano" value="@Model.Filtro.Ano" type="number" min="2000" max="2100" class="form-control agenda-control" placeholder="Ex.: @DateTime.Today.Year" />
                </div>
                <div class="agenda-field">
                    <label for="agendaTipoFiltroCalendario">Tipo de evento</label>
                    <select id="agendaTipoFiltroCalendario" name="Tipo" class="form-select agenda-control">
                        <option value="">Todos os tipos</option>
                        @foreach (var tipo in Enum.GetValues<GoogleAgendaTipoEventoEnum>())
                        {
                            <option value="@tipo" selected="@(Model.Filtro.Tipo == tipo ? "selected" : null)">@TipoLabel(tipo)</option>
                        }
                    </select>
                </div>
                <div class="agenda-filter-actions">
                    <button type="submit" class="btn agenda-btn agenda-btn-primary">Atualizar calendário</button>
                </div>
            </form>
        }
        else
        {
            <form asp-action="Index" method="get" class="agenda-filter-grid">
                <input type="hidden" name="Visualizacao" value="@((int)GoogleAgendaVisualizacaoEnum.Lista)" />
                <input type="hidden" name="Ano" value="@Model.Filtro.Ano" />
                <div class="agenda-field">
                    <label for="agendaInicioFiltro">Data inicial</label>
                    <input id="agendaInicioFiltro" name="Inicio" value="@Model.Filtro.Inicio.ToString("yyyy-MM-dd")" type="date" class="form-control agenda-control" aria-label="Data inicial do filtro" />
                </div>
                <div class="agenda-field">
                    <label for="agendaFimFiltro">Data final</label>
                    <input id="agendaFimFiltro" name="Fim" value="@Model.Filtro.Fim.ToString("yyyy-MM-dd")" type="date" class="form-control agenda-control" aria-label="Data final do filtro" />
                </div>
                <div class="agenda-field">
                    <label for="agendaTipoFiltroLista">Tipo de evento</label>
                    <select id="agendaTipoFiltroLista" name="Tipo" class="form-select agenda-control">
                        <option value="">Todos os tipos</option>
                        @foreach (var tipo in Enum.GetValues<GoogleAgendaTipoEventoEnum>())
                        {
                            <option value="@tipo" selected="@(Model.Filtro.Tipo == tipo ? "selected" : null)">@TipoLabel(tipo)</option>
                        }
                    </select>
                </div>
                <div class="agenda-filter-actions">
                    <button type="submit" class="btn agenda-btn agenda-btn-primary">Aplicar filtros</button>
                </div>
            </form>
        }
    </section>

    @if (visualizacaoCalendario)
    {
        <section class="agenda-year-card">
            <div class="agenda-card-heading agenda-year-heading">
                <div>
                    <span class="agenda-eyebrow">Calendário horizontal</span>
                    <h2>@Model.Filtro.Ano em perspectiva</h2>
                    <p>Arraste horizontalmente para navegar pelos meses e identificar concentração de aulas, ensaios e apresentações.</p>
                </div>
                <div class="agenda-year-summary">
                    <span><strong>@eventosAno.Count</strong> eventos no ano</span>
                    <span><strong>@diasComEvento</strong> dias com agenda</span>
                    <span><strong>@quantidadeMesMaisMovimentado</strong> no mês mais cheio</span>
                </div>
            </div>

            @if (eventosAno.Count == 0)
            {
                <div class="agenda-empty-state">
                    <div class="agenda-empty-mark">AN</div>
                    <h3>Nenhum evento encontrado para @Model.Filtro.Ano</h3>
                    <p>@(Model.ConfiguracaoPendente ? "Finalize a conexão com o Google Agenda para carregar eventos." : "Tente outro ano, remova o filtro de tipo ou crie novos eventos.")</p>
                    @if (canCreate)
                    {
                        <a asp-action="Create" class="btn agenda-btn agenda-btn-primary">Criar evento</a>
                    }
                </div>
            }
            else
            {
                <div class="agenda-year-legend" aria-label="Legenda dos tipos de evento">
                    @foreach (var tipo in Enum.GetValues<GoogleAgendaTipoEventoEnum>())
                    {
                        <span><i class="agenda-year-dot agenda-year-dot-@TipoClass(tipo)"></i>@TipoLabel(tipo)</span>
                    }
                </div>

                <div class="agenda-linear-scroll" tabindex="0" aria-label="Calendário linear anual com rolagem horizontal">
                    <div class="agenda-linear-board">
                        <div class="agenda-linear-header" aria-hidden="true">
                            <span class="agenda-linear-month-title">Mês</span>
                            <div class="agenda-linear-days">
                                @for (var dia = 1; dia <= 31; dia++)
                                {
                                    <span>@dia.ToString("00")</span>
                                }
                            </div>
                            <span class="agenda-linear-month-title agenda-linear-month-title-end">Ações</span>
                        </div>

                        @for (var mes = 1; mes <= 12; mes++)
                        {
                            var inicioMes = new DateTime(Model.Filtro.Ano, mes, 1);
                            var diasNoMes = DateTime.DaysInMonth(Model.Filtro.Ano, mes);
                            var eventosMes = eventosPorMes.TryGetValue(mes, out var encontrados) ? encontrados : new List<GoogleAgendaEventoViewModel>();
                            var diasMarcados = eventosMes.GroupBy(x => x.Inicio.Date).ToDictionary(x => x.Key, x => x.ToList());
                            var nomeMes = culturaPtBr.TextInfo.ToTitleCase(inicioMes.ToString("MMMM", culturaPtBr));

                            <article class="agenda-linear-row @(eventosMes.Count > 0 ? "has-events" : string.Empty)">
                                <div class="agenda-linear-month">
                                    <strong>@nomeMes</strong>
                                    <span>@mes.ToString("00") · @eventosMes.Count evento(s)</span>
                                </div>

                                <div class="agenda-linear-days">
                                    @for (var dia = 1; dia <= 31; dia++)
                                    {
                                        if (dia > diasNoMes)
                                        {
                                            <span class="agenda-linear-day is-empty"></span>
                                        }
                                        else
                                        {
                                            var dataDia = new DateTime(Model.Filtro.Ano, mes, dia);
                                            var eventosDia = diasMarcados.TryGetValue(dataDia.Date, out var doDia) ? doDia : new List<GoogleAgendaEventoViewModel>();
                                            var temEvento = eventosDia.Count > 0;
                                            var tipoPrincipal = temEvento ? TipoClass(eventosDia.First().Tipo) : string.Empty;
                                            var classeHoje = dataDia.Date == DateTime.Today ? "is-today" : string.Empty;
                                            var diaSemana = culturaPtBr.TextInfo.ToTitleCase(dataDia.ToString("ddd", culturaPtBr).Replace(".", string.Empty));
                                            var dataOnly = DateOnly.FromDateTime(dataDia);
                                            var holidayName = BrazilHolidayHelper.GetHolidayName(dataOnly);
                                            var isHoliday = !string.IsNullOrWhiteSpace(holidayName);
                                            var isWeekend = dataDia.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                            var classeDiaEspecial = string.Join(" ", new[]
                                            {
                                                classeHoje,
                                                isWeekend ? "is-weekend" : string.Empty,
                                                isHoliday ? "is-holiday" : string.Empty
                                            }.Where(x => !string.IsNullOrWhiteSpace(x)));
                                            var descricaoDiaEspecial = isHoliday
                                                ? $"Feriado: {holidayName}"
                                                : isWeekend
                                                    ? "Fim de semana"
                                                    : string.Empty;
                                            var tooltipDia = string.IsNullOrWhiteSpace(descricaoDiaEspecial)
                                                ? $"{dataDia:dd/MM/yyyy}"
                                                : $"{dataDia:dd/MM/yyyy} · {descricaoDiaEspecial}";

                                            if (temEvento)
                                            {
                                                <div class="agenda-linear-day has-event @classeDiaEspecial agenda-linear-day-@tipoPrincipal"
                                                     tabindex="0"
                                                     role="button"
                                                     title="@tooltipDia"
                                                     aria-haspopup="dialog"
                                                     aria-label="@($"{dataDia:dd/MM/yyyy}: {eventosDia.Count} evento(s). {(string.IsNullOrWhiteSpace(descricaoDiaEspecial) ? string.Empty : descricaoDiaEspecial + ". ")}Clique para escolher um evento.")">
                                                    <span>@dia.ToString("00")</span>
                                                    <small>@diaSemana</small>
                                                    <b>@eventosDia.Count</b>
                                                    <div class="agenda-day-popover" role="dialog" aria-label="@($"Eventos do dia {dataDia:dd/MM/yyyy}")">
                                                        <strong>@dataDia.ToString("dd/MM/yyyy")</strong>
                                                        @if (!string.IsNullOrWhiteSpace(descricaoDiaEspecial))
                                                        {
                                                            <span class="agenda-day-popover-tag @(isHoliday ? "is-holiday" : "is-weekend")">@descricaoDiaEspecial</span>
                                                        }
                                                        <small class="agenda-day-popover-hint">Escolha qual evento deseja abrir</small>
                                                        @foreach (var eventoDia in eventosDia.Take(5))
                                                        {
                                                            <a asp-action="Details"
                                                               asp-route-eventoId="@eventoDia.Id"
                                                               class="agenda-day-popover-event agenda-day-popover-event-@TipoClass(eventoDia.Tipo)">
                                                                <em>@eventoDia.Inicio.ToString("HH:mm")</em>
                                                                <span>
                                                                    <b>@eventoDia.Titulo</b>
                                                                    <small>@TipoLabel(eventoDia.Tipo)@(string.IsNullOrWhiteSpace(eventoDia.Local) ? string.Empty : $" · {eventoDia.Local}")</small>
                                                                </span>
                                                            </a>
                                                        }
                                                        @if (eventosDia.Count > 5)
                                                        {
                                                            <small class="agenda-day-popover-more">+ @(eventosDia.Count - 5) outro(s) evento(s)</small>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="agenda-linear-day @classeDiaEspecial" title="@tooltipDia">
                                                    <span>@dia.ToString("00")</span>
                                                    <small>@diaSemana</small>
                                                </span>
                                            }
                                        }
                                    }
                                </div>

                                <div class="agenda-linear-events agenda-linear-month-actions">
                                    <a asp-action="Index"
                                       asp-route-Visualizacao="@((int)GoogleAgendaVisualizacaoEnum.Lista)"
                                       asp-route-Inicio="@inicioMes.ToString("yyyy-MM-dd")"
                                       asp-route-Fim="@(new DateTime(Model.Filtro.Ano, mes, diasNoMes).ToString("yyyy-MM-dd"))"
                                       asp-route-Tipo="@(Model.Filtro.Tipo?.ToString())"
                                       class="agenda-linear-month-action @(eventosMes.Count == 0 ? "is-empty" : string.Empty)"
                                       aria-label="@($"Abrir eventos de {nomeMes}")">
                                        <span>Eventos de @nomeMes</span>
                                        <strong>@eventosMes.Count evento(s)</strong>
                                        <small>@(eventosMes.Count == 0 ? "Ver mês na lista" : "Abrir lista do mês")</small>
                                    </a>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        </section>
    }
    else
    {
        <section class="agenda-list-card">
            <div class="agenda-card-heading">
                <div>
                    <h2>Eventos no período</h2>
                    <p>@totalEventos evento(s) encontrado(s). Use as ações por linha para consultar, editar ou excluir.</p>
                </div>
                @if (canCreate)
                {
                    <a asp-action="Create" class="btn agenda-btn agenda-btn-primary">Novo evento</a>
                }
            </div>

            @if (Model.Eventos.Count == 0)
            {
                <div class="agenda-empty-state">
                    <div class="agenda-empty-mark">AG</div>
                    <h3>Nenhum evento encontrado</h3>
                    <p>@(Model.ConfiguracaoPendente ? "Finalize a conexão com o Google Agenda para carregar eventos." : "Tente ampliar o período, remover filtros ou criar um novo evento.")</p>
                    @if (canCreate)
                    {
                        <a asp-action="Create" class="btn agenda-btn agenda-btn-primary">Criar primeiro evento</a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0 agenda-table">
                        <thead>
                            <tr>
                                <th>Evento</th>
                                <th>Tipo</th>
                                <th>Início</th>
                                <th>Fim</th>
                                <th>Local</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evento in Model.Eventos)
                            {
                                <tr>
                                    <td class="agenda-event-cell">
                                        <span class="agenda-event-marker agenda-event-marker-@TipoClass(evento.Tipo)"></span>
                                        <div>
                                            <strong>@evento.Titulo</strong>
                                            <small>@(string.IsNullOrWhiteSpace(evento.Descricao) ? "Sem descrição cadastrada." : evento.Descricao)</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="agenda-type agenda-type-@TipoClass(evento.Tipo)">@TipoLabel(evento.Tipo)</span>
                                    </td>
                                    <td>
                                        <div class="agenda-date-cell">
                                            <strong>@evento.Inicio.ToString("dd/MM")</strong>
                                            <span>@evento.Inicio.ToString("HH:mm")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="agenda-date-cell">
                                            <strong>@evento.Fim.ToString("dd/MM")</strong>
                                            <span>@evento.Fim.ToString("HH:mm") · @FormatarDuracao(evento.Inicio, evento.Fim)</span>
                                        </div>
                                    </td>
                                    <td>@(evento.Local ?? "Sem local")</td>
                                    <td>
                                        <span class="agenda-status agenda-status-@StatusClass(evento.Status)">@StatusLabel(evento.Status)</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="agenda-row-actions">
                                            <a asp-action="Details" asp-route-eventoId="@evento.Id" class="btn agenda-btn agenda-btn-table">Detalhes</a>
                                            @if (canEdit)
                                            {
                                                <a asp-action="Edit" asp-route-eventoId="@evento.Id" class="btn agenda-btn agenda-btn-table">Editar</a>
                                            }
                                            @if (canDelete)
                                            {
                                                <form asp-action="Delete" asp-route-eventoId="@evento.Id" method="post" onsubmit="return confirm('Excluir este evento do Google Agenda?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn agenda-btn agenda-btn-table-danger">Excluir</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
