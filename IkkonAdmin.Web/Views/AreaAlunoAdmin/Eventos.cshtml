@model AreaAlunoEventosAdminViewModel
@{
    ViewData["Title"] = "Eventos dos alunos";
}

<div class="admin-panel-v2-page">
    <section class="admin-panel-v2-hero is-compact mb-4">
        <div class="admin-panel-hero-copy">
            <span class="admin-panel-eyebrow">Area do Aluno</span>
            <h1 class="admin-panel-title">Eventos</h1>
            <p class="admin-panel-subtitle">Cadastre datas importantes vinculadas a todos, uma turma ou um aluno.</p>
        </div>
    </section>

    <section class="admin-panel-card-v2 mb-4">
        <div class="admin-panel-card-header"><h2>Novo evento</h2></div>
        <form asp-action="CriarEvento" method="post" class="admin-panel-form-stack">
            @Html.AntiForgeryToken()
            <div class="admin-panel-form-grid">
                <div class="admin-panel-field admin-panel-field-wide">
                    <label asp-for="NovoEvento.Titulo">Titulo</label>
                    <input asp-for="NovoEvento.Titulo" class="form-control admin-panel-control" maxlength="180" />
                </div>
                <div class="admin-panel-field">
                    <label asp-for="NovoEvento.Tipo">Tipo</label>
                    <select asp-for="NovoEvento.Tipo" asp-items="Html.GetEnumSelectList<EventoAlunoTipoEnum>()" class="form-select admin-panel-control"></select>
                </div>
                <div class="admin-panel-field">
                    <label asp-for="NovoEvento.Inicio">Inicio</label>
                    <input asp-for="NovoEvento.Inicio" type="datetime-local" class="form-control admin-panel-control" />
                </div>
                <div class="admin-panel-field">
                    <label asp-for="NovoEvento.Fim">Fim</label>
                    <input asp-for="NovoEvento.Fim" type="datetime-local" class="form-control admin-panel-control" />
                </div>
                <div class="admin-panel-field">
                    <label asp-for="NovoEvento.Local">Local</label>
                    <input asp-for="NovoEvento.Local" class="form-control admin-panel-control" maxlength="180" />
                </div>
                <div class="admin-panel-field">
                    <label asp-for="NovoEvento.AlvoTipo">Alvo</label>
                    <select asp-for="NovoEvento.AlvoTipo" asp-items="Html.GetEnumSelectList<ComunicadoAlvoTipoEnum>()" class="form-select admin-panel-control"></select>
                </div>
                <div class="admin-panel-field">
                    <label asp-for="NovoEvento.AlunoId">Aluno</label>
                    <select asp-for="NovoEvento.AlunoId" class="form-select admin-panel-control">
                        <option value="">Opcional</option>
                        @foreach (var aluno in Model.Alunos)
                        {
                            <option value="@aluno.Id">@aluno.Nome</option>
                        }
                    </select>
                </div>
                <div class="admin-panel-field">
                    <label asp-for="NovoEvento.TurmaId">Turma</label>
                    <select asp-for="NovoEvento.TurmaId" class="form-select admin-panel-control">
                        <option value="">Opcional</option>
                        @foreach (var turma in Model.Turmas)
                        {
                            <option value="@turma.Id">@turma.Nome</option>
                        }
                    </select>
                </div>
                <div class="admin-panel-field">
                    <label asp-for="NovoEvento.GoogleEventoId">Id Google Agenda</label>
                    <input asp-for="NovoEvento.GoogleEventoId" class="form-control admin-panel-control" maxlength="200" />
                </div>
                <div class="admin-panel-field-full">
                    <label asp-for="NovoEvento.Descricao">Descricao</label>
                    <textarea asp-for="NovoEvento.Descricao" class="form-control admin-panel-control" rows="3" maxlength="2000"></textarea>
                </div>
                <label class="admin-panel-check-card is-form-check"><input asp-for="NovoEvento.Importante" class="form-check-input" /><span>Importante</span></label>
            </div>
            <button class="btn admin-panel-btn admin-panel-btn-primary" type="submit">Cadastrar evento</button>
        </form>
    </section>

    <section class="admin-panel-card-v2">
        <div class="admin-panel-card-header"><h2>Eventos cadastrados</h2></div>
        <div class="table-responsive">
            <table class="table admin-panel-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Evento</th>
                        <th>Data</th>
                        <th>Alvo</th>
                        <th>Local</th>
                        <th>Status</th>
                        <th>Descricao</th>
                        <th class="text-end">Acoes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Eventos.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Nenhum evento cadastrado.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Eventos)
                        {
                            var editFormId = $"evento-edit-{item.Id}";
                            var deleteFormId = $"evento-delete-{item.Id}";
                            <tr>
                                <td>
                                    <input form="@editFormId" name="Titulo" value="@item.Titulo" class="form-control admin-panel-control mb-2" maxlength="180" />
                                    <select form="@editFormId" name="Tipo" class="form-select admin-panel-control">
                                        @foreach (var tipo in Enum.GetValues<EventoAlunoTipoEnum>())
                                        {
                                            <option value="@tipo" selected="@(item.Tipo == tipo)">@tipo</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input form="@editFormId" name="Inicio" type="datetime-local" value="@item.Inicio.ToString("yyyy-MM-ddTHH:mm")" class="form-control admin-panel-control mb-2" />
                                    <input form="@editFormId" name="Fim" type="datetime-local" value="@item.Fim.ToString("yyyy-MM-ddTHH:mm")" class="form-control admin-panel-control" />
                                </td>
                                <td>
                                    <select form="@editFormId" name="AlvoTipo" class="form-select admin-panel-control mb-2">
                                        @foreach (var alvo in Enum.GetValues<ComunicadoAlvoTipoEnum>())
                                        {
                                            <option value="@alvo" selected="@(item.AlvoTipo == alvo)">@alvo</option>
                                        }
                                    </select>
                                    <select form="@editFormId" name="AlunoId" class="form-select admin-panel-control mb-2">
                                        <option value="">Aluno opcional</option>
                                        @foreach (var aluno in Model.Alunos)
                                        {
                                            <option value="@aluno.Id" selected="@(item.AlunoId == aluno.Id)">@aluno.Nome</option>
                                        }
                                    </select>
                                    <select form="@editFormId" name="TurmaId" class="form-select admin-panel-control">
                                        <option value="">Turma opcional</option>
                                        @foreach (var turma in Model.Turmas)
                                        {
                                            <option value="@turma.Id" selected="@(item.TurmaId == turma.Id)">@turma.Nome</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input form="@editFormId" name="Local" value="@item.Local" class="form-control admin-panel-control mb-2" maxlength="180" />
                                    <input form="@editFormId" name="GoogleEventoId" value="@item.GoogleEventoId" class="form-control admin-panel-control" maxlength="200" placeholder="Id Google Agenda" />
                                </td>
                                <td>
                                    <label class="admin-panel-inline-check">
                                        <input form="@editFormId" type="hidden" name="Importante" value="false" />
                                        <input form="@editFormId" name="Importante" value="true" type="checkbox" class="form-check-input" checked="@item.Importante" />
                                        <span>Importante</span>
                                    </label>
                                    <span class="admin-panel-status-pill @(item.Ativo ? "is-success" : "is-muted")">@(item.Ativo ? "Ativo" : "Inativo")</span>
                                </td>
                                <td>
                                    <textarea form="@editFormId" name="Descricao" class="form-control admin-panel-control" rows="4" maxlength="2000">@item.Descricao</textarea>
                                </td>
                                <td>
                                    <div class="admin-panel-row-actions justify-content-end">
                                        <form id="@editFormId" asp-action="AtualizarEvento" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()</form>
                                        <button form="@editFormId" class="btn admin-panel-btn-table is-primary" type="submit">Salvar</button>
                                        <form id="@deleteFormId" asp-action="ExcluirEvento" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()</form>
                                        <button form="@deleteFormId" class="btn admin-panel-btn-table is-danger" type="submit">Excluir</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
