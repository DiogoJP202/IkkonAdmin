@model AreaAlunoConquistasAdminViewModel
@{
    ViewData["Title"] = "Conquistas";
}

<div class="admin-panel-v2-page">
    <section class="admin-panel-v2-hero is-compact mb-4">
        <div class="admin-panel-hero-copy">
            <span class="admin-panel-eyebrow">Área do Aluno</span>
            <h1 class="admin-panel-title">Conquistas</h1>
            <p class="admin-panel-subtitle">Crie insígnias e atribua marcos de evolução aos alunos.</p>
        </div>
        <div class="admin-panel-hero-actions">
            <form asp-action="ProcessarConquistasAgora" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn admin-panel-btn admin-panel-btn-primary">Processar regras agora</button></form>
        </div>
    </section>

    <div class="admin-panel-grid-two mb-4">
        <section class="admin-panel-card-v2">
            <div class="admin-panel-card-header"><h2>Nova insígnia</h2></div>
            <form asp-action="CriarInsignia" method="post" class="admin-panel-form-stack">
                @Html.AntiForgeryToken()
                <div class="admin-panel-form-grid">
                    <div class="admin-panel-field">
                        <label asp-for="NovaInsignia.Nome">Nome</label>
                        <input asp-for="NovaInsignia.Nome" class="form-control admin-panel-control" maxlength="120" />
                    </div>
                    <div class="admin-panel-field">
                        <label asp-for="NovaInsignia.Categoria">Categoria</label>
                        <input asp-for="NovaInsignia.Categoria" class="form-control admin-panel-control" maxlength="80" />
                    </div>
                    <div class="admin-panel-field">
                        <label asp-for="NovaInsignia.Icone">Ícone</label>
                        <input asp-for="NovaInsignia.Icone" class="form-control admin-panel-control" maxlength="80" placeholder="star" />
                    </div>
                    <div class="admin-panel-field">
                        <label asp-for="NovaInsignia.RegraAutomatica">Regra automática</label>
                        <input asp-for="NovaInsignia.RegraAutomatica" class="form-control admin-panel-control" maxlength="120" />
                        <span class="admin-panel-help">FREQUENCIA_PRIMEIRA, FREQUENCIA_TOTAL:n ou TEMPO_ATIVO_MESES:n</span>
                    </div>
                    <div class="admin-panel-field admin-panel-field-full">
                        <label asp-for="NovaInsignia.Descricao">Descrição</label>
                        <textarea asp-for="NovaInsignia.Descricao" class="form-control admin-panel-control" rows="3" maxlength="500"></textarea>
                    </div>
                </div>
                <button class="btn admin-panel-btn admin-panel-btn-primary" type="submit">Criar insígnia</button>
            </form>
        </section>

        <section class="admin-panel-card-v2">
            <div class="admin-panel-card-header"><h2>Atribuir conquista</h2></div>
            <form asp-action="AtribuirInsignia" method="post" class="admin-panel-form-stack">
                @Html.AntiForgeryToken()
                <div class="admin-panel-form-grid">
                    <div class="admin-panel-field">
                        <label asp-for="NovaAtribuicao.AlunoId">Aluno</label>
                        <select asp-for="NovaAtribuicao.AlunoId" class="form-select admin-panel-control">
                            <option value="">Selecione</option>
                            @foreach (var aluno in Model.Alunos)
                            {
                                <option value="@aluno.Id">@aluno.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="admin-panel-field">
                        <label asp-for="NovaAtribuicao.InsigniaId">Insígnia</label>
                        <select asp-for="NovaAtribuicao.InsigniaId" class="form-select admin-panel-control">
                            <option value="">Selecione</option>
                            @foreach (var insignia in Model.Insignias.Where(x => x.Ativa))
                            {
                                <option value="@insignia.Id">@insignia.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="admin-panel-field admin-panel-field-full">
                        <label asp-for="NovaAtribuicao.Observacao">Observação</label>
                        <textarea asp-for="NovaAtribuicao.Observacao" class="form-control admin-panel-control" rows="3" maxlength="500"></textarea>
                    </div>
                </div>
                <button class="btn admin-panel-btn admin-panel-btn-primary" type="submit">Atribuir</button>
            </form>
        </section>
    </div>

    <section class="admin-panel-card-v2 mb-4">
        <div class="admin-panel-card-header"><h2>Insígnias cadastradas</h2></div>
        <div class="table-responsive">
            <table class="table admin-panel-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Categoria</th>
                        <th>Regra</th>
                        <th>Status</th>
                        <th>Descrição</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Insignias.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Nenhuma insígnia cadastrada.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Insignias)
                        {
                            var editFormId = $"insignia-edit-{item.Id}";
                            var deleteFormId = $"insignia-delete-{item.Id}";
                            <tr>
                                <td>
                                    <input form="@editFormId" name="Nome" value="@item.Nome" class="form-control admin-panel-control mb-2" maxlength="120" />
                                    <input form="@editFormId" name="Icone" value="@item.Icone" class="form-control admin-panel-control" maxlength="80" placeholder="Ícone" />
                                </td>
                                <td><input form="@editFormId" name="Categoria" value="@item.Categoria" class="form-control admin-panel-control" maxlength="80" /></td>
                                <td>
                                    <input form="@editFormId" name="RegraAutomatica" value="@item.RegraAutomatica" class="form-control admin-panel-control" maxlength="120" />
                                    @if (!item.RegraAutomaticaValida)
                                    {
                                        <span class="text-danger small">Regra antiga inválida; não será executada.</span>
                                    }
                                </td>
                                <td>
                                    <input form="@editFormId" type="hidden" name="Ativa" value="false" />
                                    <label class="admin-panel-inline-check">
                                        <input form="@editFormId" name="Ativa" value="true" type="checkbox" class="form-check-input" checked="@item.Ativa" />
                                        <span>Ativa</span>
                                    </label>
                                </td>
                                <td><textarea form="@editFormId" name="Descricao" class="form-control admin-panel-control" rows="3" maxlength="500">@item.Descricao</textarea></td>
                                <td>
                                    <div class="admin-panel-row-actions justify-content-end">
                                        <form id="@editFormId" asp-action="AtualizarInsignia" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()</form>
                                        <button form="@editFormId" class="btn admin-panel-btn-table is-primary" type="submit">Salvar</button>
                                        <form id="@deleteFormId" asp-action="ExcluirInsignia" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()</form>
                                        <button form="@deleteFormId" class="btn admin-panel-btn-table is-danger" type="submit">Excluir</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-panel-card-v2 admin-panel-filter-card mb-4">
        <div class="admin-panel-card-header"><div><span class="admin-panel-eyebrow">Filtros</span><h2>Consultar conquistas</h2><p>Refine por aluno, insígnia, categoria, origem ou período.</p></div></div>
        <form method="get" asp-action="Conquistas" class="admin-panel-filter-grid">
            <div class="admin-panel-field"><label for="conq-aluno">Aluno</label><select id="conq-aluno" name="AlunoId" class="form-select admin-panel-control"><option value="">Todos</option>@foreach (var aluno in Model.Alunos) { <option value="@aluno.Id" selected="@(Model.Filtro.AlunoId == aluno.Id)">@aluno.Nome</option> }</select></div>
            <div class="admin-panel-field"><label for="conq-insignia">Insígnia</label><select id="conq-insignia" name="InsigniaId" class="form-select admin-panel-control"><option value="">Todas</option>@foreach (var insignia in Model.Insignias) { <option value="@insignia.Id" selected="@(Model.Filtro.InsigniaId == insignia.Id)">@insignia.Nome</option> }</select></div>
            <div class="admin-panel-field"><label for="conq-categoria">Categoria</label><select id="conq-categoria" name="Categoria" class="form-select admin-panel-control"><option value="">Todas</option>@foreach (var categoria in Model.Categorias) { <option value="@categoria" selected="@(Model.Filtro.Categoria == categoria)">@categoria</option> }</select></div>
            <div class="admin-panel-field"><label for="conq-origem">Origem</label><select id="conq-origem" name="Origem" class="form-select admin-panel-control"><option value="">Todas</option>@foreach (var origem in Enum.GetValues<InsigniaOrigemEnum>()) { <option value="@origem" selected="@(Model.Filtro.Origem == origem)">@origem</option> }</select></div>
            <div class="admin-panel-field"><label for="conq-inicio">De</label><input id="conq-inicio" name="Inicio" type="date" value="@Model.Filtro.Inicio?.ToString("yyyy-MM-dd")" class="form-control admin-panel-control" /></div>
            <div class="admin-panel-field"><label for="conq-fim">Até</label><input id="conq-fim" name="Fim" type="date" value="@Model.Filtro.Fim?.ToString("yyyy-MM-dd")" class="form-control admin-panel-control" /></div>
            <div class="admin-panel-field"><label for="conq-sort">Ordenação</label><select id="conq-sort" name="Sort" class="form-select admin-panel-control"><option value="">Mais recentes</option><option value="data" selected="@(Model.Filtro.Sort == "data")">Mais antigas</option><option value="aluno" selected="@(Model.Filtro.Sort == "aluno")">Aluno</option><option value="insignia" selected="@(Model.Filtro.Sort == "insignia")">Insígnia</option></select></div>
            <div class="admin-panel-field"><label for="conq-page-size">Registros</label><select id="conq-page-size" name="PageSize" class="form-select admin-panel-control">@foreach (var size in new[] { 20, 50, 100 }) { <option value="@size" selected="@(Model.Filtro.PageSize == size)">@size</option> }</select></div>
            <div class="admin-panel-filter-actions"><button type="submit" class="btn admin-panel-btn admin-panel-btn-primary">Aplicar filtros</button><a asp-action="Conquistas" class="btn admin-panel-btn admin-panel-btn-ghost">Limpar</a></div>
        </form>
    </section>

    <section class="admin-panel-card-v2">
        <div class="admin-panel-card-header"><div><h2>Conquistas atribuídas (@Model.Conquistas.TotalCount)</h2><p>Página @Model.Conquistas.Page de @Model.Conquistas.TotalPages</p></div></div>
        <div class="table-responsive">
            <table class="table admin-panel-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Insígnia</th>
                        <th>Origem</th>
                        <th>Data</th>
                        <th>Observação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Conquistas.Count == 0)
                    {
                        <tr><td colspan="6"><div class="admin-panel-empty">@(Model.Filtro.HasActiveFilters ? "Nenhuma conquista corresponde aos filtros." : "Nenhuma conquista atribuída.")</div></td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Conquistas)
                        {
                            var editFormId = $"conquista-edit-{item.Id}";
                            var deleteFormId = $"conquista-delete-{item.Id}";
                            <tr>
                                <td>
                                    <select form="@editFormId" name="AlunoId" class="form-select admin-panel-control">
                                        @foreach (var aluno in Model.Alunos)
                                        {
                                            <option value="@aluno.Id" selected="@(item.AlunoId == aluno.Id)">@aluno.Nome</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select form="@editFormId" name="InsigniaId" class="form-select admin-panel-control">
                                        @foreach (var insignia in Model.Insignias)
                                        {
                                            <option value="@insignia.Id" selected="@(item.InsigniaId == insignia.Id)">@insignia.Nome</option>
                                        }
                                    </select>
                                </td>
                                <td>@item.Origem</td>
                                <td>@item.ConcedidaEmUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td><input form="@editFormId" name="Observacao" value="@item.Observacao" class="form-control admin-panel-control" maxlength="500" /></td>
                                <td>
                                    <div class="admin-panel-row-actions justify-content-end">
                                        <form id="@editFormId" asp-action="AtualizarAlunoInsignia" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()</form>
                                        <button form="@editFormId" class="btn admin-panel-btn-table is-primary" type="submit">Salvar</button>
                                        <form id="@deleteFormId" asp-action="ExcluirAlunoInsignia" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()</form>
                                        <button form="@deleteFormId" class="btn admin-panel-btn-table is-danger" type="submit">Excluir</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" model="Model.Conquistas" />
    </section>
</div>
