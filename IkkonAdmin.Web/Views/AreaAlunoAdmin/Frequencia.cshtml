@model AreaAlunoFrequenciaAdminViewModel
@{
    ViewData["Title"] = "Frequência";
}

<div class="admin-panel-v2-page">
    <section class="admin-panel-v2-hero is-compact mb-4">
        <div class="admin-panel-hero-copy">
            <span class="admin-panel-eyebrow">Área do Aluno</span>
            <h1 class="admin-panel-title">Frequência</h1>
            <p class="admin-panel-subtitle">Escolha uma aula para registrar ou revisar presenças e faltas.</p>
        </div>
        <div class="admin-panel-hero-actions">
            <a asp-action="Aulas" class="btn admin-panel-btn admin-panel-btn-ghost">Aulas</a>
        </div>
    </section>

    <section class="admin-panel-card-v2 admin-panel-filter-card mb-4">
        <div class="admin-panel-card-header">
            <div><span class="admin-panel-eyebrow">Filtros</span><h2>Consultar aulas</h2><p>Refine por período, turma, instrutor ou situação de preenchimento.</p></div>
        </div>
        <form method="get" asp-action="Frequencia" class="admin-panel-filter-grid">
            <div class="admin-panel-field"><label for="freq-inicio">De</label><input id="freq-inicio" name="Inicio" type="date" value="@Model.Filtro.Inicio?.ToString("yyyy-MM-dd")" class="form-control admin-panel-control" /></div>
            <div class="admin-panel-field"><label for="freq-fim">Até</label><input id="freq-fim" name="Fim" type="date" value="@Model.Filtro.Fim?.ToString("yyyy-MM-dd")" class="form-control admin-panel-control" /></div>
            <div class="admin-panel-field"><label for="freq-turma">Turma</label><select id="freq-turma" name="TurmaId" class="form-select admin-panel-control"><option value="">Todas</option>@foreach (var turma in Model.Turmas) { <option value="@turma.Id" selected="@(Model.Filtro.TurmaId == turma.Id)">@turma.Nome</option> }</select></div>
            <div class="admin-panel-field"><label for="freq-instrutor">Instrutor</label><select id="freq-instrutor" name="InstrutorId" class="form-select admin-panel-control"><option value="">Todos</option>@foreach (var instrutor in Model.Instrutores) { <option value="@instrutor.Id" selected="@(Model.Filtro.InstrutorId == instrutor.Id)">@instrutor.Nome</option> }</select></div>
            <div class="admin-panel-field"><label for="freq-preenchida">Situação</label><select id="freq-preenchida" name="Preenchida" class="form-select admin-panel-control"><option value="">Todas</option><option value="true" selected="@(Model.Filtro.Preenchida == true)">Preenchida</option><option value="false" selected="@(Model.Filtro.Preenchida == false)">Pendente</option></select></div>
            <div class="admin-panel-field"><label for="freq-sort">Ordenação</label><select id="freq-sort" name="Sort" class="form-select admin-panel-control"><option value="">Data crescente</option><option value="data-desc" selected="@(Model.Filtro.Sort == "data-desc")">Data decrescente</option><option value="turma" selected="@(Model.Filtro.Sort == "turma")">Turma</option></select></div>
            <div class="admin-panel-field"><label for="freq-page-size">Registros</label><select id="freq-page-size" name="PageSize" class="form-select admin-panel-control">@foreach (var size in new[] { 20, 50, 100 }) { <option value="@size" selected="@(Model.Filtro.PageSize == size)">@size</option> }</select></div>
            <div class="admin-panel-filter-actions"><button type="submit" class="btn admin-panel-btn admin-panel-btn-primary">Aplicar filtros</button><a asp-action="Frequencia" class="btn admin-panel-btn admin-panel-btn-ghost">Limpar</a></div>
        </form>
    </section>

    <section class="admin-panel-card-v2">
        <div class="admin-panel-card-header"><div><span class="admin-panel-eyebrow">Resultado</span><h2>@Model.Aulas.TotalCount aula(s)</h2><p>Página @Model.Aulas.Page de @Model.Aulas.TotalPages</p></div></div>
        <div class="table-responsive">
            <table class="table admin-panel-table align-middle mb-0">
                <thead><tr><th>Aula</th><th>Turma</th><th>Status</th><th>Registros</th><th class="text-end">Ações</th></tr></thead>
                <tbody>
                    @if (Model.Aulas.Count == 0)
                    {
                        <tr><td colspan="5"><div class="admin-panel-empty">@(Model.Filtro.HasActiveFilters ? "Nenhuma aula corresponde aos filtros. Limpe os filtros para ver todos os registros." : "Nenhuma aula cadastrada.")</div></td></tr>
                    }
                    else
                    {
                        @foreach (var aula in Model.Aulas)
                        {
                            <tr>
                                <td>@aula.Inicio.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@aula.Turma</td>
                                <td>@aula.Status</td>
                                <td>@aula.FrequenciasRegistradas/@aula.TotalAlunos</td>
                                <td class="text-end">
                                    <a asp-action="RegistroFrequencia" asp-route-aulaId="@aula.Id" class="btn admin-panel-btn-table is-primary">Registrar</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" model="Model.Aulas" />
    </section>
</div>
