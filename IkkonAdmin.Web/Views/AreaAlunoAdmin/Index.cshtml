@model AreaAlunoAdminDashboardViewModel
@{
    ViewData["Title"] = I18n["Área do Aluno", "Student Area"];
}

<div class="admin-panel-v2-page">
    <section class="admin-panel-v2-hero mb-4">
        <div class="admin-panel-hero-copy">
            <span class="admin-panel-eyebrow">@I18n["Portal do aluno", "Student portal"]</span>
            <h1 class="admin-panel-title">@I18n["Área do Aluno", "Student Area"]</h1>
            <p class="admin-panel-subtitle">@I18n["Central administrativa para aulas, frequência, documentos, comunicados, eventos e conquistas.", "Administrative center for classes, attendance, documents, announcements, events, and achievements."]</p>
        </div>
        <div class="admin-panel-hero-actions">
            <a asp-action="Aulas" class="btn admin-panel-btn admin-panel-btn-primary">@I18n["Aulas", "Classes"]</a>
            <a asp-action="Frequencia" class="btn admin-panel-btn admin-panel-btn-ghost">@I18n["Frequência", "Attendance"]</a>
            <a asp-action="Documentos" class="btn admin-panel-btn admin-panel-btn-ghost">@I18n["Documentos", "Documents"]</a>
        </div>
    </section>

    <section class="admin-panel-kpi-grid mb-4">
        <article class="admin-kpi-card"><span class="admin-kpi-label">@I18n["Aulas próximas", "Upcoming classes"]</span><strong>@Model.AulasProximas</strong></article>
        <article class="admin-kpi-card is-info"><span class="admin-kpi-label">@I18n["Frequências no mês", "Attendance records this month"]</span><strong>@Model.FrequenciasRegistradasMes</strong></article>
        <article class="admin-kpi-card is-warning"><span class="admin-kpi-label">@I18n["Documentos pendentes", "Pending documents"]</span><strong>@Model.DocumentosPendentes</strong></article>
        <article class="admin-kpi-card is-success"><span class="admin-kpi-label">@I18n["Comunicados ativos", "Active announcements"]</span><strong>@Model.ComunicadosAtivos</strong></article>
        <article class="admin-kpi-card"><span class="admin-kpi-label">@I18n["Eventos próximos", "Upcoming events"]</span><strong>@Model.EventosProximos</strong></article>
        <article class="admin-kpi-card is-info"><span class="admin-kpi-label">@I18n["Conquistas no mês", "Achievements this month"]</span><strong>@Model.ConquistasConcedidasMes</strong></article>
    </section>

    <section class="admin-panel-nav mb-4">
        <a asp-action="Aulas" class="admin-panel-nav-link"><strong>@I18n["Aulas e horários", "Classes and schedules"]</strong><small>@I18n["Horários, instrutores e próximas aulas", "Schedules, instructors, and upcoming classes"]</small></a>
        <a asp-action="Frequencia" class="admin-panel-nav-link"><strong>@I18n["Frequência", "Attendance"]</strong><small>@I18n["Registro de presenças e faltas", "Presence and absence records"]</small></a>
        <a asp-action="Documentos" class="admin-panel-nav-link"><strong>@I18n["Documentos", "Documents"]</strong><small>@I18n["Solicitações, uploads e aprovação", "Requests, uploads, and approval"]</small></a>
        <a asp-action="Comunicados" class="admin-panel-nav-link"><strong>@I18n["Comunicados", "Announcements"]</strong><small>@I18n["Avisos por aluno, turma ou todos", "Notices by student, group, or everyone"]</small></a>
        <a asp-action="Eventos" class="admin-panel-nav-link"><strong>@I18n["Eventos", "Events"]</strong><small>@I18n["Datas importantes do portal", "Important portal dates"]</small></a>
        <a asp-action="Conquistas" class="admin-panel-nav-link"><strong>@I18n["Conquistas", "Achievements"]</strong><small>@I18n["Insígnias e marcos", "Badges and milestones"]</small></a>
    </section>

    <div class="admin-panel-grid-two">
        <section class="admin-panel-card-v2">
            <div class="admin-panel-card-header"><h2>@I18n["Próximas aulas", "Upcoming classes"]</h2></div>
            <div class="admin-stat-list">
                @if (Model.ProximasAulas.Count == 0)
                {
                    <div class="admin-panel-empty">@I18n["Nenhuma aula futura cadastrada.", "No upcoming classes registered."]</div>
                }
                else
                {
                    @foreach (var aula in Model.ProximasAulas)
                    {
                        <div class="admin-stat-row">
                            <span>@aula.Turma</span>
                            <strong>@aula.Inicio.ToString("dd/MM HH:mm")</strong>
                        </div>
                    }
                }
            </div>
        </section>

        <section class="admin-panel-card-v2">
            <div class="admin-panel-card-header"><h2>@I18n["Documentos recentes", "Recent documents"]</h2></div>
            <div class="admin-stat-list">
                @if (Model.DocumentosRecentes.Count == 0)
                {
                    <div class="admin-panel-empty">@I18n["Nenhum documento solicitado.", "No requested documents."]</div>
                }
                else
                {
                    @foreach (var documento in Model.DocumentosRecentes)
                    {
                        <div class="admin-stat-row">
                            <span>@documento.Aluno - @documento.Tipo</span>
                            <strong>@I18n.Term(documento.Status)</strong>
                        </div>
                    }
                }
            </div>
        </section>
    </div>
</div>
