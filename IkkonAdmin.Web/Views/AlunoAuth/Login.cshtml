@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar na Área do Aluno";
}

<div class="auth-page">
    <div class="auth-page-bg" aria-hidden="true"></div>
    <div class="container px-3">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-7 col-xl-5">
                <article class="auth-card">
                    <div class="auth-card-head">
                        <img src="~/Images/Ikkon_Icon.png" asp-append-version="true" alt="Logo IKKON" class="auth-logo" />
                        <div>
                            <p class="auth-kicker mb-1">Área do aluno</p>
                            <h1 class="auth-title mb-0">Entrar no portal</h1>
                        </div>
                    </div>

                    <p class="auth-subtitle">
                        Acesse suas informações pessoais, turmas e mensalidades usando sua conta de aluno.
                    </p>

                    <form action="/aluno/login" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input asp-for="ReturnUrl" type="hidden" />
                        <input asp-for="TipoAcesso" type="hidden" value="@TipoAcessoEnum.Aluno" />

                        <div class="mb-3">
                            <label asp-for="LoginOuEmail" class="form-label"></label>
                            <input asp-for="LoginOuEmail" class="form-control auth-input" placeholder="seu.email@dominio.com ou usuario" autocomplete="username" />
                            <span asp-validation-for="LoginOuEmail" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Senha" class="form-label"></label>
                            <input asp-for="Senha" class="form-control auth-input" placeholder="Informe sua senha" autocomplete="current-password" />
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3"></div>

                        <button type="submit" class="btn btn-danger w-100 auth-submit">
                            Entrar na Área do Aluno
                        </button>
                    </form>

                    <div class="auth-footer-links mt-3">
                        <a href="/" class="link-secondary text-decoration-none">Voltar para o site</a>
                        <a href="/auth/login" class="link-secondary text-decoration-none">Login administrativo</a>
                    </div>
                </article>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
