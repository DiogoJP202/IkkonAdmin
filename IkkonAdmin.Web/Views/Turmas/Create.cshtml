@model TurmaFormViewModel
@{
    ViewData["Title"] = "Nova Turma";
}

@functions {
    private static string StatusAlunoTexto(StatusAlunoEnum status)
    {
        return status switch
        {
            StatusAlunoEnum.EmAdmissao => "Em admissão",
            StatusAlunoEnum.Ativo => "Ativo",
            StatusAlunoEnum.Inativo => "Inativo",
            StatusAlunoEnum.Desligado => "Desligado",
            _ => status.ToString()
        };
    }

    private static string StatusAlunoClasse(StatusAlunoEnum status)
    {
        return status switch
        {
            StatusAlunoEnum.Ativo => "is-success",
            StatusAlunoEnum.Inativo => "is-muted",
            StatusAlunoEnum.Desligado => "is-danger",
            _ => "is-warning"
        };
    }
}

<div class="turmas-v2-page">
    <section class="turmas-v2-form-hero mb-4">
        <div>
            <span class="turmas-v2-eyebrow">Nova turma</span>
            <h1>Cadastrar turma</h1>
            <p>
                Defina modalidade, horário e alunos vinculados para organizar a operação da escola. Um aluno pode participar de mais de uma turma ao mesmo tempo.
            </p>
        </div>
        <div class="turmas-v2-hero-actions">
            <a asp-action="Index" class="btn turmas-v2-btn turmas-v2-btn-ghost">Voltar para turmas</a>
        </div>
    </section>

    <div class="turmas-v2-form-layout">
        <section class="turmas-v2-form-panel">
            <form asp-action="Create" method="post" class="turmas-v2-form">
                <div asp-validation-summary="ModelOnly" class="turmas-v2-validation-summary"></div>

                <section class="turmas-v2-form-section">
                    <div class="turmas-v2-section-title">
                        <span>01</span>
                        <div>
                            <h2>Dados da turma</h2>
                            <p>Informações principais usadas em filtros, relatórios e planejamento.</p>
                        </div>
                    </div>

                    <div class="turmas-v2-form-grid">
                        <div class="turmas-v2-field turmas-v2-field-span-2">
                            <label asp-for="Nome">Nome da turma</label>
                            <input asp-for="Nome"
                                   type="text"
                                   class="form-control turmas-v2-control"
                                   placeholder="Ex.: Taiko iniciante - noite"
                                   autocomplete="off"
                                   maxlength="100" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="turmas-v2-field">
                            <label asp-for="Modalidade">Modalidade</label>
                            <input asp-for="Modalidade"
                                   type="text"
                                   class="form-control turmas-v2-control"
                                   placeholder="Ex.: Taiko"
                                   autocomplete="off"
                                   maxlength="80" />
                            <span asp-validation-for="Modalidade" class="text-danger"></span>
                        </div>

                        <div class="turmas-v2-field">
                            <label asp-for="Horario">Horário</label>
                            <input asp-for="Horario"
                                   type="text"
                                   class="form-control turmas-v2-control"
                                   placeholder="Ex.: Seg e Qua - 19h30"
                                   autocomplete="off"
                                   maxlength="100" />
                            <span asp-validation-for="Horario" class="text-danger"></span>
                        </div>

                        <div class="turmas-v2-switch-box">
                            <input asp-for="Ativa" class="form-check-input" />
                            <div>
                                <label asp-for="Ativa" class="form-check-label">Turma ativa</label>
                                <small>Turmas ativas aparecem nos filtros operacionais e alocação de alunos.</small>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="turmas-v2-form-section">
                    <div class="turmas-v2-section-title">
                        <span>02</span>
                        <div>
                            <h2>Observações internas</h2>
                            <p>Use para sala, materiais, regras de coordenação ou recados da equipe.</p>
                        </div>
                    </div>

                    <div class="turmas-v2-field">
                        <label asp-for="Observacoes">Anotações</label>
                        <textarea asp-for="Observacoes"
                                  class="form-control turmas-v2-control"
                                  rows="4"
                                  placeholder="Ex.: usa sala principal, precisa de shime extra, atenção a remanejamentos."></textarea>
                        <span asp-validation-for="Observacoes" class="text-danger"></span>
                    </div>
                </section>

                <section class="turmas-v2-form-section">
                    <div class="turmas-v2-section-title">
                        <span>03</span>
                        <div>
                            <h2>Associar alunos</h2>
                            <p>Selecione os alunos desta turma. O vínculo não impede participação em outras turmas.</p>
                        </div>
                    </div>

                    <div class="turmas-v2-students-toolbar">
                        <div class="turmas-v2-field">
                            <label for="buscaAlunosTurma">Buscar aluno</label>
                            <input type="search"
                                   id="buscaAlunosTurma"
                                   class="form-control turmas-v2-control"
                                   placeholder="Digite o nome do aluno"
                                   autocomplete="off" />
                        </div>
                        <div class="turmas-v2-students-actions">
                            <button type="button" class="btn turmas-v2-btn turmas-v2-btn-ghost" data-select-visible>Selecionar visíveis</button>
                            <button type="button" class="btn turmas-v2-btn turmas-v2-btn-ghost" data-clear-visible>Limpar visíveis</button>
                        </div>
                    </div>

                    <div class="turmas-v2-students-summary">
                        <span><strong id="alunosSelecionadosCount">@Model.AlunosIds.Count</strong> selecionado(s)</span>
                        <span>@Model.AlunosDisponiveis.Count aluno(s) disponível(is)</span>
                    </div>

                    <div class="turmas-v2-students-box" id="listaAlunosTurma">
                        @if (Model.AlunosDisponiveis.Count == 0)
                        {
                            <div class="turmas-v2-empty-state turmas-v2-empty-compact">
                                <strong>Nenhum aluno disponível.</strong>
                                <span>Cadastre alunos ou revise os filtros operacionais antes de montar a turma.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var aluno in Model.AlunosDisponiveis)
                            {
                                var selecionado = Model.AlunosIds.Contains(aluno.Id);
                                <label class="turmas-v2-student-option" data-nome="@aluno.NomeCompleto.ToLowerInvariant()">
                                    @if (selecionado)
                                    {
                                        <input type="checkbox" name="AlunosIds" value="@aluno.Id" checked />
                                    }
                                    else
                                    {
                                        <input type="checkbox" name="AlunosIds" value="@aluno.Id" />
                                    }
                                    <span class="turmas-v2-student-option-body">
                                        <strong>@aluno.NomeCompleto</strong>
                                        <small>
                                            <span class="turmas-v2-status-pill @StatusAlunoClasse(aluno.Status)">@StatusAlunoTexto(aluno.Status)</span>
                                            @if (!string.IsNullOrWhiteSpace(aluno.TurmaAtual))
                                            {
                                                <span>Atual: @aluno.TurmaAtual</span>
                                            }
                                            else
                                            {
                                                <span>Sem turma vinculada</span>
                                            }
                                        </small>
                                    </span>
                                </label>
                            }
                        }
                    </div>
                </section>

                <div class="turmas-v2-form-actions">
                    <a asp-action="Index" class="btn turmas-v2-btn turmas-v2-btn-ghost">Cancelar</a>
                    <button class="btn turmas-v2-btn turmas-v2-btn-primary" type="submit">Salvar turma</button>
                </div>
            </form>
        </section>

        <aside class="turmas-v2-assist-card">
            <span class="turmas-v2-eyebrow">Boas práticas</span>
            <h2>Organização da turma</h2>
            <ul>
                <li>Use nomes consistentes para facilitar busca e leitura rápida no painel.</li>
                <li>Padronize horários, por exemplo: “Seg e Qua - 19h30”.</li>
                <li>Revise a modalidade antes de vincular alunos para evitar confusão operacional.</li>
                <li>Alunos podem ficar em múltiplas turmas; use isso para Taiko, Fue, Ensemble ou reposições.</li>
            </ul>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const inputBusca = document.getElementById("buscaAlunosTurma");
            const lista = document.getElementById("listaAlunosTurma");
            const contador = document.getElementById("alunosSelecionadosCount");
            const selecionarVisiveis = document.querySelector("[data-select-visible]");
            const limparVisiveis = document.querySelector("[data-clear-visible]");

            if (!lista) return;

            const itens = Array.from(lista.querySelectorAll(".turmas-v2-student-option"));
            const atualizarContador = function () {
                if (!contador) return;
                contador.textContent = lista.querySelectorAll("input[type='checkbox']:checked").length.toString();
            };

            const filtrar = function () {
                const termo = ((inputBusca && inputBusca.value) || "").toLowerCase().trim();
                itens.forEach(function (item) {
                    const nome = item.getAttribute("data-nome") || "";
                    item.hidden = termo !== "" && !nome.includes(termo);
                });
            };

            inputBusca && inputBusca.addEventListener("input", filtrar);
            lista.addEventListener("change", atualizarContador);

            selecionarVisiveis && selecionarVisiveis.addEventListener("click", function () {
                itens.filter(function (item) { return !item.hidden; })
                    .forEach(function (item) {
                        const checkbox = item.querySelector("input[type='checkbox']");
                        if (checkbox) checkbox.checked = true;
                    });
                atualizarContador();
            });

            limparVisiveis && limparVisiveis.addEventListener("click", function () {
                itens.filter(function (item) { return !item.hidden; })
                    .forEach(function (item) {
                        const checkbox = item.querySelector("input[type='checkbox']");
                        if (checkbox) checkbox.checked = false;
                    });
                atualizarContador();
            });

            atualizarContador();
        })();
    </script>
}
