@model AdminLogsIndexViewModel
@{
    ViewData["Title"] = "Logs e Auditoria";
    var totalPaginas = (int)Math.Ceiling(Model.TotalRegistros / (double)Model.TamanhoPagina);
    totalPaginas = Math.Max(1, totalPaginas);
}

<div class="admin-panel-page admin-panel-v2-page">
    <section class="admin-panel-hero admin-panel-v2-hero is-compact">
        <div class="admin-panel-hero-copy">
            <span class="admin-panel-eyebrow">Rastreabilidade</span>
            <h1 class="admin-panel-title">Logs e auditoria</h1>
            <p class="admin-panel-subtitle">Acompanhe ações administrativas, alterações de usuários, cargos, permissões e eventos sensíveis.</p>
        </div>
    </section>

    <partial name="_AdminNav" />

    <section class="admin-panel-card admin-panel-card-v2 admin-panel-filter-card">
        <div class="admin-panel-card-header">
            <div>
                <span class="admin-panel-eyebrow">Filtros</span>
                <h2>Consultar eventos</h2>
                <p>Use busca textual e responsável para investigar ações específicas.</p>
            </div>
        </div>
        <form method="get" asp-action="Logs" class="admin-panel-filter-grid">
            <div class="admin-panel-field admin-panel-field-wide">
                <label for="busca">Busca</label>
                <input class="form-control admin-panel-control" type="search" id="busca" name="busca" value="@Model.Busca" placeholder="Ação, entidade ou descrição" />
            </div>
            <div class="admin-panel-field admin-panel-field-wide">
                <label for="usuarioResponsavelId">Responsável</label>
                <select class="form-select admin-panel-control" id="usuarioResponsavelId" name="usuarioResponsavelId">
                    @if (!Model.UsuarioResponsavelId.HasValue) { <option value="" selected>Todos</option> } else { <option value="">Todos</option> }
                    @foreach (var responsavel in Model.Responsaveis)
                    {
                        if (Model.UsuarioResponsavelId == responsavel.Id)
                        {
                            <option value="@responsavel.Id" selected>@responsavel.Nome</option>
                        }
                        else
                        {
                            <option value="@responsavel.Id">@responsavel.Nome</option>
                        }
                    }
                </select>
            </div>
            <div class="admin-panel-field">
                <label for="tamanhoPagina">Registros</label>
                <select class="form-select admin-panel-control" id="tamanhoPagina" name="tamanhoPagina">
                    @if (Model.TamanhoPagina == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                    @if (Model.TamanhoPagina == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                    @if (Model.TamanhoPagina == 30) { <option value="30" selected>30</option> } else { <option value="30">30</option> }
                </select>
            </div>
            <div class="admin-panel-filter-actions">
                <button type="submit" class="btn admin-panel-btn admin-panel-btn-primary">Aplicar filtros</button>
                <a href="/admin/painel/Logs" class="btn admin-panel-btn admin-panel-btn-ghost">Limpar</a>
            </div>
        </form>
    </section>

    <section class="admin-panel-card admin-panel-card-v2">
        <div class="admin-panel-card-header">
            <div>
                <span class="admin-panel-eyebrow">Resultado</span>
                <h2>Eventos registrados (@Model.TotalRegistros)</h2>
                <p>Página @Model.PaginaAtual de @totalPaginas</p>
            </div>
        </div>
        <div class="table-responsive admin-panel-table-wrap">
            <table class="table admin-panel-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Data/Hora</th>
                        <th>Ação</th>
                        <th>Entidade</th>
                        <th>Responsável</th>
                        <th>Afetado</th>
                        <th>Descrição</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Logs.Count == 0)
                {
                    <tr><td colspan="6"><div class="admin-panel-empty">Nenhum log encontrado.</div></td></tr>
                }
                else
                {
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td><strong>@log.DataEventoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</strong></td>
                            <td><span class="admin-panel-badge is-neutral">@log.Acao</span></td>
                            <td>@log.Entidade @(string.IsNullOrWhiteSpace(log.EntidadeId) ? string.Empty : $"#{log.EntidadeId}")</td>
                            <td>@(log.ResponsavelNome ?? "-")</td>
                            <td>@(log.AfetadoNome ?? "-")</td>
                            <td>@(log.Descricao ?? "-")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        @if (totalPaginas > 1)
        {
            <div class="admin-panel-card-footer">
                <nav aria-label="Paginação de logs">
                    <ul class="pagination pagination-sm admin-panel-pagination mb-0">
                        <li class="page-item @(Model.PaginaAtual <= 1 ? "disabled" : null)">
                            <a class="page-link" asp-action="Logs" asp-route-busca="@Model.Busca" asp-route-usuarioResponsavelId="@Model.UsuarioResponsavelId" asp-route-tamanhoPagina="@Model.TamanhoPagina" asp-route-pagina="@(Model.PaginaAtual - 1)">Anterior</a>
                        </li>
                        @for (var p = 1; p <= totalPaginas; p++)
                        {
                            <li class="page-item @(p == Model.PaginaAtual ? "active" : null)">
                                <a class="page-link" asp-action="Logs" asp-route-busca="@Model.Busca" asp-route-usuarioResponsavelId="@Model.UsuarioResponsavelId" asp-route-tamanhoPagina="@Model.TamanhoPagina" asp-route-pagina="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginaAtual >= totalPaginas ? "disabled" : null)">
                            <a class="page-link" asp-action="Logs" asp-route-busca="@Model.Busca" asp-route-usuarioResponsavelId="@Model.UsuarioResponsavelId" asp-route-tamanhoPagina="@Model.TamanhoPagina" asp-route-pagina="@(Model.PaginaAtual + 1)">Próxima</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>
</div>
