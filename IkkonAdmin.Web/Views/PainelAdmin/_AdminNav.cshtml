@using IkkonAdmin.Web.Security
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    var isVisaoGeral = action == "Index";
    var isUsuarios = action is "Usuarios" or "NovoUsuario" or "EditarUsuario" or "Acessos";
    var isCargos = action is "Cargos" or "NovoCargo" or "EditarCargo";
    var isLogs = action == "Logs";
    var isSistema = action == "Sistema";

    var canVisualizar = User.HasPermission(AppPermissions.VisualizarDados);
    var canUsuarios = User.HasPermission(AppPermissions.GerenciarUsuarios);
    var canCargos = User.HasPermission(AppPermissions.GerenciarCargos);
    var canLogs = User.HasPermission(AppPermissions.GerenciarSistema);
    var canSistema = User.HasPermission(AppPermissions.GerenciarSistema);
}

<nav class="admin-panel-nav" aria-label="Navegação do painel administrativo">
    @if (canVisualizar)
    {
        <a class="admin-panel-nav-link @(isVisaoGeral ? "is-active" : null)" href="/admin/painel">
            <strong>Visão geral</strong>
            <small>Indicadores e atalhos</small>
        </a>
    }
    @if (canUsuarios)
    {
        <a class="admin-panel-nav-link @(isUsuarios ? "is-active" : null)" href="/admin/painel/Usuarios">
            <strong>Usuários</strong>
            <small>Contas e status</small>
        </a>
    }
    @if (canCargos)
    {
        <a class="admin-panel-nav-link @(isCargos ? "is-active" : null)" href="/admin/painel/Cargos">
            <strong>Cargos</strong>
            <small>Perfis e permissões</small>
        </a>
    }
    @if (canLogs)
    {
        <a class="admin-panel-nav-link @(isLogs ? "is-active" : null)" href="/admin/painel/Logs">
            <strong>Logs</strong>
            <small>Auditoria</small>
        </a>
    }
    @if (canSistema)
    {
        <a class="admin-panel-nav-link @(isSistema ? "is-active" : null)" href="/admin/painel/Sistema">
            <strong>Sistema</strong>
            <small>Parâmetros globais</small>
        </a>
    }
</nav>
