@model AdminAcessosViewModel
@{
    ViewData["Title"] = "Permissoes e Acessos";
}

<div class="admin-panel-page d-grid gap-3">
    <partial name="_AdminNav" />

    <section class="card admin-panel-card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h2 class="h6 mb-0">Permissoes do usuario</h2>
                <small class="text-muted">@Model.NomeUsuario - @Model.EmailUsuario</small>
            </div>
            <a href="/admin/painel/Usuarios" class="btn btn-sm btn-outline-secondary">Voltar</a>
        </div>
        <div class="card-body">
            <form asp-action="Acessos" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UsuarioId" value="@Model.UsuarioId" />

                <div class="col-12 col-lg-4">
                    <label class="form-label" for="RoleId">Cargo principal</label>
                    <select class="form-select" id="RoleId" name="RoleId" required>
                        @foreach (var role in Model.RolesDisponiveis)
                        {
                            if (role.Id == Model.RoleSelecionadaId)
                            {
                                <option value="@role.Id" selected>@role.Nome (@role.Codigo) - @role.TipoAcesso</option>
                            }
                            else
                            {
                                <option value="@role.Id">@role.Nome (@role.Codigo) - @role.TipoAcesso</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-12">
                    <h3 class="h6 mb-2">Permissoes diretas</h3>
                    <p class="text-muted small mb-3">Permissoes herdadas pelo cargo aparecem destacadas. As diretas ampliam o acesso individual.</p>

                    @foreach (var grupo in Model.PermissoesDisponiveis.GroupBy(x => x.Modulo).OrderBy(x => x.Key))
                    {
                        <div class="mb-3">
                            <h4 class="h6 mb-2">@grupo.Key</h4>
                            <div class="row g-2">
                                @foreach (var permissao in grupo)
                                {
                                    var checkedItem = permissao.Concedida || permissao.HerdadaDaRole;
                                    <div class="col-12 col-md-6">
                                        <label class="admin-permission-item form-check">
                                            @if (permissao.HerdadaDaRole)
                                            {
                                                <input class="form-check-input" type="checkbox" checked="@checkedItem" disabled />
                                            }
                                            else
                                            {
                                                <input class="form-check-input" type="checkbox" name="PermissoesDiretas" value="@permissao.Id" @(checkedItem ? "checked" : null) />
                                            }
                                            <span class="form-check-label">
                                                <strong>@permissao.Nome</strong>
                                                <small class="d-block text-muted">@permissao.Codigo</small>
                                                @if (!string.IsNullOrWhiteSpace(permissao.Descricao))
                                                {
                                                    <small class="d-block text-muted">@permissao.Descricao</small>
                                                }
                                                @if (permissao.HerdadaDaRole)
                                                {
                                                    <small class="badge text-bg-secondary mt-1">Herdada pelo cargo</small>
                                                }
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <a href="/admin/painel/Usuarios" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">Salvar acessos</button>
                </div>
            </form>
        </div>
    </section>
</div>
