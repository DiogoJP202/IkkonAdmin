@using IkkonAdmin.Web.Enums
@using IkkonAdmin.Web.Security
@model AdminUsuariosIndexViewModel
@{
    ViewData["Title"] = "Gestão de Usuários";
    var totalPaginas = (int)Math.Ceiling(Model.TotalRegistros / (double)Model.TamanhoPagina);
    totalPaginas = Math.Max(1, totalPaginas);

    var canGerenciarUsuarios = User.HasPermission(AppPermissions.GerenciarUsuarios);
    var canEditarPermissoes = User.HasPermission(AppPermissions.EditarPermissoes);
}

<div class="admin-panel-page admin-panel-v2-page">
    <section class="admin-panel-hero admin-panel-v2-hero is-compact">
        <div class="admin-panel-hero-copy">
            <span class="admin-panel-eyebrow">Administração de acesso</span>
            <h1 class="admin-panel-title">Usuários do sistema</h1>
            <p class="admin-panel-subtitle">Controle contas internas, alunos vinculados, status e permissões individuais.</p>
        </div>
        <div class="admin-panel-hero-actions">
            @if (canGerenciarUsuarios)
            {
                <a href="/admin/painel/NovoUsuario" class="btn admin-panel-btn admin-panel-btn-primary">Novo usuário</a>
            }
        </div>
    </section>

    <partial name="_AdminNav" />

    <section class="admin-panel-card admin-panel-card-v2 admin-panel-filter-card">
        <div class="admin-panel-card-header">
            <div>
                <span class="admin-panel-eyebrow">Filtros</span>
                <h2>Localizar usuários</h2>
                <p>Busque por nome, e-mail, login, tipo de conta ou status.</p>
            </div>
        </div>
        <form method="get" asp-action="Usuarios" class="admin-panel-filter-grid">
            <div class="admin-panel-field admin-panel-field-wide">
                <label for="busca">Busca</label>
                <input class="form-control admin-panel-control" type="search" id="busca" name="busca" value="@Model.Busca" placeholder="Nome, e-mail ou login" />
            </div>
            <div class="admin-panel-field">
                <label for="tipo">Tipo</label>
                <select class="form-select admin-panel-control" id="tipo" name="tipo">
                    @if (!Model.Tipo.HasValue) { <option value="" selected>Todos</option> } else { <option value="">Todos</option> }
                    @if (Model.Tipo == TipoAcessoEnum.Admin) { <option value="@TipoAcessoEnum.Admin" selected>Admin</option> } else { <option value="@TipoAcessoEnum.Admin">Admin</option> }
                    @if (Model.Tipo == TipoAcessoEnum.Funcionario) { <option value="@TipoAcessoEnum.Funcionario" selected>Funcionário</option> } else { <option value="@TipoAcessoEnum.Funcionario">Funcionário</option> }
                    @if (Model.Tipo == TipoAcessoEnum.Aluno) { <option value="@TipoAcessoEnum.Aluno" selected>Aluno</option> } else { <option value="@TipoAcessoEnum.Aluno">Aluno</option> }
                </select>
            </div>
            <div class="admin-panel-field">
                <label for="ativo">Status</label>
                <select class="form-select admin-panel-control" id="ativo" name="ativo">
                    @if (Model.Ativo is null) { <option value="" selected>Todos</option> } else { <option value="">Todos</option> }
                    @if (Model.Ativo == true) { <option value="true" selected>Ativo</option> } else { <option value="true">Ativo</option> }
                    @if (Model.Ativo == false) { <option value="false" selected>Inativo</option> } else { <option value="false">Inativo</option> }
                </select>
            </div>
            <div class="admin-panel-field">
                <label for="tamanhoPagina">Registros</label>
                <select class="form-select admin-panel-control" id="tamanhoPagina" name="tamanhoPagina">
                    @if (Model.TamanhoPagina == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                    @if (Model.TamanhoPagina == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                    @if (Model.TamanhoPagina == 30) { <option value="30" selected>30</option> } else { <option value="30">30</option> }
                </select>
            </div>
            <label class="admin-panel-check-card">
                <input class="form-check-input" type="checkbox" id="incluirExcluidos" name="incluirExcluidos" value="true" @(Model.IncluirExcluidos ? "checked" : null) />
                <span>Incluir excluídos</span>
            </label>
            <div class="admin-panel-filter-actions">
                <button type="submit" class="btn admin-panel-btn admin-panel-btn-primary">Aplicar filtros</button>
                <a href="/admin/painel/Usuarios" class="btn admin-panel-btn admin-panel-btn-ghost">Limpar</a>
            </div>
        </form>
    </section>

    <section class="admin-panel-card admin-panel-card-v2">
        <div class="admin-panel-card-header">
            <div>
                <span class="admin-panel-eyebrow">Resultado</span>
                <h2>Usuários (@Model.TotalRegistros)</h2>
                <p>Página @Model.PaginaAtual de @totalPaginas</p>
            </div>
        </div>
        <div class="table-responsive admin-panel-table-wrap">
            <table class="table admin-panel-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Login</th>
                        <th>Cargo</th>
                        <th>Tipo</th>
                        <th>Status</th>
                        <th>Criado em</th>
                        <th>Último login</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Usuarios.Count == 0)
                {
                    <tr><td colspan="8"><div class="admin-panel-empty">Nenhum usuário encontrado.</div></td></tr>
                }
                else
                {
                    @foreach (var item in Model.Usuarios)
                    {
                        <tr>
                            <td>
                                <div class="admin-panel-primary-cell">
                                    <strong>@item.Nome</strong>
                                    <small>@(item.Email ?? "Sem e-mail")</small>
                                </div>
                            </td>
                            <td><span class="admin-panel-code">@item.Login</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.RoleNome))
                                {
                                    <div class="admin-panel-primary-cell">
                                        <strong>@item.RoleNome</strong>
                                        <small>@item.RoleCodigo</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@item.TipoAcesso</td>
                            <td>
                                @if (item.Excluido)
                                {
                                    <span class="admin-panel-badge is-dark">Excluído</span>
                                }
                                else if (item.Ativo)
                                {
                                    <span class="admin-panel-badge is-success">Ativo</span>
                                }
                                else
                                {
                                    <span class="admin-panel-badge is-muted">Inativo</span>
                                }
                            </td>
                            <td>@item.DataCriacaoUtc.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>@(item.UltimoLoginUtc.HasValue ? item.UltimoLoginUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            <td class="text-end">
                                <div class="admin-panel-row-actions">
                                    @if (!item.Excluido)
                                    {
                                        @if (canGerenciarUsuarios)
                                        {
                                            <a href="/admin/painel/EditarUsuario/@item.Id" class="btn admin-panel-btn-table">Editar</a>
                                        }
                                        @if (canEditarPermissoes)
                                        {
                                            <a href="/admin/painel/Acessos/@item.Id" class="btn admin-panel-btn-table is-primary">Acessos</a>
                                        }
                                        @if (canGerenciarUsuarios)
                                        {
                                            <form asp-action="AlterarStatusUsuario" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="ativo" value="@(item.Ativo ? "false" : "true")" />
                                                <button type="submit" class="btn admin-panel-btn-table @(item.Ativo ? "is-warning" : "is-success")">@(item.Ativo ? "Desativar" : "Ativar")</button>
                                            </form>
                                            <form asp-action="ExcluirUsuario" method="post" class="d-inline" onsubmit="return confirm('Confirmar exclusão lógica do usuário?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn admin-panel-btn-table is-danger">Excluir</button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        @if (totalPaginas > 1)
        {
            <div class="admin-panel-card-footer">
                <nav aria-label="Paginação de usuários">
                    <ul class="pagination pagination-sm admin-panel-pagination mb-0">
                        <li class="page-item @(Model.PaginaAtual <= 1 ? "disabled" : null)">
                            <a class="page-link" asp-action="Usuarios" asp-route-busca="@Model.Busca" asp-route-tipo="@Model.Tipo" asp-route-ativo="@Model.Ativo" asp-route-incluirExcluidos="@Model.IncluirExcluidos" asp-route-tamanhoPagina="@Model.TamanhoPagina" asp-route-pagina="@(Model.PaginaAtual - 1)">Anterior</a>
                        </li>
                        @for (var p = 1; p <= totalPaginas; p++)
                        {
                            <li class="page-item @(p == Model.PaginaAtual ? "active" : null)">
                                <a class="page-link" asp-action="Usuarios" asp-route-busca="@Model.Busca" asp-route-tipo="@Model.Tipo" asp-route-ativo="@Model.Ativo" asp-route-incluirExcluidos="@Model.IncluirExcluidos" asp-route-tamanhoPagina="@Model.TamanhoPagina" asp-route-pagina="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginaAtual >= totalPaginas ? "disabled" : null)">
                            <a class="page-link" asp-action="Usuarios" asp-route-busca="@Model.Busca" asp-route-tipo="@Model.Tipo" asp-route-ativo="@Model.Ativo" asp-route-incluirExcluidos="@Model.IncluirExcluidos" asp-route-tamanhoPagina="@Model.TamanhoPagina" asp-route-pagina="@(Model.PaginaAtual + 1)">Próxima</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>
</div>
