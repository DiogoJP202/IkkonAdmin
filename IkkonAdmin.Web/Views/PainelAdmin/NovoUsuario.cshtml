@model AdminUsuarioFormViewModel
@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="admin-panel-page admin-panel-v2-page">
    <section class="admin-panel-hero admin-panel-v2-hero is-compact">
        <div class="admin-panel-hero-copy">
            <span class="admin-panel-eyebrow">Nova conta</span>
            <h1 class="admin-panel-title">Criar usuário</h1>
            <p class="admin-panel-subtitle">Cadastre uma conta interna ou vinculada à área do aluno, definindo cargo, status e senha inicial.</p>
        </div>
        <div class="admin-panel-hero-actions">
            <a href="/admin/painel/Usuarios" class="btn admin-panel-btn admin-panel-btn-ghost">Voltar</a>
        </div>
    </section>

    <partial name="_AdminNav" />

    <section class="admin-panel-card admin-panel-card-v2">
        <div class="admin-panel-card-header">
            <div>
                <span class="admin-panel-eyebrow">Dados do usuário</span>
                <h2>Informações de acesso</h2>
                <p>Use um login claro e uma senha temporária forte para o primeiro acesso.</p>
            </div>
        </div>
        <form asp-action="NovoUsuario" method="post" class="admin-panel-form-stack" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="TipoAcesso" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="admin-panel-validation text-danger small"></div>

            <div class="admin-panel-form-grid">
                <div class="admin-panel-field">
                    <label asp-for="NomeExibicao"></label>
                    <input asp-for="NomeExibicao" class="form-control admin-panel-control" placeholder="Nome completo do usuário" autocomplete="name" />
                    <span asp-validation-for="NomeExibicao" class="text-danger small"></span>
                </div>
                <div class="admin-panel-field">
                    <label asp-for="Login"></label>
                    <input asp-for="Login" class="form-control admin-panel-control" placeholder="ex.: funcionario.financeiro" autocomplete="username" />
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>
                <div class="admin-panel-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" class="form-control admin-panel-control" placeholder="email@dominio.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="admin-panel-field">
                    <label asp-for="Telefone"></label>
                    <input asp-for="Telefone" type="tel" class="form-control admin-panel-control" placeholder="(11) 90000-0000" autocomplete="tel" />
                    <span asp-validation-for="Telefone" class="text-danger small"></span>
                </div>
                <div class="admin-panel-field">
                    <label asp-for="RoleId"></label>
                    <select asp-for="RoleId" class="form-select admin-panel-control" id="RoleId">
                        <option value="">Selecione um cargo</option>
                        @foreach (var role in Model.RolesDisponiveis)
                        {
                            <option value="@role.Id" data-tipo="@role.TipoAcesso">@role.Nome (@role.Codigo)</option>
                        }
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>
                <div class="admin-panel-field">
                    <label for="tipoContaInfo">Tipo de conta do cargo</label>
                    <input id="tipoContaInfo" class="form-control admin-panel-control" value="@Model.TipoAcesso" readonly />
                </div>
                <div class="admin-panel-field">
                    <label asp-for="SenhaInicial"></label>
                    <input asp-for="SenhaInicial" type="password" class="form-control admin-panel-control" autocomplete="new-password" placeholder="Senha temporária forte" />
                    <span asp-validation-for="SenhaInicial" class="text-danger small"></span>
                </div>
                <label class="admin-panel-check-card is-form-check">
                    <input asp-for="Ativo" class="form-check-input" />
                    <span>Conta ativa no primeiro acesso</span>
                </label>
            </div>

            <div class="admin-panel-form-actions">
                <a href="/admin/painel/Usuarios" class="btn admin-panel-btn admin-panel-btn-ghost">Cancelar</a>
                <button type="submit" class="btn admin-panel-btn admin-panel-btn-primary">Criar usuário</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const roleSelect = document.getElementById('RoleId');
            const tipoInput = document.getElementById('TipoAcesso');
            const tipoInfo = document.getElementById('tipoContaInfo');

            if (!roleSelect || !tipoInput || !tipoInfo) {
                return;
            }

            const syncTipo = () => {
                const option = roleSelect.options[roleSelect.selectedIndex];
                const tipo = option ? option.getAttribute('data-tipo') : '';
                if (!tipo) {
                    return;
                }

                tipoInput.value = tipo;
                tipoInfo.value = tipo;
            };

            roleSelect.addEventListener('change', syncTipo);
            syncTipo();
        })();
    </script>
}
