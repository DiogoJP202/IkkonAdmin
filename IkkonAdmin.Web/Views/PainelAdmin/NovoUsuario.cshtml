@model AdminUsuarioFormViewModel
@{
    ViewData["Title"] = "Novo Usuario";
}

<div class="admin-panel-page d-grid gap-3">
    <partial name="_AdminNav" />

    <section class="card admin-panel-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h6 mb-0">Criar usuario</h2>
            <a href="/admin/painel/Usuarios" class="btn btn-sm btn-outline-secondary">Voltar</a>
        </div>
        <div class="card-body">
            <form asp-action="NovoUsuario" method="post" class="row g-3" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="TipoAcesso" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <div class="col-12 col-md-6">
                    <label asp-for="NomeExibicao" class="form-label"></label>
                    <input asp-for="NomeExibicao" class="form-control" placeholder="Nome completo do usuario" />
                    <span asp-validation-for="NomeExibicao" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Login" class="form-label"></label>
                    <input asp-for="Login" class="form-control" placeholder="login.usuario" />
                    <span asp-validation-for="Login" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="email@dominio.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Telefone" class="form-label"></label>
                    <input asp-for="Telefone" class="form-control" placeholder="(11) 90000-0000" />
                    <span asp-validation-for="Telefone" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="RoleId" class="form-label"></label>
                    <select asp-for="RoleId" class="form-select" id="RoleId">
                        <option value="">Selecione...</option>
                        @foreach (var role in Model.RolesDisponiveis)
                        {
                            <option value="@role.Id" data-tipo="@role.TipoAcesso">@role.Nome (@role.Codigo)</option>
                        }
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="tipoContaInfo">Tipo de conta do cargo</label>
                    <input id="tipoContaInfo" class="form-control" value="@Model.TipoAcesso" readonly />
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="SenhaInicial" class="form-label"></label>
                    <input asp-for="SenhaInicial" type="password" class="form-control" autocomplete="new-password" placeholder="Senha temporaria forte" />
                    <span asp-validation-for="SenhaInicial" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Ativo" class="form-check-input" />
                        <label asp-for="Ativo" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-12 d-flex gap-2 justify-content-end">
                    <a href="/admin/painel/Usuarios" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">Criar usuario</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const roleSelect = document.getElementById('RoleId');
            const tipoInput = document.getElementById('TipoAcesso');
            const tipoInfo = document.getElementById('tipoContaInfo');

            if (!roleSelect || !tipoInput || !tipoInfo) {
                return;
            }

            const syncTipo = () => {
                const option = roleSelect.options[roleSelect.selectedIndex];
                const tipo = option ? option.getAttribute('data-tipo') : '';
                if (!tipo) {
                    return;
                }

                tipoInput.value = tipo;
                tipoInfo.value = tipo;
            };

            roleSelect.addEventListener('change', syncTipo);
            syncTipo();
        })();
    </script>
}
