@using IkkonAdmin.Web.Enums
@model AdminRoleFormViewModel
@{
    ViewData["Title"] = "Novo Cargo";
}

<div class="admin-panel-page d-grid gap-3">
    <partial name="_AdminNav" />

    <section class="card admin-panel-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h6 mb-0">Criar cargo</h2>
            <a href="/admin/painel/Cargos" class="btn btn-sm btn-outline-secondary">Voltar</a>
        </div>
        <div class="card-body">
            <form asp-action="NovoCargo" method="post" class="row g-3" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <div class="col-12 col-md-6">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" placeholder="Ex.: Financeiro Senior" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Codigo" class="form-label"></label>
                    <input asp-for="Codigo" class="form-control" placeholder="Opcional. Ex.: ROLE_FINANCEIRO_SENIOR" />
                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="TipoAcesso" class="form-label"></label>
                    <select asp-for="TipoAcesso" class="form-select">
                        <option value="@TipoAcessoEnum.Admin">Admin</option>
                        <option value="@TipoAcessoEnum.Funcionario">Funcionario</option>
                        <option value="@TipoAcessoEnum.Aluno">Aluno</option>
                    </select>
                    <span asp-validation-for="TipoAcesso" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="Ativo" class="form-check-input" />
                        <label asp-for="Ativo" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="2" placeholder="Descricao resumida do cargo"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <h3 class="h6 mb-2">Permissoes do cargo</h3>
                    @foreach (var grupo in Model.PermissoesDisponiveis.GroupBy(x => x.Modulo).OrderBy(x => x.Key))
                    {
                        <div class="mb-3">
                            <h4 class="h6 mb-2">@grupo.Key</h4>
                            <div class="row g-2">
                                @foreach (var permissao in grupo)
                                {
                                    var checkedItem = permissao.Concedida || Model.PermissoesSelecionadas.Contains(permissao.Id);
                                    <div class="col-12 col-md-6">
                                        <label class="admin-permission-item form-check">
                                            <input class="form-check-input" type="checkbox" name="PermissoesSelecionadas" value="@permissao.Id" @(checkedItem ? "checked" : null) />
                                            <span class="form-check-label">
                                                <strong>@permissao.Nome</strong>
                                                <small class="d-block text-muted">@permissao.Codigo</small>
                                                @if (!string.IsNullOrWhiteSpace(permissao.Descricao))
                                                {
                                                    <small class="d-block text-muted">@permissao.Descricao</small>
                                                }
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="col-12 d-flex gap-2 justify-content-end">
                    <a href="/admin/painel/Cargos" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">Criar cargo</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
