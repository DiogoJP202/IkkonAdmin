@using IkkonAdmin.Web.Security
@model DesligamentoCreateViewModel
@{
    ViewData["Title"] = "Novo Desligamento";
    var canAlunosView = User.HasPermission(AppPermissions.AlunosView);
    var canFinanceiroView = User.HasPermission(AppPermissions.FinanceiroView);
}

<div class="desligamentos-page d-grid gap-3">
    <section class="desligamentos-hero rounded-3 p-3 p-lg-4">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-lg-8">
                <p class="desligamentos-eyebrow mb-2">Nova solicitação</p>
                <h1 class="desligamentos-title mb-2">Registrar desligamento</h1>
                <p class="desligamentos-subtitle mb-0">
                    Abra o processo de saída com motivo, pendências e checklist inicial para evitar retrabalho no fechamento.
                </p>
            </div>
            <div class="col-12 col-lg-4">
                <div class="desligamentos-quick-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar para a lista</a>
                    @if (canAlunosView)
                    {
                        <a asp-controller="Alunos" asp-action="Index" class="btn btn-outline-secondary">Consultar alunos</a>
                    }
                    @if (canFinanceiroView)
                    {
                        <a asp-controller="Financeiro" asp-action="Index" class="btn btn-outline-secondary">Abrir financeiro</a>
                    }
                </div>
            </div>
        </div>
    </section>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="card desligamentos-form-card">
                <div class="card-header">
                    <div>
                        <h2 class="desligamentos-section-title mb-1">Dados do desligamento</h2>
                        <p class="desligamentos-section-subtitle mb-0">Preencha os campos operacionais para iniciar o processo.</p>
                    </div>
                    <span class="desligamentos-form-id">Novo processo</span>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-12 desligamentos-form-section">
                            <h3 class="desligamentos-form-section-title">Identificação e motivo</h3>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="AlunoId" class="desligamentos-label">Aluno</label>
                                    <select asp-for="AlunoId" class="form-select">
                                        <option value="">Selecione um aluno</option>
                                        @foreach (var aluno in Model.AlunosDisponiveis)
                                        {
                                            if (Model.AlunoId == aluno.Id)
                                            {
                                                <option value="@aluno.Id" selected>
                                                    @aluno.Nome (@aluno.Status) @(string.IsNullOrWhiteSpace(aluno.Turma) ? string.Empty : $"- {aluno.Turma}")
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@aluno.Id">
                                                    @aluno.Nome (@aluno.Status) @(string.IsNullOrWhiteSpace(aluno.Turma) ? string.Empty : $"- {aluno.Turma}")
                                                </option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="AlunoId" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label asp-for="DataSolicitacao" class="desligamentos-label">Data da solicitação</label>
                                    <input asp-for="DataSolicitacao" type="date" class="form-control" />
                                </div>
                                <div class="col-12 col-md-8">
                                    <div class="form-check desligamentos-check mt-md-4">
                                        <input asp-for="CalcularPendenciasAutomaticamente" class="form-check-input" />
                                        <label asp-for="CalcularPendenciasAutomaticamente" class="form-check-label">Calcular pendências automaticamente</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Motivo" class="desligamentos-label">Motivo</label>
                                    <textarea asp-for="Motivo" class="form-control" rows="4" placeholder="Descreva o motivo do desligamento de forma objetiva."></textarea>
                                    <span asp-validation-for="Motivo" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 desligamentos-form-section">
                            <h3 class="desligamentos-form-section-title">Financeiro e checklist</h3>
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label asp-for="PendenciaFinanceira" class="desligamentos-label">Pendência financeira</label>
                                    <input asp-for="PendenciaFinanceira" class="form-control" inputmode="decimal" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label asp-for="MultaRescisoria" class="desligamentos-label">Multa rescisória</label>
                                    <input asp-for="MultaRescisoria" class="form-control" inputmode="decimal" />
                                </div>
                                <div class="col-12 col-md-4 d-flex align-items-end">
                                    <div class="desligamentos-checklist-box w-100">
                                        <strong>Total estimado</strong>
                                        <div class="text-muted">Pendência + multa</div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-check desligamentos-check">
                                        <input asp-for="RequerimentoRecebido" class="form-check-input" />
                                        <label asp-for="RequerimentoRecebido" class="form-check-label">Requerimento recebido</label>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-check desligamentos-check">
                                        <input asp-for="AcessosRemovidos" class="form-check-input" />
                                        <label asp-for="AcessosRemovidos" class="form-check-label">Acessos removidos</label>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Observacoes" class="desligamentos-label">Observações</label>
                                    <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Registre pendências, acordos e próximas ações."></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 desligamentos-form-actions">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Salvar desligamento</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card desligamentos-side-card h-100">
                <div class="card-header">
                    <h2 class="desligamentos-section-title mb-0">Guia rápido</h2>
                </div>
                <div class="card-body">
                    <ul class="desligamentos-priority-list mb-0">
                        <li>
                            <strong>Revise valores</strong>
                            <span>Confirme pendências e multa antes de concluir o processo.</span>
                        </li>
                        <li>
                            <strong>Checklist completo</strong>
                            <span>Marque requerimento e remoção de acessos para evitar falhas operacionais.</span>
                        </li>
                        <li>
                            <strong>Observações objetivas</strong>
                            <span>Registre apenas o contexto necessário para a equipe executar os próximos passos.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
