@using IkkonAdmin.Web.Enums
@using IkkonAdmin.Web.Security
@model DesligamentoDetalhesViewModel
@{
    ViewData["Title"] = "Detalhes do Desligamento";

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var canDesligamentosEdit = User.HasPermission(AppPermissions.DesligamentosEdit);
    var canAlunosView = User.HasPermission(AppPermissions.AlunosView);
    var checklistConcluido = (Model.RequerimentoRecebido ? 1 : 0) + (Model.AcessosRemovidos ? 1 : 0);
    var percentualChecklist = (checklistConcluido * 100) / 2;
    var totalEncerramento = Model.PendenciaFinanceira + Model.MultaRescisoria;
    var inicialPessoa = string.IsNullOrWhiteSpace(Model.AlunoNome)
        ? "D"
        : Model.AlunoNome.Trim()[0].ToString().ToUpperInvariant();
}

@functions {
    private static string StatusAlunoTexto(StatusAlunoEnum status)
    {
        return status switch
        {
            StatusAlunoEnum.EmAdmissao => "Em admissão",
            StatusAlunoEnum.Ativo => "Ativo",
            StatusAlunoEnum.Inativo => "Inativo",
            StatusAlunoEnum.Desligado => "Desligado",
            _ => status.ToString()
        };
    }
}

<div class="desligamentos-v2-page">
    <section class="desligamentos-v2-profile-hero mb-4">
        <div class="desligamentos-v2-profile-title">
            <div class="desligamentos-v2-avatar">@inicialPessoa</div>
            <div>
                <span class="desligamentos-v2-eyebrow">Detalhes do processo</span>
                <h1>@Model.AlunoNome</h1>
                <div class="desligamentos-v2-meta">
                    <span>Processo <strong>#@Model.Id</strong></span>
                    <span>Solicitação <strong>@Model.DataSolicitacao.ToString("dd/MM/yyyy")</strong></span>
                    <span>Aluno <strong>@StatusAlunoTexto(Model.StatusAluno)</strong></span>
                    @if (Model.DataConfirmacao.HasValue)
                    {
                        <span>Confirmação <strong>@Model.DataConfirmacao.Value.ToString("dd/MM/yyyy")</strong></span>
                    }
                </div>
            </div>
        </div>

        <div class="desligamentos-v2-hero-actions">
            @if (Model.Confirmado)
            {
                <span class="desligamentos-v2-status-pill is-success">Confirmado</span>
            }
            else
            {
                <span class="desligamentos-v2-status-pill is-warning">Em aberto</span>
            }
            @if (canAlunosView)
            {
                <a asp-controller="Alunos" asp-action="Details" asp-route-id="@Model.AlunoId" class="btn desligamentos-v2-btn desligamentos-v2-btn-ghost">Abrir aluno</a>
            }
            <a asp-action="Index" class="btn desligamentos-v2-btn desligamentos-v2-btn-ghost">Voltar</a>
        </div>
    </section>

    <section class="desligamentos-v2-kpi-grid mb-4" aria-label="Resumo do desligamento">
        <article class="desligamentos-v2-kpi-card is-warning">
            <div class="desligamentos-v2-kpi-top">
                <span>Checklist</span>
                <b>@percentualChecklist%</b>
            </div>
            <strong>@checklistConcluido/2</strong>
            <small>Etapas de encerramento concluídas.</small>
        </article>

        <article class="desligamentos-v2-kpi-card is-danger">
            <div class="desligamentos-v2-kpi-top">
                <span>Pendência</span>
                <b>Financeiro</b>
            </div>
            <strong>@Model.PendenciaFinanceira.ToString("C")</strong>
            <small>Valor em aberto antes do encerramento.</small>
        </article>

        <article class="desligamentos-v2-kpi-card">
            <div class="desligamentos-v2-kpi-top">
                <span>Multa</span>
                <b>Contrato</b>
            </div>
            <strong>@Model.MultaRescisoria.ToString("C")</strong>
            <small>Multa rescisória informada.</small>
        </article>

        <article class="desligamentos-v2-kpi-card @(totalEncerramento > 0m ? "is-danger" : "is-success")">
            <div class="desligamentos-v2-kpi-top">
                <span>Total</span>
                <b>Encerramento</b>
            </div>
            <strong>@totalEncerramento.ToString("C")</strong>
            <small>Pendência + multa.</small>
        </article>
    </section>

    <div class="desligamentos-v2-details-grid">
        <section class="desligamentos-v2-form-panel">
            <div class="desligamentos-v2-panel-heading">
                <div>
                    <span class="desligamentos-v2-eyebrow">Processo</span>
                    <h2>Dados do desligamento</h2>
                    <p>Atualize motivo, valores e checklist antes de confirmar o encerramento definitivo.</p>
                </div>
            </div>

            <div class="desligamentos-v2-form">
                @if (canDesligamentosEdit)
                {
                    <form asp-action="Atualizar" asp-route-id="@Model.Id" method="post" class="desligamentos-v2-inline-process-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="AlunoId" type="hidden" />
                        <input asp-for="AlunoNome" type="hidden" />
                        <input asp-for="StatusAluno" type="hidden" />
                        <input asp-for="DataSolicitacao" type="hidden" />
                        <input asp-for="DataConfirmacao" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="desligamentos-v2-validation-summary"></div>

                        <section class="desligamentos-v2-form-section">
                            <div class="desligamentos-v2-field">
                                <label asp-for="Motivo">Motivo</label>
                                <textarea asp-for="Motivo"
                                          rows="4"
                                          class="form-control desligamentos-v2-control"
                                          placeholder="Descreva o contexto do desligamento e os acordos realizados."></textarea>
                                <span asp-validation-for="Motivo" class="text-danger"></span>
                            </div>
                        </section>

                        <section class="desligamentos-v2-form-section">
                            <div class="desligamentos-v2-form-grid">
                                <div class="desligamentos-v2-field">
                                    <label asp-for="PendenciaFinanceira">Pendência financeira</label>
                                    <input asp-for="PendenciaFinanceira"
                                           type="text"
                                           class="form-control desligamentos-v2-control"
                                           inputmode="decimal"
                                           placeholder="0,00" />
                                    <span asp-validation-for="PendenciaFinanceira" class="text-danger"></span>
                                </div>

                                <div class="desligamentos-v2-field">
                                    <label asp-for="MultaRescisoria">Multa rescisória</label>
                                    <input asp-for="MultaRescisoria"
                                           type="text"
                                           class="form-control desligamentos-v2-control"
                                           inputmode="decimal"
                                           placeholder="0,00" />
                                    <span asp-validation-for="MultaRescisoria" class="text-danger"></span>
                                </div>

                                <div class="desligamentos-v2-total-card">
                                    <span>Total de encerramento</span>
                                    <strong>@totalEncerramento.ToString("C")</strong>
                                    <small>Pendência + multa rescisória.</small>
                                </div>
                            </div>

                            <div class="desligamentos-v2-inline-actions mt-3">
                                <button type="submit"
                                        class="btn desligamentos-v2-btn desligamentos-v2-btn-ghost"
                                        formaction="@Url.Action("RecalcularPendencias", "Desligamentos", new { id = Model.Id })"
                                        formmethod="post">
                                    Recalcular pendências
                                </button>
                            </div>
                        </section>

                        <section class="desligamentos-v2-form-section">
                            <div class="desligamentos-v2-checklist-summary">
                                <span>Checklist de encerramento</span>
                                <div class="desligamentos-v2-progress" role="progressbar" aria-label="Progresso do checklist" aria-valuenow="@checklistConcluido" aria-valuemin="0" aria-valuemax="2">
                                    <span style="width:@percentualChecklist%"></span>
                                </div>
                                <strong>@checklistConcluido/2 etapas</strong>
                            </div>

                            <div class="desligamentos-v2-check-grid mt-3">
                                <label class="desligamentos-v2-check-card">
                                    <input asp-for="RequerimentoRecebido" class="form-check-input" />
                                    <span>
                                        <strong>Requerimento recebido</strong>
                                        <small>Solicitação formal recebida e registrada.</small>
                                    </span>
                                </label>

                                <label class="desligamentos-v2-check-card">
                                    <input asp-for="AcessosRemovidos" class="form-check-input" />
                                    <span>
                                        <strong>Acessos removidos</strong>
                                        <small>Grupos, Drive e demais acessos encerrados.</small>
                                    </span>
                                </label>
                            </div>
                        </section>

                        <section class="desligamentos-v2-form-section">
                            <div class="desligamentos-v2-field">
                                <label asp-for="Observacoes">Observações</label>
                                <textarea asp-for="Observacoes"
                                          rows="3"
                                          class="form-control desligamentos-v2-control"
                                          placeholder="Anote ações pendentes para o fechamento administrativo."></textarea>
                                <span asp-validation-for="Observacoes" class="text-danger"></span>
                            </div>
                        </section>

                        <div class="desligamentos-v2-form-actions">
                            <button type="submit" class="btn desligamentos-v2-btn desligamentos-v2-btn-primary">Salvar atualizações</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="desligamentos-v2-alert-card">
                        <strong>Sem permissão de edição</strong>
                        <span>Você pode visualizar este processo, mas não pode alterar motivo, valores ou checklist.</span>
                    </div>
                }
            </div>
        </section>

        <aside class="desligamentos-v2-side-stack">
            <section class="desligamentos-v2-side-card">
                <span class="desligamentos-v2-eyebrow">Confirmação</span>
                <h2>Encerramento definitivo</h2>
                <p>Ao confirmar, o aluno é marcado como desligado e as cobranças futuras podem ser canceladas.</p>

                @if (Model.Confirmado)
                {
                    <div class="desligamentos-v2-concluded-box">
                        <strong>Desligamento confirmado</strong>
                        <span>Este processo foi concluído em @Model.DataConfirmacao!.Value.ToString("dd/MM/yyyy").</span>
                    </div>
                }
                else if (canDesligamentosEdit)
                {
                    <form asp-action="Confirmar" asp-route-id="@Model.Id" method="post" class="desligamentos-v2-confirm-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <label class="desligamentos-v2-check-card">
                            <input class="form-check-input" type="checkbox" id="encerrarCobrancasFuturas" name="encerrarCobrancasFuturas" value="true" checked />
                            <span>
                                <strong>Encerrar cobranças futuras</strong>
                                <small>Cancela mensalidades pendentes com vencimento futuro.</small>
                            </span>
                        </label>

                        <button type="submit" class="btn desligamentos-v2-btn desligamentos-v2-btn-danger w-100">Confirmar desligamento</button>
                    </form>
                }
                else
                {
                    <div class="desligamentos-v2-alert-card">
                        <strong>Sem permissão</strong>
                        <span>Você não possui permissão para confirmar desligamentos.</span>
                    </div>
                }
            </section>

            <section class="desligamentos-v2-assist-card desligamentos-v2-assist-card-compact">
                <span class="desligamentos-v2-eyebrow">Próximos passos</span>
                <h2>Antes de confirmar</h2>
                <ul>
                    <li>Revise pendência financeira e multa rescisória.</li>
                    <li>Garanta requerimento recebido e acessos removidos.</li>
                    <li>Confirme se cobranças futuras devem ser canceladas.</li>
                    <li>Registre qualquer acordo ou exceção nas observações.</li>
                </ul>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
