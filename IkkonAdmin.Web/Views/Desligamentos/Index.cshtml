@using IkkonAdmin.Web.Security
@model DesligamentoIndexViewModel
@{
    ViewData["Title"] = "Desligamentos";
    var canDesligamentosCreate = User.HasPermission(AppPermissions.DesligamentosCreate);
    var canAlunosView = User.HasPermission(AppPermissions.AlunosView);
    var canFinanceiroView = User.HasPermission(AppPermissions.FinanceiroView);

    var total = Model.Desligamentos.Count;
    var emAberto = Model.Desligamentos.Count(x => !x.Confirmado);
    var confirmados = Model.Desligamentos.Count(x => x.Confirmado);
    var pendenciasFinanceiras = Model.Desligamentos.Count(x => (x.PendenciaFinanceira + x.MultaRescisoria) > 0m && !x.Confirmado);
    var semChecklistFinal = Model.Desligamentos.Count(x => (!x.RequerimentoRecebido || !x.AcessosRemovidos) && !x.Confirmado);

    var filtrosAtivos = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.Busca))
    {
        filtrosAtivos.Add($"Busca: {Model.Busca}");
    }
    if (Model.Confirmado.HasValue)
    {
        filtrosAtivos.Add(Model.Confirmado.Value ? "Status: Confirmados" : "Status: Em aberto");
    }
}

<div class="desligamentos-page d-grid gap-3">
    <section class="desligamentos-hero rounded-3 p-3 p-lg-4">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-xl-8">
                <p class="desligamentos-eyebrow mb-2">Saída de alunos</p>
                <h1 class="desligamentos-title mb-2">Central de Desligamentos</h1>
                <p class="desligamentos-subtitle mb-0">
                    Controle solicitações de desligamento, pendências financeiras e conclusão do checklist operacional em uma única fila.
                </p>
            </div>
            <div class="col-12 col-xl-4">
                <div class="desligamentos-quick-actions">
                    @if (canDesligamentosCreate)
                    {
                        <a asp-action="Create" class="btn btn-primary">Novo desligamento</a>
                    }
                    @if (canAlunosView)
                    {
                        <a asp-controller="Alunos" asp-action="Index" class="btn btn-outline-secondary">Consultar alunos</a>
                    }
                    @if (canFinanceiroView)
                    {
                        <a asp-controller="Financeiro" asp-action="Atrasados" class="btn btn-outline-secondary">Ver inadimplência</a>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="row g-3">
        <div class="col-6 col-xl-2">
            <article class="desligamentos-kpi-card desligamentos-kpi-highlight">
                <span class="desligamentos-kpi-label">Total</span>
                <strong class="desligamentos-kpi-value">@total</strong>
                <span class="desligamentos-kpi-foot">Processos registrados</span>
            </article>
        </div>
        <div class="col-6 col-xl-2">
            <article class="desligamentos-kpi-card desligamentos-kpi-warning">
                <span class="desligamentos-kpi-label">Em aberto</span>
                <strong class="desligamentos-kpi-value">@emAberto</strong>
                <span class="desligamentos-kpi-foot">Exigem tratativa</span>
            </article>
        </div>
        <div class="col-6 col-xl-2">
            <article class="desligamentos-kpi-card desligamentos-kpi-success">
                <span class="desligamentos-kpi-label">Confirmados</span>
                <strong class="desligamentos-kpi-value">@confirmados</strong>
                <span class="desligamentos-kpi-foot">Concluídos</span>
            </article>
        </div>
        <div class="col-6 col-xl-3">
            <article class="desligamentos-kpi-card desligamentos-kpi-danger">
                <span class="desligamentos-kpi-label">Com pendência financeira</span>
                <strong class="desligamentos-kpi-value">@pendenciasFinanceiras</strong>
                <span class="desligamentos-kpi-foot">Em aberto com valores pendentes</span>
            </article>
        </div>
        <div class="col-12 col-xl-3">
            <article class="desligamentos-kpi-card desligamentos-kpi-info">
                <span class="desligamentos-kpi-label">Checklist incompleto</span>
                <strong class="desligamentos-kpi-value">@semChecklistFinal</strong>
                <span class="desligamentos-kpi-foot">Requerimento ou acessos pendentes</span>
            </article>
        </div>
    </section>

    <section class="card desligamentos-filter-card">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-12 col-lg-5">
                    <label asp-for="Busca" class="desligamentos-label">Busca</label>
                    <input asp-for="Busca" class="form-control" placeholder="Buscar por aluno ou CPF" autocomplete="off" />
                </div>
                <div class="col-12 col-lg-3">
                    <label asp-for="Confirmado" class="desligamentos-label">Status</label>
                    <select asp-for="Confirmado" class="form-select">
                        <option value="">Todos</option>
                        @if (Model.Confirmado == true)
                        {
                            <option value="true" selected>Confirmados</option>
                        }
                        else
                        {
                            <option value="true">Confirmados</option>
                        }
                        @if (Model.Confirmado == false)
                        {
                            <option value="false" selected>Em aberto</option>
                        }
                        else
                        {
                            <option value="false">Em aberto</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2 d-grid">
                    <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
                </div>
                <div class="col-6 col-lg-2 d-grid">
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
                </div>
                @if (filtrosAtivos.Count > 0)
                {
                    <div class="col-12">
                        <div class="desligamentos-active-filters">
                            @foreach (var filtro in filtrosAtivos)
                            {
                                <span class="desligamentos-filter-chip">@filtro</span>
                            }
                        </div>
                    </div>
                }
            </form>
        </div>
    </section>

    <section class="card desligamentos-table-card">
        <div class="card-header">
            <div>
                <h2 class="desligamentos-section-title mb-1">Fila de desligamentos</h2>
                <p class="desligamentos-section-subtitle mb-0">Priorize casos em aberto com pendências financeiras e checklist incompleto.</p>
            </div>
            <span class="badge text-bg-light border">@total registros</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 desligamentos-table">
                <thead class="table-light">
                    <tr>
                        <th>Aluno</th>
                        <th>Solicitação</th>
                        <th>Confirmação</th>
                        <th class="text-end">Pendência</th>
                        <th class="text-end">Multa</th>
                        <th>Checklist</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Desligamentos.Count == 0)
                    {
                        <tr>
                                    <td colspan="7">
                                        <div class="desligamentos-empty-state text-center py-4">
                                            <h4>Nenhum desligamento encontrado.</h4>
                                            <p class="mb-3">Ajuste os filtros ou registre um novo desligamento.</p>
                                            @if (canDesligamentosCreate)
                                            {
                                                <a asp-action="Create" class="btn btn-primary">Novo desligamento</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Desligamentos)
                        {
                            var critico = !item.Confirmado && ((item.PendenciaFinanceira + item.MultaRescisoria) > 0m || !item.RequerimentoRecebido || !item.AcessosRemovidos);

                            <tr class="@(critico ? "desligamentos-row-attention" : string.Empty)">
                                <td>
                                    <div class="desligamentos-name-cell">
                                        @if (canAlunosView)
                                        {
                                            <a asp-controller="Alunos" asp-action="Details" asp-route-id="@item.AlunoId" class="text-decoration-none desligamentos-name">@item.AlunoNome</a>
                                        }
                                        else
                                        {
                                            <span class="desligamentos-name">@item.AlunoNome</span>
                                        }
                                        <span class="desligamentos-meta">Processo #@item.Id</span>
                                    </div>
                                </td>
                                <td>@item.DataSolicitacao.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.DataConfirmacao.HasValue)
                                    {
                                        <span class="desligamentos-status-pill desligamentos-status-success">@item.DataConfirmacao.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="desligamentos-status-pill desligamentos-status-warning">Em aberto</span>
                                    }
                                </td>
                                <td class="text-end">@item.PendenciaFinanceira.ToString("C")</td>
                                <td class="text-end">@item.MultaRescisoria.ToString("C")</td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <span class="small @(item.RequerimentoRecebido ? "text-success" : "text-muted")">@(item.RequerimentoRecebido ? "Requerimento recebido" : "Requerimento pendente")</span>
                                        <span class="small @(item.AcessosRemovidos ? "text-success" : "text-muted")">@(item.AcessosRemovidos ? "Acessos removidos" : "Acessos pendentes")</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary desligamentos-action-btn">Gerenciar</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
