@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";
}

<div class="auth-page">
    <div class="auth-page-bg" aria-hidden="true"></div>
    <div class="container px-3">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-7 col-xl-5">
                <article class="auth-card">
                    <div class="auth-card-head">
                        <img src="~/Images/Ikkon_Icon.png" asp-append-version="true" alt="Logo Ikkon" class="auth-logo" />
                        <div>
                            <p class="auth-kicker mb-1">&#193;rea interna</p>
                            <h1 class="auth-title mb-0">Entrar no IkkonAdmin</h1>
                        </div>
                    </div>

                    <p class="auth-subtitle">
                        Selecione seu tipo de acesso e informe suas credenciais.
                    </p>

                    <form asp-action="Login" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input asp-for="ReturnUrl" type="hidden" />

                        <div class="auth-role-tabs mb-3" role="tablist" aria-label="Tipo de acesso">
                            <input asp-for="TipoAcesso" class="btn-check" type="radio" id="tipoFuncionario" value="@TipoAcessoEnum.Funcionario" />
                            <label class="btn auth-role-tab" for="tipoFuncionario">Funcion&#225;rio</label>

                            <input asp-for="TipoAcesso" class="btn-check" type="radio" id="tipoAluno" value="@TipoAcessoEnum.Aluno" />
                            <label class="btn auth-role-tab" for="tipoAluno">Aluno</label>

                            <input asp-for="TipoAcesso" class="btn-check" type="radio" id="tipoAdmin" value="@TipoAcessoEnum.Admin" />
                            <label class="btn auth-role-tab" for="tipoAdmin">Administrador</label>
                        </div>
                        <span asp-validation-for="TipoAcesso" class="text-danger small"></span>

                        <div class="mb-3">
                            <label asp-for="LoginOuEmail" class="form-label"></label>
                            <input asp-for="LoginOuEmail" class="form-control auth-input" placeholder="seu.email@dominio.com ou usuario" autocomplete="username" />
                            <span asp-validation-for="LoginOuEmail" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Senha" class="form-label"></label>
                            <input asp-for="Senha" class="form-control auth-input" placeholder="Informe sua senha" autocomplete="current-password" />
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small mb-3"></div>

                        <button type="submit" class="btn btn-danger w-100 auth-submit">
                            Entrar
                        </button>
                    </form>

                    <div class="auth-footer-links mt-3">
                        <a href="/" class="link-secondary text-decoration-none">Voltar para o site</a>
                        <span class="text-muted">Recupera&#231;&#227;o de senha em breve</span>
                    </div>
                </article>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
