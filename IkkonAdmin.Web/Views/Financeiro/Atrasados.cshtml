@using IkkonAdmin.Web.Security
@model FinanceiroAtrasadosViewModel
@{
    ViewData["Title"] = "Mensalidades Atrasadas";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var canFinanceiroCreate = User.HasPermission(AppPermissions.FinanceiroCreate);
}

<div class="financeiro-page">
    <section class="card financeiro-hero mb-3">
        <div class="card-body p-3 p-lg-4">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-lg-8">
                    <div class="financeiro-eyebrow">Inadimplência</div>
                    <h2 class="financeiro-title mb-2">Recuperação de atrasos</h2>
                    <p class="financeiro-subtitle mb-0">
                        Priorize mensalidades vencidas com maior impacto financeiro e acione rapidamente o registro de pagamento.
                    </p>
                </div>
                <div class="col-12 col-lg-4">
                    <article class="financeiro-kpi-card financeiro-kpi-danger">
                        <span class="financeiro-kpi-label">Total em atraso</span>
                        <strong class="financeiro-kpi-value">@Model.TotalEmAtraso.ToString("C")</strong>
                        <span class="financeiro-kpi-foot">@Model.Itens.Count item(ns) em aberto</span>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <section class="card financeiro-table-card">
        <div class="card-header">
            <div>
                <h3 class="financeiro-section-title mb-1">Mensalidades em atraso</h3>
                <p class="financeiro-section-subtitle mb-0">Ordene ações pelos dias de atraso e valor devido.</p>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">Voltar ao financeiro</a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 financeiro-table">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Competência</th>
                        <th>Vencimento</th>
                        <th>Dias de atraso</th>
                        <th class="text-end">Valor</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Itens.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="financeiro-empty-state">
                                    <h4>Nenhum atraso encontrado</h4>
                                    <p class="mb-0">Não há mensalidades vencidas no momento para o recorte atual.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Itens)
                        {
                            var atrasoClass = item.DiasAtraso >= 30
                                ? "financeiro-status-pill financeiro-status-danger"
                                : item.DiasAtraso >= 10
                                    ? "financeiro-status-pill financeiro-status-warning"
                                    : "financeiro-status-pill financeiro-status-muted";

                            <tr>
                                <td>
                                    <a asp-action="HistoricoAluno" asp-route-alunoId="@item.AlunoId" class="text-decoration-none fw-semibold">@item.Aluno</a>
                                </td>
                                <td>@item.Competencia.ToString("MM/yyyy")</td>
                                <td>@item.DataVencimento.ToString("dd/MM/yyyy")</td>
                                <td><span class="@atrasoClass">@item.DiasAtraso dia(s)</span></td>
                                <td class="text-end">@item.ValorFinal.ToString("C")</td>
                                <td class="text-end">
                                    @if (canFinanceiroCreate)
                                    {
                                        <a asp-action="RegistrarPagamento"
                                           asp-route-mensalidadeId="@item.MensalidadeId"
                                           asp-route-returnUrl="@returnUrl"
                                           class="btn btn-sm btn-outline-primary">
                                            Registrar pagamento
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sem permissão</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
