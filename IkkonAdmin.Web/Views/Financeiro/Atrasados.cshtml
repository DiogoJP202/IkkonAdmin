@using IkkonAdmin.Web.Security
@model FinanceiroAtrasadosViewModel
@{
    ViewData["Title"] = "Mensalidades Atrasadas";

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var canFinanceiroCreate = User.HasPermission(AppPermissions.FinanceiroCreate);
    var atrasosCriticos = Model.Itens.Count(x => x.DiasAtraso >= 30);
    var atrasosAtencao = Model.Itens.Count(x => x.DiasAtraso is >= 10 and < 30);
    var maiorAtraso = Model.Itens.Count == 0 ? 0 : Model.Itens.Max(x => x.DiasAtraso);
}

@functions {
    private static string AtrasoClasse(int diasAtraso)
    {
        if (diasAtraso >= 30)
        {
            return "is-danger";
        }

        if (diasAtraso >= 10)
        {
            return "is-warning";
        }

        return "is-muted";
    }

    private static string InicialAluno(string nome)
    {
        return string.IsNullOrWhiteSpace(nome)
            ? "A"
            : nome.Trim()[0].ToString().ToUpperInvariant();
    }
}

<div class="financeiro-v2-page">
    <section class="financeiro-v2-hero mb-4">
        <div class="financeiro-v2-hero-copy">
            <span class="financeiro-v2-eyebrow">Inadimplência</span>
            <h1>Recuperação de atrasos</h1>
            <p>
                Priorize mensalidades vencidas por tempo de atraso e valor em aberto para orientar cobranças e acordos.
            </p>

            <div class="financeiro-v2-meta">
                <span>Total em atraso <strong>@Model.TotalEmAtraso.ToString("C")</strong></span>
                <span>Itens vencidos <strong>@Model.Itens.Count</strong></span>
                <span>Maior atraso <strong>@maiorAtraso dias</strong></span>
            </div>
        </div>

        <div class="financeiro-v2-hero-actions">
            <a asp-action="Index" class="btn financeiro-v2-btn financeiro-v2-btn-ghost">Voltar ao financeiro</a>
            @if (canFinanceiroCreate)
            {
                <a asp-action="RegistrarPagamento" asp-route-returnUrl="@returnUrl" class="btn financeiro-v2-btn financeiro-v2-btn-primary">Registrar pagamento</a>
            }
        </div>
    </section>

    <section class="financeiro-v2-kpi-grid mb-4" aria-label="Indicadores de atraso">
        <article class="financeiro-v2-kpi-card is-danger">
            <div class="financeiro-v2-kpi-top">
                <span>Total em atraso</span>
                <b>Exposição</b>
            </div>
            <strong>@Model.TotalEmAtraso.ToString("C")</strong>
            <small>Valor vencido aguardando regularização.</small>
        </article>

        <article class="financeiro-v2-kpi-card">
            <div class="financeiro-v2-kpi-top">
                <span>Itens</span>
                <b>Abertos</b>
            </div>
            <strong>@Model.Itens.Count</strong>
            <small>Mensalidades vencidas no momento.</small>
        </article>

        <article class="financeiro-v2-kpi-card is-danger">
            <div class="financeiro-v2-kpi-top">
                <span>Críticos</span>
                <b>30+ dias</b>
            </div>
            <strong>@atrasosCriticos</strong>
            <small>Casos que exigem ação prioritária.</small>
        </article>

        <article class="financeiro-v2-kpi-card is-warning">
            <div class="financeiro-v2-kpi-top">
                <span>Atenção</span>
                <b>10-29 dias</b>
            </div>
            <strong>@atrasosAtencao</strong>
            <small>Casos para lembrete ou negociação.</small>
        </article>
    </section>

    <section class="financeiro-v2-table-panel">
        <div class="financeiro-v2-panel-heading">
            <div>
                <span class="financeiro-v2-eyebrow">Cobrança</span>
                <h2>Mensalidades em atraso</h2>
                <p>Ordene ações pelos dias de atraso e valor devido.</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table financeiro-v2-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Competência</th>
                        <th>Vencimento</th>
                        <th>Dias de atraso</th>
                        <th class="text-end">Valor</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Itens.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="financeiro-v2-empty-state">
                                    <strong>Nenhum atraso encontrado.</strong>
                                    <span>Não há mensalidades vencidas no momento.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Itens)
                        {
                            <tr>
                                <td>
                                    <div class="financeiro-v2-student-cell">
                                        <span>@InicialAluno(item.Aluno)</span>
                                        <div>
                                            <a asp-action="HistoricoAluno" asp-route-alunoId="@item.AlunoId">@item.Aluno</a>
                                            <small>Mensalidade #@item.MensalidadeId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.Competencia.ToString("MM/yyyy")</td>
                                <td>@item.DataVencimento.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="financeiro-v2-status-pill @AtrasoClasse(item.DiasAtraso)">
                                        @item.DiasAtraso dia(s)
                                    </span>
                                </td>
                                <td class="text-end fw-bold">@item.ValorFinal.ToString("C")</td>
                                <td class="text-end">
                                    <div class="financeiro-v2-row-actions">
                                        <a asp-action="HistoricoAluno"
                                           asp-route-alunoId="@item.AlunoId"
                                           class="btn financeiro-v2-btn-table">
                                            Histórico
                                        </a>
                                        @if (canFinanceiroCreate)
                                        {
                                            <a asp-action="RegistrarPagamento"
                                               asp-route-mensalidadeId="@item.MensalidadeId"
                                               asp-route-returnUrl="@returnUrl"
                                               class="btn financeiro-v2-btn-table financeiro-v2-btn-table-primary">
                                                Registrar
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
