@model RegistrarPagamentoViewModel
@{
    ViewData["Title"] = "Registrar Pagamento";
}

<div class="financeiro-page">
    @if (!string.IsNullOrWhiteSpace(Model.AlunoNome))
    {
        <section class="card financeiro-profile-card mb-3">
            <div class="card-body p-3 p-lg-4">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <span class="financeiro-data-label">Aluno</span>
                        <strong class="financeiro-data-value">@Model.AlunoNome</strong>
                    </div>
                    <div class="col-12 col-md-2">
                        <span class="financeiro-data-label">Competência</span>
                        <strong class="financeiro-data-value">@(Model.Competencia?.ToString("MM/yyyy") ?? "-")</strong>
                    </div>
                    <div class="col-12 col-md-2">
                        <span class="financeiro-data-label">Vencimento</span>
                        <strong class="financeiro-data-value">@(Model.DataVencimento?.ToString("dd/MM/yyyy") ?? "-")</strong>
                    </div>
                    <div class="col-12 col-md-2">
                        <span class="financeiro-data-label">Status</span>
                        <strong class="financeiro-data-value">@(Model.StatusMensalidadeAtual?.ToString() ?? "-")</strong>
                    </div>
                    <div class="col-12 col-md-2">
                        <span class="financeiro-data-label">Valor atual</span>
                        <strong class="financeiro-data-value">@(Model.ValorMensalidadeAtual?.ToString("C") ?? "-")</strong>
                    </div>
                </div>
            </div>
        </section>
    }

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <section class="card financeiro-form-card">
                <div class="card-header">
                    <div>
                        <h2 class="financeiro-section-title mb-1">Lançamento de pagamento</h2>
                        <p class="financeiro-section-subtitle mb-0">Preencha os dados e confirme para atualizar automaticamente a mensalidade.</p>
                    </div>
                </div>

                <div class="card-body">
                    <form asp-action="RegistrarPagamento" method="post" class="row g-3">
                        <input asp-for="AlunoNome" type="hidden" />
                        <input asp-for="Competencia" type="hidden" />
                        <input asp-for="DataVencimento" type="hidden" />
                        <input asp-for="ValorMensalidadeAtual" type="hidden" />
                        <input asp-for="StatusMensalidadeAtual" type="hidden" />
                        <input asp-for="ReturnUrl" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-12 col-md-3">
                            <label asp-for="AlunoId" class="form-label financeiro-label">Aluno ID</label>
                            <input asp-for="AlunoId" type="number" min="1" class="form-control" />
                            <span asp-validation-for="AlunoId" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="MensalidadeId" class="form-label financeiro-label">Mensalidade ID</label>
                            <input asp-for="MensalidadeId" type="number" min="1" class="form-control" />
                            <span asp-validation-for="MensalidadeId" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="DataPagamento" class="form-label financeiro-label">Data do pagamento</label>
                            <input asp-for="DataPagamento" type="datetime-local" class="form-control" />
                        </div>
                        <div class="col-12 col-md-3">
                            <label asp-for="ValorPago" class="form-label financeiro-label">Valor pago</label>
                            <input asp-for="ValorPago" type="number" min="0.01" step="0.01" class="form-control" placeholder="0,00" />
                            <span asp-validation-for="ValorPago" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="FormaPagamento" class="form-label financeiro-label">Forma de pagamento</label>
                            <select asp-for="FormaPagamento" asp-items="Html.GetEnumSelectList<FormaPagamentoEnum>()" class="form-select"></select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Observacoes" class="form-label financeiro-label">Observações</label>
                            <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Informações complementares do recebimento"></textarea>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 financeiro-form-actions">
                            @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                            {
                                <a href="@Model.ReturnUrl" class="btn btn-outline-secondary">Cancelar</a>
                            }
                            else
                            {
                                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            }
                            <button type="submit" class="btn btn-primary">Registrar pagamento</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <aside class="card financeiro-side-card">
                <div class="card-body">
                    <h3 class="financeiro-section-title mb-3">Checklist de conferência</h3>
                    <ul class="financeiro-priority-list">
                        <li>Confirme se a mensalidade e o aluno estão corretos.</li>
                        <li>Valide valor pago e forma antes de salvar.</li>
                        <li>Use observações para registrar exceções do acordo.</li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
