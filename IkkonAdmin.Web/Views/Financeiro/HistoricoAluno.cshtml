@using IkkonAdmin.Web.Security
@model FinanceiroHistoricoAlunoViewModel
@{
    ViewData["Title"] = "Histórico Financeiro";
    var canFinanceiroCreate = User.HasPermission(AppPermissions.FinanceiroCreate);
    var canAlunosView = User.HasPermission(AppPermissions.AlunosView);
}

@functions {
    private static string MensalidadeStatusClass(StatusMensalidadeEnum status)
    {
        return status switch
        {
            StatusMensalidadeEnum.Pago => "financeiro-status-pill financeiro-status-success",
            StatusMensalidadeEnum.Atrasado => "financeiro-status-pill financeiro-status-danger",
            StatusMensalidadeEnum.Cancelado => "financeiro-status-pill financeiro-status-muted",
            _ => "financeiro-status-pill financeiro-status-warning"
        };
    }
}

<div class="financeiro-page">
    <section class="card financeiro-profile-card mb-3">
        <div class="card-body p-3 p-lg-4">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
                <div>
                    <div class="financeiro-eyebrow">Aluno</div>
                    <h2 class="financeiro-title mb-1">@Model.AlunoNome</h2>
                    <p class="financeiro-subtitle mb-0">Turma: @(string.IsNullOrWhiteSpace(Model.Turma) ? "Sem turma" : Model.Turma)</p>
                </div>
                <div class="financeiro-profile-kpis">
                    <article class="financeiro-mini-kpi">
                        <span class="financeiro-kpi-label">Total pago</span>
                        <strong class="financeiro-kpi-value">@Model.TotalPago.ToString("C")</strong>
                    </article>
                    <article class="financeiro-mini-kpi financeiro-mini-kpi-warning">
                        <span class="financeiro-kpi-label">Total em aberto</span>
                        <strong class="financeiro-kpi-value">@Model.TotalEmAberto.ToString("C")</strong>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <section class="card financeiro-table-card h-100">
                <div class="card-header">
                    <div>
                        <h3 class="financeiro-section-title mb-1">Mensalidades</h3>
                        <p class="financeiro-section-subtitle mb-0">Histórico da evolução de cobrança por competência.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 financeiro-table">
                        <thead>
                            <tr>
                                <th>Competência</th>
                                <th>Vencimento</th>
                                <th>Status</th>
                                <th class="text-end">Valor</th>
                                <th>Pagamento</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Mensalidades.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">Nenhuma mensalidade registrada.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Mensalidades)
                                {
                                    <tr>
                                        <td>@item.Competencia.ToString("MM/yyyy")</td>
                                        <td>@item.DataVencimento.ToString("dd/MM/yyyy")</td>
                                        <td><span class="@MensalidadeStatusClass(item.Status)">@item.Status</span></td>
                                        <td class="text-end">@item.ValorFinal.ToString("C")</td>
                                        <td>@(item.DataPagamento.HasValue ? item.DataPagamento.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        <td class="text-end">
                                            @if (canFinanceiroCreate)
                                            {
                                                <a asp-action="RegistrarPagamento"
                                                   asp-route-mensalidadeId="@item.MensalidadeId"
                                                   asp-route-returnUrl="@Context.Request.Path"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Registrar
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Sem permissão</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-5">
            <section class="card financeiro-table-card h-100">
                <div class="card-header">
                    <div>
                        <h3 class="financeiro-section-title mb-1">Pagamentos</h3>
                        <p class="financeiro-section-subtitle mb-0">Recebimentos registrados com data e forma de pagamento.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 financeiro-table">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Competência</th>
                                <th>Forma</th>
                                <th class="text-end">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Pagamentos.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">Nenhum pagamento registrado.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Pagamentos)
                                {
                                    <tr>
                                        <td>@item.DataPagamento.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@(item.Competencia.HasValue ? item.Competencia.Value.ToString("MM/yyyy") : "-")</td>
                                        <td>@item.FormaPagamento</td>
                                        <td class="text-end">@item.ValorPago.ToString("C")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar financeiro</a>
        @if (canAlunosView)
        {
            <a asp-controller="Alunos" asp-action="Details" asp-route-id="@Model.AlunoId" class="btn btn-outline-primary">Abrir aluno</a>
        }
    </div>
</div>
