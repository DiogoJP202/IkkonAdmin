@model UserSettingsPageViewModel

<article class="configuracoes-v2-card">
    <div class="configuracoes-v2-card-header">
        <div>
            <span class="configuracoes-v2-eyebrow">@I18n["Segurança", "Security"]</span>
            <h2>@I18n["Senha e histórico de acessos", "Password and access history"]</h2>
            <p>@I18n["Altere sua senha e acompanhe eventos recentes de autenticação.", "Change your password and track recent authentication events."]</p>
        </div>
        <span class="configuracoes-v2-status-pill @(Model.SecurityStatus.ContaAtiva ? "is-success" : "is-muted")">
            @(Model.SecurityStatus.ContaAtiva ? I18n["Ativa", "Active"] : I18n["Inativa", "Inactive"])
        </span>
    </div>

    <div class="configuracoes-v2-card-body">
        <div class="configuracoes-v2-security-grid">
            <form asp-action="AlterarSenha" method="post" class="configuracoes-v2-password-form" data-config-form data-reset-on-success="true">
                @Html.AntiForgeryToken()

                <div class="configuracoes-v2-form-grid">
                    <div class="configuracoes-v2-field configuracoes-v2-field-span-2">
                        <label for="SenhaAtual">@I18n["Senha atual", "Current password"]</label>
                        <input type="password"
                               class="form-control configuracoes-v2-control"
                               id="SenhaAtual"
                               name="SenhaAtual"
                               autocomplete="current-password"
                               placeholder="@I18n["Informe sua senha atual", "Enter your current password"]" />
                        <span class="text-danger small field-error" data-field-error="SenhaAtual"></span>
                    </div>

                    <div class="configuracoes-v2-field">
                        <label for="NovaSenha">@I18n["Nova senha", "New password"]</label>
                        <input type="password"
                               class="form-control configuracoes-v2-control"
                               id="NovaSenha"
                               name="NovaSenha"
                               autocomplete="new-password"
                               placeholder="@I18n["Mínimo de 8 caracteres", "At least 8 characters"]" />
                        <span class="text-danger small field-error" data-field-error="NovaSenha"></span>
                    </div>

                    <div class="configuracoes-v2-field">
                        <label for="ConfirmacaoNovaSenha">@I18n["Confirmar nova senha", "Confirm new password"]</label>
                        <input type="password"
                               class="form-control configuracoes-v2-control"
                               id="ConfirmacaoNovaSenha"
                               name="ConfirmacaoNovaSenha"
                               autocomplete="new-password"
                               placeholder="@I18n["Repita a nova senha", "Repeat the new password"]" />
                        <span class="text-danger small field-error" data-field-error="ConfirmacaoNovaSenha"></span>
                    </div>
                </div>

                <div class="configuracoes-v2-form-actions">
                    <button type="submit" class="btn configuracoes-v2-btn configuracoes-v2-btn-primary" data-loading-text="@I18n["Atualizando...", "Updating..."]">@I18n["Alterar senha", "Change password"]</button>
                </div>
            </form>

            <aside class="configuracoes-v2-security-summary">
                <article>
                    <span>@I18n["Status da conta", "Account status"]</span>
                    <strong>@(Model.SecurityStatus.ContaAtiva ? I18n["Ativa", "Active"] : I18n["Inativa", "Inactive"])</strong>
                </article>
                <article>
                    <span>@I18n["Último login", "Last login"]</span>
                    <strong>@(Model.SecurityStatus.UltimoLoginUtc.HasValue ? Model.SecurityStatus.UltimoLoginUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : I18n["Sem registro", "No record"])</strong>
                </article>
            </aside>
        </div>

        <div class="configuracoes-v2-history-block">
            <div class="configuracoes-v2-subheading">
                <span>@I18n["Histórico", "History"]</span>
                <h3>@I18n["Acessos recentes", "Recent access"]</h3>
            </div>

            <div class="table-responsive">
                <table class="table configuracoes-v2-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@I18n["Data e hora", "Date and time"]</th>
                            <th>IP</th>
                            <th>@I18n["Evento", "Event"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SecurityStatus.HistoricoAcessos.Count == 0)
                        {
                            <tr>
                                <td colspan="3">
                                    <div class="configuracoes-v2-empty-state">
                                        <strong>@I18n["Nenhum acesso registrado", "No access registered"]</strong>
                                        <span>@I18n["Quando houver autenticações registradas, elas aparecerão aqui.", "When authentications are registered, they will appear here."]</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var acesso in Model.SecurityStatus.HistoricoAcessos)
                            {
                                <tr>
                                    <td>@acesso.DataAcessoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>@(string.IsNullOrWhiteSpace(acesso.EnderecoIp) ? "-" : acesso.EnderecoIp)</td>
                                    <td>@acesso.Descricao</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</article>
