@model UserSettingsPageViewModel

<article class="configuracoes-v2-card">
    <div class="configuracoes-v2-card-header">
        <div>
            <span class="configuracoes-v2-eyebrow">Dados da conta</span>
            <h2>Informações pessoais</h2>
            <p>Atualize nome, e-mail, telefone e foto de perfil usados no sistema.</p>
        </div>
        <span class="configuracoes-v2-status-pill @(Model.AccountInfo.ContaAtiva ? "is-success" : "is-muted")">
            Conta @(Model.AccountInfo.ContaAtiva ? "ativa" : "inativa")
        </span>
    </div>

    <form asp-action="AtualizarConta" method="post" enctype="multipart/form-data" class="configuracoes-v2-card-body" data-config-form>
        @Html.AntiForgeryToken()

        <div class="configuracoes-v2-account-grid">
            <div class="configuracoes-v2-photo-panel">
                <img id="userPhotoPreview"
                     src="@(string.IsNullOrWhiteSpace(Model.AccountInfo.FotoPerfilUrl) ? "/Images/Ikkon_Icon.png" : Model.AccountInfo.FotoPerfilUrl)"
                     alt="Foto de perfil"
                     class="configuracoes-v2-photo" />
                <label for="FotoPerfil" class="btn configuracoes-v2-btn configuracoes-v2-btn-ghost">Alterar foto</label>
                <input id="FotoPerfil" name="FotoPerfil" type="file" accept="image/png,image/jpeg,image/webp" class="d-none" data-photo-input data-photo-preview="#userPhotoPreview" />
                <small>JPG, PNG ou WEBP até 2 MB.</small>
            </div>

            <div class="configuracoes-v2-form-grid">
                <div class="configuracoes-v2-field configuracoes-v2-field-span-2">
                    <label for="NomeCompleto">Nome completo</label>
                    <input class="form-control configuracoes-v2-control"
                           id="NomeCompleto"
                           name="NomeCompleto"
                           value="@Model.AccountInfo.NomeCompleto"
                           maxlength="200"
                           autocomplete="name"
                           placeholder="Ex.: Maria Fernanda Sato" />
                    <span class="text-danger small field-error" data-field-error="NomeCompleto"></span>
                </div>

                <div class="configuracoes-v2-field">
                    <label for="Email">E-mail</label>
                    <input type="email"
                           class="form-control configuracoes-v2-control"
                           id="Email"
                           name="Email"
                           value="@Model.AccountInfo.Email"
                           maxlength="150"
                           autocomplete="email"
                           placeholder="nome@email.com" />
                    <span class="text-danger small field-error" data-field-error="Email"></span>
                </div>

                <div class="configuracoes-v2-field">
                    <label for="Telefone">Telefone</label>
                    <input type="tel"
                           class="form-control configuracoes-v2-control"
                           id="Telefone"
                           name="Telefone"
                           value="@Model.AccountInfo.Telefone"
                           maxlength="30"
                           inputmode="tel"
                           autocomplete="tel-national"
                           placeholder="(11) 99999-9999" />
                    <span class="text-danger small field-error" data-field-error="Telefone"></span>
                </div>
            </div>
        </div>

        <div class="configuracoes-v2-form-actions">
            <button type="submit" class="btn configuracoes-v2-btn configuracoes-v2-btn-primary" data-loading-text="Salvando...">Salvar alterações</button>
        </div>
    </form>
</article>
