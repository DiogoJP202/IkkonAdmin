@model UserSettingsPageViewModel

<article class="configuracoes-v2-card">
    <div class="configuracoes-v2-card-header">
        <div>
            <span class="configuracoes-v2-eyebrow">@I18n["Preferências", "Preferences", "設定"]</span>
            <h2>@I18n["Experiência de uso", "User experience", "表示と通知"]</h2>
            <p>@I18n["Defina tema e canais de notificação para o uso diário.", "Set theme and notification channels for daily use.", "日常利用のテーマと通知方法を設定できます。"]</p>
        </div>
    </div>

    <form asp-action="AtualizarPreferencias" method="post" class="configuracoes-v2-card-body" data-config-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="IdiomaPreferencia" value="@Model.Preferences.IdiomaPreferencia" />

        <div class="configuracoes-v2-form-grid">
            <div class="configuracoes-v2-field">
                <label for="TemaPreferencia">@I18n["Tema", "Theme", "テーマ"]</label>
                <select class="form-select configuracoes-v2-control" id="TemaPreferencia" name="TemaPreferencia">
                    @if (Model.Preferences.TemaPreferencia == TemaPreferenciaEnum.Claro)
                    {
                        <option value="@TemaPreferenciaEnum.Claro" selected>@I18n["Claro", "Light", "ライト"]</option>
                        <option value="@TemaPreferenciaEnum.Escuro">@I18n["Escuro", "Dark", "ダーク"]</option>
                    }
                    else
                    {
                        <option value="@TemaPreferenciaEnum.Claro">@I18n["Claro", "Light", "ライト"]</option>
                        <option value="@TemaPreferenciaEnum.Escuro" selected>@I18n["Escuro", "Dark", "ダーク"]</option>
                    }
                </select>
            </div>
        </div>

        <div class="configuracoes-v2-check-grid mt-3">
            <label class="configuracoes-v2-check-card">
                <input class="form-check-input" type="checkbox" id="NotificarEmail" name="NotificarEmail" value="true" @(Model.Preferences.NotificarEmail ? "checked" : null) />
                <input type="hidden" name="NotificarEmail" value="false" />
                <span>
                    <strong>@I18n["Notificações por e-mail", "Email notifications", "メール通知"]</strong>
                    <small>@I18n["Receber avisos e comunicações importantes por e-mail.", "Receive important notices and communications by email.", "重要なお知らせをメールで受け取ります。"]</small>
                </span>
            </label>

            <label class="configuracoes-v2-check-card">
                <input class="form-check-input" type="checkbox" id="NotificarSistema" name="NotificarSistema" value="true" @(Model.Preferences.NotificarSistema ? "checked" : null) />
                <input type="hidden" name="NotificarSistema" value="false" />
                <span>
                    <strong>@I18n["Notificações no sistema", "In-system notifications", "システム内通知"]</strong>
                    <small>@I18n["Receber alertas e mensagens dentro do painel.", "Receive alerts and messages inside the panel.", "ポータル内で通知やメッセージを受け取ります。"]</small>
                </span>
            </label>
        </div>

        <div class="configuracoes-v2-form-actions">
            <button type="submit" class="btn configuracoes-v2-btn configuracoes-v2-btn-primary" data-loading-text="@I18n["Salvando...", "Saving...", "保存中..."]">@I18n["Salvar preferências", "Save preferences", "設定を保存"]</button>
        </div>
    </form>
</article>
