@model UserSettingsPageViewModel

<article class="configuracoes-v2-card">
    <div class="configuracoes-v2-card-header">
        <div>
            <span class="configuracoes-v2-eyebrow">Preferências</span>
            <h2>Experiência de uso</h2>
            <p>Defina tema, idioma e canais de notificação para o uso diário.</p>
        </div>
    </div>

    <form asp-action="AtualizarPreferencias" method="post" class="configuracoes-v2-card-body" data-config-form>
        @Html.AntiForgeryToken()

        <div class="configuracoes-v2-form-grid">
            <div class="configuracoes-v2-field">
                <label for="TemaPreferencia">Tema</label>
                <select class="form-select configuracoes-v2-control" id="TemaPreferencia" name="TemaPreferencia">
                    @if (Model.Preferences.TemaPreferencia == TemaPreferenciaEnum.Claro)
                    {
                        <option value="@TemaPreferenciaEnum.Claro" selected>Claro</option>
                        <option value="@TemaPreferenciaEnum.Escuro">Escuro</option>
                    }
                    else
                    {
                        <option value="@TemaPreferenciaEnum.Claro">Claro</option>
                        <option value="@TemaPreferenciaEnum.Escuro" selected>Escuro</option>
                    }
                </select>
            </div>

            <div class="configuracoes-v2-field">
                <label for="IdiomaPreferencia">Idioma</label>
                <select class="form-select configuracoes-v2-control" id="IdiomaPreferencia" name="IdiomaPreferencia">
                    @if (Model.Preferences.IdiomaPreferencia == IdiomaPreferenciaEnum.PtBr)
                    {
                        <option value="@IdiomaPreferenciaEnum.PtBr" selected>Português (Brasil)</option>
                        <option value="@IdiomaPreferenciaEnum.EnUs">English (US)</option>
                    }
                    else
                    {
                        <option value="@IdiomaPreferenciaEnum.PtBr">Português (Brasil)</option>
                        <option value="@IdiomaPreferenciaEnum.EnUs" selected>English (US)</option>
                    }
                </select>
            </div>
        </div>

        <div class="configuracoes-v2-check-grid mt-3">
            <label class="configuracoes-v2-check-card">
                <input class="form-check-input" type="checkbox" id="NotificarEmail" name="NotificarEmail" value="true" @(Model.Preferences.NotificarEmail ? "checked" : null) />
                <input type="hidden" name="NotificarEmail" value="false" />
                <span>
                    <strong>Notificações por e-mail</strong>
                    <small>Receber avisos e comunicações importantes por e-mail.</small>
                </span>
            </label>

            <label class="configuracoes-v2-check-card">
                <input class="form-check-input" type="checkbox" id="NotificarSistema" name="NotificarSistema" value="true" @(Model.Preferences.NotificarSistema ? "checked" : null) />
                <input type="hidden" name="NotificarSistema" value="false" />
                <span>
                    <strong>Notificações no sistema</strong>
                    <small>Receber alertas e mensagens dentro do painel.</small>
                </span>
            </label>
        </div>

        <div class="configuracoes-v2-form-actions">
            <button type="submit" class="btn configuracoes-v2-btn configuracoes-v2-btn-primary" data-loading-text="Salvando...">Salvar preferências</button>
        </div>
    </form>
</article>
