@model UserSettingsPageViewModel

<section class="configuracoes-v2-side-card">
    <span class="configuracoes-v2-eyebrow">Tipo de conta</span>
    <h2>Perfil e permissões</h2>
    <p>Informações de acesso definidas pelo administrador do sistema.</p>

    <div class="configuracoes-v2-account-type-box">
        <span>Perfil atual</span>
        <strong>@Model.AccountType.NomeTipoConta</strong>
    </div>

    <div class="configuracoes-v2-permissions-box">
        <span>Permissões básicas</span>
        <ul>
            @foreach (var permission in Model.AccountType.PermissoesBasicas)
            {
                <li>@permission</li>
            }
        </ul>
    </div>
</section>
