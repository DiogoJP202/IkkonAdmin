@using IkkonAdmin.Web.Security
@model AdmissaoDetalhesViewModel
@{
    ViewData["Title"] = "Detalhes da Admissão";

    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var canAdmissoesEdit = User.HasPermission(AppPermissions.AdmissoesEdit);
    var canAdmissoesCreate = User.HasPermission(AppPermissions.AdmissoesCreate);
    var canAlunosView = User.HasPermission(AppPermissions.AlunosView);
    var checklistConcluido = (Model.ContratoAssinado ? 1 : 0) + (Model.PagamentoInicialConfirmado ? 1 : 0) + (Model.IntegracaoConcluida ? 1 : 0);
    var percentualChecklist = (checklistConcluido * 100) / 3;
    var inicialPessoa = string.IsNullOrWhiteSpace(Model.NomeInteressado)
        ? "A"
        : Model.NomeInteressado.Trim()[0].ToString().ToUpperInvariant();
}

@functions {
    private static string StatusTexto(StatusAdmissaoEnum status)
    {
        return status switch
        {
            StatusAdmissaoEnum.AulaExperimentalAgendada => "Aula experimental agendada",
            StatusAdmissaoEnum.EmAndamento => "Em andamento",
            StatusAdmissaoEnum.Matriculado => "Matriculado",
            StatusAdmissaoEnum.Cancelado => "Cancelado",
            _ => status.ToString()
        };
    }

    private static string StatusClasse(StatusAdmissaoEnum status)
    {
        return status switch
        {
            StatusAdmissaoEnum.Matriculado => "is-success",
            StatusAdmissaoEnum.Cancelado => "is-muted",
            StatusAdmissaoEnum.EmAndamento => "is-warning",
            _ => "is-info"
        };
    }
}

<div class="admissoes-v2-page">
    <section class="admissoes-v2-profile-hero mb-4">
        <div class="admissoes-v2-profile-title">
            <div class="admissoes-v2-avatar">@inicialPessoa</div>
            <div>
                <span class="admissoes-v2-eyebrow">Detalhes do processo</span>
                <h1>@Model.NomeInteressado</h1>
                <div class="admissoes-v2-meta">
                    <span>Processo <strong>#@Model.Id</strong></span>
                    <span>Aula <strong>@Model.DataAulaExperimental.ToString("dd/MM/yyyy")</strong></span>
                    @if (Model.DataMatricula.HasValue)
                    {
                        <span>Matrícula <strong>@Model.DataMatricula.Value.ToString("dd/MM/yyyy")</strong></span>
                    }
                </div>
            </div>
        </div>

        <div class="admissoes-v2-hero-actions">
            <span class="admissoes-v2-status-pill @StatusClasse(Model.Status)">
                @StatusTexto(Model.Status)
            </span>
            @if (Model.AlunoId.HasValue && canAlunosView)
            {
                <a asp-controller="Alunos" asp-action="Details" asp-route-id="@Model.AlunoId" class="btn admissoes-v2-btn admissoes-v2-btn-ghost">Abrir aluno</a>
            }
            <a asp-action="Index" class="btn admissoes-v2-btn admissoes-v2-btn-ghost">Voltar</a>
        </div>
    </section>

    <section class="admissoes-v2-kpi-grid mb-4" aria-label="Resumo da admissão">
        <article class="admissoes-v2-kpi-card is-warning">
            <div class="admissoes-v2-kpi-top">
                <span>Checklist</span>
                <b>@percentualChecklist%</b>
            </div>
            <strong>@checklistConcluido/3</strong>
            <small>Etapas básicas concluídas.</small>
        </article>

        <article class="admissoes-v2-kpi-card @(Model.AlunoId.HasValue ? "is-success" : "is-danger")">
            <div class="admissoes-v2-kpi-top">
                <span>Vínculo aluno</span>
                <b>Matrícula</b>
            </div>
            <strong>@(Model.AlunoId.HasValue ? "Sim" : "Não")</strong>
            <small>@(Model.AlunoId.HasValue ? "Cadastro de aluno vinculado." : "Ainda precisa criar matrícula.")</small>
        </article>

        <article class="admissoes-v2-kpi-card">
            <div class="admissoes-v2-kpi-top">
                <span>Status atual</span>
                <b>Fase</b>
            </div>
            <strong>@StatusTexto(Model.Status)</strong>
            <small>Etapa operacional do processo.</small>
        </article>

        <article class="admissoes-v2-kpi-card">
            <div class="admissoes-v2-kpi-top">
                <span>Aula experimental</span>
                <b>Data</b>
            </div>
            <strong>@Model.DataAulaExperimental.ToString("dd/MM")</strong>
            <small>@Model.DataAulaExperimental.ToString("dd/MM/yyyy")</small>
        </article>
    </section>

    <div class="admissoes-v2-details-grid">
        <section class="admissoes-v2-form-panel">
            <div class="admissoes-v2-panel-heading">
                <div>
                    <span class="admissoes-v2-eyebrow">Processo</span>
                    <h2>Status e checklist</h2>
                    <p>Atualize a situação da admissão e as etapas de contrato, pagamento e integração.</p>
                </div>
            </div>

            <div class="admissoes-v2-form">
                @if (canAdmissoesEdit)
                {
                    <form asp-action="AtualizarProcesso" method="post" class="admissoes-v2-inline-process-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <section class="admissoes-v2-form-section">
                            <div class="admissoes-v2-form-grid">
                                <div class="admissoes-v2-field">
                                    <label for="status">Status</label>
                                    <select id="status" name="status" class="form-select admissoes-v2-control">
                                        @foreach (var status in Enum.GetValues<StatusAdmissaoEnum>())
                                        {
                                            if (Model.Status == status)
                                            {
                                                <option value="@status" selected>@StatusTexto(status)</option>
                                            }
                                            else
                                            {
                                                <option value="@status">@StatusTexto(status)</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="admissoes-v2-checklist-summary">
                                    <span>Checklist concluído</span>
                                    <div class="admissoes-v2-progress" role="progressbar" aria-label="Progresso do checklist" aria-valuenow="@checklistConcluido" aria-valuemin="0" aria-valuemax="3">
                                        <span style="width:@percentualChecklist%"></span>
                                    </div>
                                    <strong>@checklistConcluido/3 etapas</strong>
                                </div>
                            </div>
                        </section>

                        <section class="admissoes-v2-form-section">
                            <div class="admissoes-v2-check-grid">
                                <label class="admissoes-v2-check-card">
                                    @if (Model.ContratoAssinado)
                                    {
                                        <input type="checkbox" name="contratoAssinado" value="true" checked />
                                    }
                                    else
                                    {
                                        <input type="checkbox" name="contratoAssinado" value="true" />
                                    }
                                    <span>
                                        <strong>Contrato assinado</strong>
                                        <small>Documento recebido ou assinatura confirmada.</small>
                                    </span>
                                </label>

                                <label class="admissoes-v2-check-card">
                                    @if (Model.PagamentoInicialConfirmado)
                                    {
                                        <input type="checkbox" name="pagamentoInicialConfirmado" value="true" checked />
                                    }
                                    else
                                    {
                                        <input type="checkbox" name="pagamentoInicialConfirmado" value="true" />
                                    }
                                    <span>
                                        <strong>Pagamento inicial confirmado</strong>
                                        <small>Entrada financeira validada pela equipe.</small>
                                    </span>
                                </label>

                                <label class="admissoes-v2-check-card">
                                    @if (Model.IntegracaoConcluida)
                                    {
                                        <input type="checkbox" name="integracaoConcluida" value="true" checked />
                                    }
                                    else
                                    {
                                        <input type="checkbox" name="integracaoConcluida" value="true" />
                                    }
                                    <span>
                                        <strong>Integração concluída</strong>
                                        <small>Boas-vindas, grupos, horários e orientações iniciais.</small>
                                    </span>
                                </label>
                            </div>
                        </section>

                        <section class="admissoes-v2-form-section">
                            <div class="admissoes-v2-field">
                                <label for="checklistObservacoes">Observações</label>
                                <textarea class="form-control admissoes-v2-control"
                                          id="checklistObservacoes"
                                          name="checklistObservacoes"
                                          rows="4"
                                          placeholder="Contexto interno, pendências e próximos passos.">@Model.ChecklistObservacoes</textarea>
                            </div>
                        </section>

                        <div class="admissoes-v2-form-actions">
                            <button type="submit" class="btn admissoes-v2-btn admissoes-v2-btn-primary">Salvar processo</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="admissoes-v2-alert-card">
                        <strong>Sem permissão de edição</strong>
                        <span>Você pode visualizar este processo, mas não pode alterar status ou checklist.</span>
                    </div>
                }
            </div>
        </section>

        <aside class="admissoes-v2-side-stack">
            <section class="admissoes-v2-side-card">
                <span class="admissoes-v2-eyebrow">Matrícula</span>
                <h2>Conversão em aluno</h2>

                @if (Model.AlunoId.HasValue)
                {
                    <div class="admissoes-v2-concluded-box">
                        <strong>Matrícula criada</strong>
                        <span>Aluno vinculado: @(Model.AlunoNome ?? $"Aluno #{Model.AlunoId}")</span>
                        @if (canAlunosView)
                        {
                            <a asp-controller="Alunos" asp-action="Details" asp-route-id="@Model.AlunoId" class="btn admissoes-v2-btn admissoes-v2-btn-ghost">Abrir perfil</a>
                        }
                    </div>
                }
                else if (canAdmissoesCreate)
                {
                    <form asp-action="CriarMatricula" asp-route-id="@Model.Id" method="post" class="admissoes-v2-matricula-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="admissoes-v2-validation-summary"></div>

                        <div class="admissoes-v2-field">
                            <label asp-for="Matricula.CPF">CPF</label>
                            <input asp-for="Matricula.CPF"
                                   class="form-control admissoes-v2-control"
                                   inputmode="numeric"
                                   placeholder="000.000.000-00"
                                   autocomplete="off"
                                   maxlength="14" />
                            <span asp-validation-for="Matricula.CPF" class="text-danger"></span>
                        </div>

                        <div class="admissoes-v2-field">
                            <label asp-for="Matricula.RG">RG</label>
                            <input asp-for="Matricula.RG"
                                   class="form-control admissoes-v2-control"
                                   placeholder="Ex.: 12.345.678-9"
                                   autocomplete="off"
                                   maxlength="20" />
                            <span asp-validation-for="Matricula.RG" class="text-danger"></span>
                        </div>

                        <div class="admissoes-v2-field">
                            <label asp-for="Matricula.DataNascimento">Data de nascimento</label>
                            <input asp-for="Matricula.DataNascimento"
                                   type="date"
                                   class="form-control admissoes-v2-control" />
                            <span asp-validation-for="Matricula.DataNascimento" class="text-danger"></span>
                        </div>

                        <div class="admissoes-v2-field">
                            <label asp-for="Matricula.Celular">Celular</label>
                            <input asp-for="Matricula.Celular"
                                   class="form-control admissoes-v2-control"
                                   type="tel"
                                   inputmode="tel"
                                   placeholder="(11) 99999-9999"
                                   autocomplete="tel-national"
                                   maxlength="20" />
                            <span asp-validation-for="Matricula.Celular" class="text-danger"></span>
                        </div>

                        <div class="admissoes-v2-field">
                            <label asp-for="Matricula.Email">E-mail</label>
                            <input asp-for="Matricula.Email"
                                   type="email"
                                   class="form-control admissoes-v2-control"
                                   placeholder="nome@email.com"
                                   autocomplete="email"
                                   maxlength="150" />
                            <span asp-validation-for="Matricula.Email" class="text-danger"></span>
                        </div>

                        <div class="admissoes-v2-field">
                            <label asp-for="Matricula.Endereco">Endereço</label>
                            <input asp-for="Matricula.Endereco"
                                   class="form-control admissoes-v2-control"
                                   placeholder="Rua, número, bairro e cidade"
                                   autocomplete="street-address"
                                   maxlength="200" />
                            <span asp-validation-for="Matricula.Endereco" class="text-danger"></span>
                        </div>

                        <div class="admissoes-v2-field">
                            <label asp-for="Matricula.ContatoEmergencia">Contato de emergência</label>
                            <input asp-for="Matricula.ContatoEmergencia"
                                   class="form-control admissoes-v2-control"
                                   placeholder="Nome, parentesco e telefone"
                                   autocomplete="off"
                                   maxlength="150" />
                            <span asp-validation-for="Matricula.ContatoEmergencia" class="text-danger"></span>
                        </div>

                        <div class="admissoes-v2-field">
                            <label asp-for="Matricula.TurmaId">Turma inicial</label>
                            <select asp-for="Matricula.TurmaId" class="form-select admissoes-v2-control">
                                <option value="">Sem turma definida</option>
                                @foreach (var turma in Model.Turmas)
                                {
                                    if (Model.Matricula.TurmaId == turma.Id)
                                    {
                                        <option value="@turma.Id" selected>@turma.Nome</option>
                                    }
                                    else
                                    {
                                        <option value="@turma.Id">@turma.Nome</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Matricula.TurmaId" class="text-danger"></span>
                        </div>

                        <div class="admissoes-v2-field">
                            <label asp-for="Matricula.ObservacoesAluno">Observações do aluno</label>
                            <textarea asp-for="Matricula.ObservacoesAluno"
                                      rows="3"
                                      class="form-control admissoes-v2-control"
                                      placeholder="Informações úteis para o acompanhamento inicial."></textarea>
                            <span asp-validation-for="Matricula.ObservacoesAluno" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn admissoes-v2-btn admissoes-v2-btn-primary w-100">Criar matrícula</button>
                    </form>
                }
                else
                {
                    <div class="admissoes-v2-alert-card">
                        <strong>Sem permissão</strong>
                        <span>Você não possui permissão para criar matrícula.</span>
                    </div>
                }
            </section>

            <section class="admissoes-v2-assist-card admissoes-v2-assist-card-compact">
                <span class="admissoes-v2-eyebrow">Próximos passos</span>
                <h2>Critérios de avanço</h2>
                <ul>
                    <li>Use “Matriculado” apenas depois da criação do aluno.</li>
                    <li>Evite avançar com pendências de contrato ou pagamento inicial.</li>
                    <li>Registre contexto curto para facilitar handoff entre funcionários.</li>
                </ul>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
