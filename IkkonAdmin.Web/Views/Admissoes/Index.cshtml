@using IkkonAdmin.Web.Security
@model AdmissaoIndexViewModel
@{
    ViewData["Title"] = "Admissões";

    var canAdmissoesCreate = User.HasPermission(AppPermissions.AdmissoesCreate);
    var canAlunosCreate = User.HasPermission(AppPermissions.AlunosCreate);
    var canFinanceiroView = User.HasPermission(AppPermissions.FinanceiroView);
    var canAlunosView = User.HasPermission(AppPermissions.AlunosView);

    var hoje = DateOnly.FromDateTime(DateTime.Today);
    var total = Model.Admissoes.Count;
    var emAndamento = Model.Admissoes.Count(x => x.Status == StatusAdmissaoEnum.EmAndamento);
    var matriculados = Model.Admissoes.Count(x => x.Status == StatusAdmissaoEnum.Matriculado);
    var cancelados = Model.Admissoes.Count(x => x.Status == StatusAdmissaoEnum.Cancelado);
    var pendentesChecklist = Model.Admissoes.Count(x => x.ChecklistConcluido < 3 && x.Status != StatusAdmissaoEnum.Cancelado);
    var semMatricula = Model.Admissoes.Count(x => !x.AlunoId.HasValue && x.Status != StatusAdmissaoEnum.Cancelado);
    var aulasFuturas = Model.Admissoes.Count(x => x.Status != StatusAdmissaoEnum.Cancelado && x.DataAulaExperimental >= hoje);
    var proximasAulas = Model.Admissoes
        .Where(x => x.Status != StatusAdmissaoEnum.Cancelado && x.DataAulaExperimental >= hoje)
        .OrderBy(x => x.DataAulaExperimental)
        .Take(4)
        .ToList();

    var filtrosAplicados = !string.IsNullOrWhiteSpace(Model.Busca) || Model.Status.HasValue;
}

@functions {
    private static string StatusTexto(StatusAdmissaoEnum status)
    {
        return status switch
        {
            StatusAdmissaoEnum.AulaExperimentalAgendada => "Aula experimental agendada",
            StatusAdmissaoEnum.EmAndamento => "Em andamento",
            StatusAdmissaoEnum.Matriculado => "Matriculado",
            StatusAdmissaoEnum.Cancelado => "Cancelado",
            _ => status.ToString()
        };
    }

    private static string StatusClasse(StatusAdmissaoEnum status)
    {
        return status switch
        {
            StatusAdmissaoEnum.Matriculado => "is-success",
            StatusAdmissaoEnum.Cancelado => "is-muted",
            StatusAdmissaoEnum.EmAndamento => "is-warning",
            _ => "is-info"
        };
    }

    private static string InicialPessoa(string nome)
    {
        return string.IsNullOrWhiteSpace(nome)
            ? "A"
            : nome.Trim()[0].ToString().ToUpperInvariant();
    }
}

<div class="admissoes-v2-page">
    <section class="admissoes-v2-hero mb-4">
        <div class="admissoes-v2-hero-copy">
            <span class="admissoes-v2-eyebrow">Operação de entrada</span>
            <h1>Central de admissões</h1>
            <p>
                Acompanhe aulas experimentais, checklist inicial, criação de matrícula e vínculo com aluno sem perder o contexto do processo.
            </p>

            <div class="admissoes-v2-meta">
                <span>Processos <strong>@total</strong></span>
                <span>Sem matrícula <strong>@semMatricula</strong></span>
                <span>Aulas futuras <strong>@aulasFuturas</strong></span>
            </div>
        </div>

        <div class="admissoes-v2-hero-actions">
            @if (canAdmissoesCreate)
            {
                <a asp-action="Create" class="btn admissoes-v2-btn admissoes-v2-btn-primary">Nova admissão</a>
            }
            @if (canAlunosCreate)
            {
                <a asp-controller="Alunos" asp-action="Create" class="btn admissoes-v2-btn admissoes-v2-btn-ghost">Cadastrar aluno</a>
            }
            @if (canFinanceiroView)
            {
                <a asp-controller="Financeiro" asp-action="Index" class="btn admissoes-v2-btn admissoes-v2-btn-ghost">Financeiro</a>
            }
        </div>
    </section>

    <section class="admissoes-v2-kpi-grid mb-4" aria-label="Indicadores de admissões">
        <article class="admissoes-v2-kpi-card">
            <div class="admissoes-v2-kpi-top">
                <span>Total</span>
                <b>Filtro</b>
            </div>
            <strong>@total</strong>
            <small>@cancelados processo(s) cancelado(s) no recorte.</small>
        </article>

        <article class="admissoes-v2-kpi-card is-warning">
            <div class="admissoes-v2-kpi-top">
                <span>Em andamento</span>
                <b>Ação</b>
            </div>
            <strong>@emAndamento</strong>
            <small>Exigem acompanhamento de contrato, pagamento ou integração.</small>
        </article>

        <article class="admissoes-v2-kpi-card is-danger">
            <div class="admissoes-v2-kpi-top">
                <span>Checklist pendente</span>
                <b>Risco</b>
            </div>
            <strong>@pendentesChecklist</strong>
            <small>Processos com etapas básicas incompletas.</small>
        </article>

        <article class="admissoes-v2-kpi-card is-success">
            <div class="admissoes-v2-kpi-top">
                <span>Matriculados</span>
                <b>Conversão</b>
            </div>
            <strong>@matriculados</strong>
            <small>Processos convertidos em cadastro de aluno.</small>
        </article>
    </section>

    <section class="admissoes-v2-filter-card mb-4">
        <div class="admissoes-v2-card-heading">
            <div>
                <span class="admissoes-v2-eyebrow">Filtros</span>
                <h2>Encontrar processo</h2>
                <p>Busque por interessado ou aluno vinculado e filtre pela fase da admissão.</p>
            </div>
        </div>

        <form asp-action="Index" method="get" class="admissoes-v2-filter-grid">
            <div class="admissoes-v2-field admissoes-v2-field-search">
                <label asp-for="Busca">Busca</label>
                <input asp-for="Busca"
                       type="search"
                       class="form-control admissoes-v2-control"
                       placeholder="Digite nome do interessado ou aluno vinculado"
                       autocomplete="off"
                       inputmode="search" />
            </div>

            <div class="admissoes-v2-field">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" class="form-select admissoes-v2-control">
                    <option value="">Todos os status</option>
                    @foreach (var status in Enum.GetValues<StatusAdmissaoEnum>())
                    {
                        if (Model.Status == status)
                        {
                            <option value="@status" selected>@StatusTexto(status)</option>
                        }
                        else
                        {
                            <option value="@status">@StatusTexto(status)</option>
                        }
                    }
                </select>
            </div>

            <div class="admissoes-v2-filter-actions">
                <button type="submit" class="btn admissoes-v2-btn admissoes-v2-btn-primary">Aplicar filtros</button>
                <a asp-action="Index" class="btn admissoes-v2-btn admissoes-v2-btn-ghost">Limpar</a>
            </div>
        </form>

        @if (filtrosAplicados)
        {
            <div class="admissoes-v2-active-filters">
                @if (!string.IsNullOrWhiteSpace(Model.Busca))
                {
                    <span>Busca: <strong>@Model.Busca</strong></span>
                }
                @if (Model.Status.HasValue)
                {
                    <span>Status: <strong>@StatusTexto(Model.Status.Value)</strong></span>
                }
            </div>
        }
    </section>

    <div class="admissoes-v2-main-grid">
        <section class="admissoes-v2-table-panel">
            <div class="admissoes-v2-panel-heading">
                <div>
                    <span class="admissoes-v2-eyebrow">Fila operacional</span>
                    <h2>Processos de admissão</h2>
                    <p>Priorize processos sem matrícula e com checklist incompleto.</p>
                </div>
                <span class="admissoes-v2-count-pill">@total registro(s)</span>
            </div>

            <div class="table-responsive">
                <table class="table admissoes-v2-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Interessado</th>
                            <th>Aula experimental</th>
                            <th>Status</th>
                            <th>Checklist</th>
                            <th>Matrícula</th>
                            <th>Aluno vinculado</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Admissoes.Count == 0)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="admissoes-v2-empty-state">
                                        <strong>Nenhuma admissão encontrada.</strong>
                                        <span>Ajuste os filtros ou registre uma nova entrada no processo de admissão.</span>
                                        @if (canAdmissoesCreate)
                                        {
                                            <a asp-action="Create" class="btn admissoes-v2-btn admissoes-v2-btn-primary">Nova admissão</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Admissoes)
                            {
                                var linhaCritica = item.ChecklistConcluido < 3 && item.Status == StatusAdmissaoEnum.EmAndamento;
                                var checklistPercentual = (item.ChecklistConcluido * 100) / 3;

                                <tr class="@(linhaCritica ? "is-attention" : string.Empty)">
                                    <td>
                                        <div class="admissoes-v2-person-cell">
                                            <span>@InicialPessoa(item.NomeInteressado)</span>
                                            <div>
                                                <strong>@item.NomeInteressado</strong>
                                                <small>Processo #@item.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.DataAulaExperimental.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="admissoes-v2-status-pill @StatusClasse(item.Status)">
                                            @StatusTexto(item.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="admissoes-v2-progress" role="progressbar" aria-label="Checklist de admissão" aria-valuenow="@item.ChecklistConcluido" aria-valuemin="0" aria-valuemax="3">
                                            <span style="width:@checklistPercentual%"></span>
                                        </div>
                                        <small class="text-muted">@item.ChecklistConcluido/3 etapas</small>
                                    </td>
                                    <td>@(item.DataMatricula.HasValue ? item.DataMatricula.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    <td>
                                        @if (item.AlunoId.HasValue)
                                        {
                                            if (canAlunosView)
                                            {
                                                <a asp-controller="Alunos" asp-action="Details" asp-route-id="@item.AlunoId" class="admissoes-v2-link">
                                                    @(item.AlunoNome ?? $"Aluno #{item.AlunoId}")
                                                </a>
                                            }
                                            else
                                            {
                                                <span>@(item.AlunoNome ?? $"Aluno #{item.AlunoId}")</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Não vinculado</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn admissoes-v2-btn-table admissoes-v2-btn-table-primary">
                                            Gerenciar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <aside class="admissoes-v2-side-card">
            <span class="admissoes-v2-eyebrow">Agenda imediata</span>
            <h2>Próximas aulas experimentais</h2>
            <p>Use esta lista para preparar comunicação, presença e acompanhamento inicial.</p>

            @if (proximasAulas.Count == 0)
            {
                <div class="admissoes-v2-empty-state admissoes-v2-empty-compact">
                    <strong>Sem aulas futuras.</strong>
                    <span>Nenhuma aula experimental futura no filtro atual.</span>
                </div>
            }
            else
            {
                <div class="admissoes-v2-next-list">
                    @foreach (var aula in proximasAulas)
                    {
                        <article>
                            <div>
                                <strong>@aula.NomeInteressado</strong>
                                <span>@aula.DataAulaExperimental.ToString("dd/MM/yyyy") · @StatusTexto(aula.Status)</span>
                            </div>
                            <a asp-action="Details" asp-route-id="@aula.Id">Abrir</a>
                        </article>
                    }
                </div>
            }
        </aside>
    </div>
</div>
