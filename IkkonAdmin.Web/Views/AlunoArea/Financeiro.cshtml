@model AreaAlunoFinanceiroViewModel
@{
    Layout = "_AlunoLayout";
    ViewData["Title"] = I18n["Minhas Mensalidades", "My Monthly Fees"];
}

<section class="aluno-portal-kpis mb-3">
    <article>
        <span>@I18n["Total pago", "Total paid"]</span>
        <strong>@Model.TotalPago.ToString("C")</strong>
    </article>
    <article>
        <span>@I18n["Total em aberto", "Open balance"]</span>
        <strong>@Model.TotalEmAberto.ToString("C")</strong>
    </article>
    <article>
        <span>@I18n["Mensalidades atrasadas", "Overdue monthly fees"]</span>
        <strong>@Model.MensalidadesAtrasadas</strong>
    </article>
</section>

<section class="aluno-portal-panel">
    <div class="aluno-portal-panel-head">
        <div>
            <h3>@I18n["Histórico financeiro", "Financial history"]</h3>
            <p class="mb-0 text-muted">@I18n["Consulta das mensalidades registradas no sistema.", "View monthly fees registered in the system."]</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0 aluno-portal-table">
            <thead>
                <tr>
                    <th>@I18n["Competência", "Period"]</th>
                    <th>@I18n["Vencimento", "Due date"]</th>
                    <th>Status</th>
                    <th>@I18n["Pagamento", "Payment"]</th>
                    <th>@I18n["Forma", "Method"]</th>
                    <th class="text-end">@I18n["Valor", "Amount"]</th>
                    <th class="text-end">@I18n["Comprovante", "Receipt"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Mensalidades.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">@I18n["Nenhuma mensalidade encontrada.", "No monthly fees found."]</td></tr>
                }
                else
                {
                    @foreach (var mensalidade in Model.Mensalidades)
                    {
                        <tr>
                            <td>@mensalidade.Competencia.ToString("MM/yyyy")</td>
                            <td>@mensalidade.DataVencimento.ToString("dd/MM/yyyy")</td>
                            <td><span class="aluno-portal-pill">@I18n.Term(mensalidade.Status)</span></td>
                            <td>@(mensalidade.DataPagamento.HasValue ? mensalidade.DataPagamento.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>@(mensalidade.FormaPagamento.HasValue ? I18n.Term(mensalidade.FormaPagamento.Value) : "-")</td>
                            <td class="text-end">@mensalidade.ValorFinal.ToString("C")</td>
                            <td class="text-end">
                                @if (!string.IsNullOrWhiteSpace(mensalidade.Comprovante))
                                {
                                    <a href="@mensalidade.Comprovante" target="_blank" rel="noopener">@I18n["Abrir", "Open"]</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
