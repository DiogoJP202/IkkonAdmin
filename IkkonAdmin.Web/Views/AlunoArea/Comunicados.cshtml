@model AreaAlunoComunicadosViewModel
@{
    Layout = "_AlunoLayout";
    ViewData["Title"] = I18n["Comunicados", "Announcements"];
}

<section class="aluno-portal-panel">
    <div class="aluno-portal-panel-head">
        <div>
            <h3>@I18n["Comunicados e avisos", "Announcements and notices"]</h3>
            <p class="mb-0 text-muted">@I18n["Avisos direcionados a você, suas turmas ou todos os alunos.", "Notices directed to you, your groups, or all students."]</p>
        </div>
    </div>

    <div class="aluno-portal-list">
        @if (Model.Comunicados.Count == 0)
        {
            <p class="text-muted mb-0">@I18n["Nenhum comunicado ativo.", "No active announcements."]</p>
        }
        else
        {
            @foreach (var comunicado in Model.Comunicados)
            {
                <article class="aluno-portal-list-item">
                    <strong>@comunicado.Titulo @(comunicado.Importante ? I18n["| Importante", "| Important"] : string.Empty)</strong>
                    <span>@comunicado.PublicadoEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") @(comunicado.Lido ? I18n["| Lido", "| Read"] : I18n["| Novo", "| New"])</span>
                    <span>@comunicado.Conteudo</span>
                    @if (!comunicado.Lido)
                    {
                        <form asp-action="MarcarComunicadoLido" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="comunicadoId" value="@comunicado.Id" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">@I18n["Marcar como lido", "Mark as read"]</button>
                        </form>
                    }
                </article>
            }
        }
    </div>
</section>
