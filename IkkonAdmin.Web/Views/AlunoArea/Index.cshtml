@{
    Layout = "_AuthLayout";
}

<div class="auth-page">
    <div class="auth-page-bg" aria-hidden="true"></div>
    <div class="container px-3">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8 col-xl-6">
                <section class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-lg-5">
                        <p class="text-uppercase small fw-semibold text-secondary mb-2">Área do aluno</p>
                        <h2 class="h4 mb-2">Bem-vindo(a) à área exclusiva do aluno</h2>
                        <p class="text-muted mb-4">
                            Esta área já está preparada para receber conteúdos de mensalidades, presença, graduação e comunicados.
                            A implementação completa será evoluída nas próximas etapas.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="/configuracoes" class="btn btn-danger">Abrir minhas configurações</a>
                            <a href="/" class="btn btn-outline-secondary">Voltar ao site institucional</a>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
