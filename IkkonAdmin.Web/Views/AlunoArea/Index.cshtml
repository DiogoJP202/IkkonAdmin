@model AreaAlunoDashboardViewModel
@{
    Layout = "_AlunoLayout";
    ViewData["Title"] = I18n["Área do Aluno", "Student Area"];
}

<div class="aluno-portal-page">
    <section class="aluno-portal-hero">
        <div class="aluno-portal-hero-profile">
            <img class="aluno-portal-avatar"
                 src="@(string.IsNullOrWhiteSpace(Model.FotoPerfilUrl) ? Url.Content("~/Images/Ikkon_Icon.png") : Model.FotoPerfilUrl)"
                 alt="Foto de @Model.NomeCompleto" />
            <div>
                <span class="aluno-portal-eyebrow">@I18n["Olá", "Hello"], @Model.NomeCompleto</span>
                <h2>@I18n["Seu painel de acompanhamento", "Your tracking dashboard"]</h2>
                <p>@I18n["Veja aulas, avisos, documentos, financeiro, frequência e conquistas em um só lugar.", "See classes, announcements, documents, finances, attendance, and achievements in one place."]</p>
            </div>
        </div>
        <span class="aluno-portal-status">@I18n.Term(Model.Status)</span>
    </section>

    @if (Model.Alertas.Count > 0)
    {
        <section class="aluno-portal-alerts mb-3">
            @foreach (var alerta in Model.Alertas)
            {
                <a class="alert alert-@alerta.Tipo d-block text-decoration-none mb-2" href="@(alerta.Url ?? "#")">
                    <strong>@alerta.Titulo</strong>
                    <span class="d-block">@alerta.Descricao</span>
                </a>
            }
        </section>
    }

    <section class="aluno-portal-kpis">
        <article>
            <span>@I18n["Total em aberto", "Open balance"]</span>
            <strong>@Model.TotalEmAberto.ToString("C")</strong>
        </article>
        <article>
            <span>@I18n["Presença", "Attendance"]</span>
            <strong>@Model.PercentualPresenca.ToString("0.#")%</strong>
        </article>
        <article>
            <span>@I18n["Documentos pendentes", "Pending documents"]</span>
            <strong>@Model.DocumentosPendentes</strong>
        </article>
        <article>
            <span>@I18n["Comunicados não lidos", "Unread announcements"]</span>
            <strong>@Model.ComunicadosNaoLidos</strong>
        </article>
    </section>

    <div class="row g-3">
        <div class="col-12 col-xl-7">
            <section class="aluno-portal-panel">
                <div class="aluno-portal-panel-head">
                    <div>
                        <h3>@I18n["Próximas aulas", "Upcoming classes"]</h3>
                        <p class="mb-0 text-muted">@I18n["Agenda vinculada às suas turmas.", "Schedule linked to your groups."]</p>
                    </div>
                    <a href="/area-do-aluno/aulas">@I18n["Ver aulas", "View classes"]</a>
                </div>
                <div class="aluno-portal-list">
                    @if (Model.ProximasAulas.Count == 0)
                    {
                        <p class="text-muted mb-0">@I18n["Nenhuma aula futura cadastrada.", "No upcoming classes registered."]</p>
                    }
                    else
                    {
                        @foreach (var aula in Model.ProximasAulas)
                        {
                            <div class="aluno-portal-list-item">
                                <strong>@aula.Turma</strong>
                                <span>@aula.Inicio.ToString("dd/MM HH:mm") - @aula.Fim.ToString("HH:mm") @(string.IsNullOrWhiteSpace(aula.Local) ? string.Empty : $"| {aula.Local}")</span>
                            </div>
                        }
                    }
                </div>
            </section>

            <section class="aluno-portal-panel mt-3">
                <div class="aluno-portal-panel-head">
                    <h3>@I18n["Mensalidades recentes", "Recent monthly fees"]</h3>
                    <a href="/area-do-aluno/financeiro">@I18n["Ver financeiro", "View finance"]</a>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0 aluno-portal-table">
                        <thead>
                            <tr>
                                <th>@I18n["Competência", "Period"]</th>
                                <th>@I18n["Vencimento", "Due date"]</th>
                                <th>Status</th>
                                <th class="text-end">@I18n["Valor", "Amount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MensalidadesRecentes.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-4">@I18n["Nenhuma mensalidade encontrada.", "No monthly fees found."]</td></tr>
                            }
                            else
                            {
                                @foreach (var mensalidade in Model.MensalidadesRecentes)
                                {
                                    <tr>
                                        <td>@mensalidade.Competencia.ToString("MM/yyyy")</td>
                                        <td>@mensalidade.DataVencimento.ToString("dd/MM/yyyy")</td>
                                        <td><span class="aluno-portal-pill">@I18n.Term(mensalidade.Status)</span></td>
                                        <td class="text-end">@mensalidade.ValorFinal.ToString("C")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-5">
            <section class="aluno-portal-panel">
                <div class="aluno-portal-panel-head">
                    <h3>@I18n["Comunicados recentes", "Recent announcements"]</h3>
                    <a href="/area-do-aluno/comunicados">@I18n["Ver todos", "View all"]</a>
                </div>
                <div class="aluno-portal-list">
                    @if (Model.ComunicadosRecentes.Count == 0)
                    {
                        <p class="text-muted mb-0">@I18n["Nenhum comunicado ativo.", "No active announcements."]</p>
                    }
                    else
                    {
                        @foreach (var comunicado in Model.ComunicadosRecentes)
                        {
                            <div class="aluno-portal-list-item">
                                <strong>@comunicado.Titulo</strong>
                                <span>@comunicado.PublicadoEmUtc.ToLocalTime().ToString("dd/MM/yyyy") @(comunicado.Lido ? I18n["| Lido", "| Read"] : I18n["| Novo", "| New"])</span>
                            </div>
                        }
                    }
                </div>
            </section>

            <section class="aluno-portal-panel mt-3">
                <div class="aluno-portal-panel-head">
                    <h3>@I18n["Eventos importantes", "Important events"]</h3>
                    <a href="/area-do-aluno/eventos">@I18n["Ver eventos", "View events"]</a>
                </div>
                <div class="aluno-portal-list">
                    @if (Model.ProximosEventos.Count == 0)
                    {
                        <p class="text-muted mb-0">@I18n["Nenhum evento futuro cadastrado.", "No upcoming events registered."]</p>
                    }
                    else
                    {
                        @foreach (var evento in Model.ProximosEventos)
                        {
                            <div class="aluno-portal-list-item">
                                <strong>@evento.Titulo</strong>
                                <span>@evento.Inicio.ToString("dd/MM HH:mm") @(evento.Importante ? I18n["| Importante", "| Important"] : string.Empty)</span>
                            </div>
                        }
                    }
                </div>
            </section>

            <section class="aluno-portal-panel mt-3">
                <div class="aluno-portal-panel-head">
                    <h3>@I18n["Atalhos", "Shortcuts"]</h3>
                </div>
                <div class="aluno-portal-actions">
                    <a href="/area-do-aluno/documentos">@I18n["Enviar documentos", "Send documents"]</a>
                    <a href="/area-do-aluno/frequencia">@I18n["Ver frequência", "View attendance"]</a>
                    <a href="/configuracoes">@I18n["Conta e senha", "Account and password"]</a>
                    <a href="/area-do-aluno/conquistas">@I18n["Conquistas", "Achievements"]</a>
                </div>
            </section>
        </div>
    </div>
</div>
