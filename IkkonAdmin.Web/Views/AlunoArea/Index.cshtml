@model AreaAlunoDashboardViewModel
@{
    Layout = "_AlunoLayout";
    ViewData["Title"] = I18n["Área do Aluno", "Student Area", "生徒エリア"];
    var pageHeader = new AlunoPageHeaderViewModel(
        I18n["Visão geral", "Overview", "概要"],
        I18n["Sua jornada na IKKON", "Your journey at IKKON", "IKKONでの歩み"],
        I18n[
            "Acompanhe aulas, frequência, comunicados e todas as informações importantes da sua vida no dojo.",
            "Follow classes, attendance, announcements, and all the important information about your life at the dojo.",
            "レッスン、出席状況、お知らせなど、道場での大切な情報を確認できます。"],
        I18n["Aluno desde", "Student since", "入門日"] + $" {Model.DataEntrada:dd/MM/yyyy}");
    var metrics = new[]
    {
        new AlunoMetricCardViewModel(
            I18n["Total em aberto", "Open balance", "未払い合計"],
            Model.TotalEmAberto.ToString("C"),
            Model.TotalEmAberto > 0 ? "warning" : "success"),
        new AlunoMetricCardViewModel(
            I18n["Presença", "Attendance", "出席率"],
            $"{Model.PercentualPresenca:0.#}%",
            Model.PercentualPresenca >= 75 ? "success" : "warning"),
        new AlunoMetricCardViewModel(
            I18n["Documentos pendentes", "Pending documents", "未提出書類"],
            Model.DocumentosPendentes.ToString(),
            Model.DocumentosPendentes > 0 ? "warning" : "success"),
        new AlunoMetricCardViewModel(
            I18n["Comunicados não lidos", "Unread announcements", "未読のお知らせ"],
            Model.ComunicadosNaoLidos.ToString(),
            Model.ComunicadosNaoLidos > 0 ? "info" : "neutral")
    };
}

<div class="aluno-portal-page">
    <partial name="_AlunoPageHeader" model="pageHeader" />

    <section class="aluno-portal-hero" aria-labelledby="alunoWelcomeTitle">
        <div class="aluno-portal-hero-profile">
            <img class="aluno-portal-avatar"
                 src="@(string.IsNullOrWhiteSpace(Model.FotoPerfilUrl) ? Url.Content("~/Images/Ikkon_Icon.png") : Model.FotoPerfilUrl)"
                 alt="@I18n["Foto de", "Photo of", "写真："] @Model.NomeCompleto" />
            <div>
                <p class="aluno-portal-kicker">@I18n["Olá", "Hello", "こんにちは"]</p>
                <h2 id="alunoWelcomeTitle">@Model.NomeCompleto</h2>
                <p>
                    @if (string.IsNullOrWhiteSpace(Model.TurmaPrincipal))
                    {
                        @I18n[
                            "Seu painel reúne os próximos passos da sua trajetória.",
                            "Your dashboard brings together the next steps in your journey.",
                            "あなたのこれからの歩みを、このダッシュボードで確認できます。"]
                    }
                    else
                    {
                        @I18n["Turma principal", "Main group", "メインクラス"]<text>: @Model.TurmaPrincipal</text>
                    }
                </p>
            </div>
        </div>
        <partial name="_AlunoStatusBadge"
                 model="new AlunoStatusBadgeViewModel(I18n.Term(Model.Status), AlunoPortalPresentation.StatusTone(Model.Status))" />
    </section>

    @if (Model.Alertas.Count > 0)
    {
        <section class="aluno-portal-alerts" aria-label="@I18n["Alertas importantes", "Important alerts", "重要なお知らせ"]">
            @foreach (var alerta in Model.Alertas)
            {
                <a class="aluno-portal-alert aluno-portal-alert--@alerta.Tipo"
                   href="@(alerta.Url ?? "#")">
                    <span class="aluno-portal-alert-mark" aria-hidden="true">!</span>
                    <span class="aluno-portal-alert-copy">
                        <strong>@alerta.Titulo</strong>
                        <span>@alerta.Descricao</span>
                    </span>
                    <span aria-hidden="true">→</span>
                </a>
            }
        </section>
    }

    <section class="aluno-portal-kpis" aria-label="@I18n["Resumo do aluno", "Student summary", "生徒情報の概要"]">
        @foreach (var metric in metrics)
        {
            <partial name="_AlunoMetricCard" model="metric" />
        }
    </section>

    <div class="aluno-portal-dashboard-grid">
        <div class="aluno-portal-stack">
            <section class="aluno-portal-panel" aria-labelledby="upcomingClassesTitle">
                <div class="aluno-portal-panel-head">
                    <div>
                        <h2 id="upcomingClassesTitle">@I18n["Próximas aulas", "Upcoming classes", "今後のレッスン"]</h2>
                        <p>@I18n["Agenda vinculada às suas turmas.", "Schedule linked to your groups.", "所属クラスの予定です。"]</p>
                    </div>
                    <a href="/area-do-aluno/aulas">@I18n["Ver aulas", "View classes", "レッスンを見る"]</a>
                </div>
                <div class="aluno-portal-list">
                    @if (Model.ProximasAulas.Count == 0)
                    {
                        <p class="aluno-portal-empty-inline">@I18n["Nenhuma aula futura cadastrada.", "No upcoming classes registered.", "今後のレッスンは登録されていません。"]</p>
                    }
                    else
                    {
                        @foreach (var aula in Model.ProximasAulas)
                        {
                            <article class="aluno-portal-list-item">
                                <strong>@aula.Turma</strong>
                                <span>@aula.Inicio.ToString("dd/MM HH:mm") – @aula.Fim.ToString("HH:mm") @(string.IsNullOrWhiteSpace(aula.Local) ? string.Empty : $"· {aula.Local}")</span>
                            </article>
                        }
                    }
                </div>
            </section>

            <section class="aluno-portal-panel" aria-labelledby="recentFeesTitle">
                <div class="aluno-portal-panel-head">
                    <h2 id="recentFeesTitle">@I18n["Mensalidades recentes", "Recent monthly fees", "最近の月謝"]</h2>
                    <a href="/area-do-aluno/financeiro">@I18n["Ver financeiro", "View finance", "お支払いを見る"]</a>
                </div>
                <div class="aluno-portal-responsive-table">
                    <table class="table aluno-portal-table">
                        <thead>
                            <tr>
                                <th>@I18n["Competência", "Period", "対象月"]</th>
                                <th>@I18n["Vencimento", "Due date", "支払期限"]</th>
                                <th>@I18n["Status", "Status", "ステータス"]</th>
                                <th class="text-end">@I18n["Valor", "Amount", "金額"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MensalidadesRecentes.Count == 0)
                            {
                                <tr class="aluno-portal-empty-row">
                                    <td colspan="4">@I18n["Nenhuma mensalidade encontrada.", "No monthly fees found.", "月謝の記録はありません。"]</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var mensalidade in Model.MensalidadesRecentes)
                                {
                                    <tr>
                                        <td data-label="@I18n["Competência", "Period", "対象月"]">@mensalidade.Competencia.ToString("MM/yyyy")</td>
                                        <td data-label="@I18n["Vencimento", "Due date", "支払期限"]">@mensalidade.DataVencimento.ToString("dd/MM/yyyy")</td>
                                        <td data-label="@I18n["Status", "Status", "ステータス"]">
                                            <partial name="_AlunoStatusBadge"
                                                     model="new AlunoStatusBadgeViewModel(I18n.Term(mensalidade.Status), AlunoPortalPresentation.StatusTone(mensalidade.Status))" />
                                        </td>
                                        <td data-label="@I18n["Valor", "Amount", "金額"]" class="text-end">@mensalidade.ValorFinal.ToString("C")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <aside class="aluno-portal-stack" aria-label="@I18n["Informações complementares", "Additional information", "その他の情報"]">
            <section class="aluno-portal-panel" aria-labelledby="recentAnnouncementsTitle">
                <div class="aluno-portal-panel-head">
                    <h2 id="recentAnnouncementsTitle">@I18n["Comunicados recentes", "Recent announcements", "最近のお知らせ"]</h2>
                    <a href="/area-do-aluno/comunicados">@I18n["Ver todos", "View all", "すべて見る"]</a>
                </div>
                <div class="aluno-portal-list">
                    @if (Model.ComunicadosRecentes.Count == 0)
                    {
                        <p class="aluno-portal-empty-inline">@I18n["Nenhum comunicado ativo.", "No active announcements.", "現在のお知らせはありません。"]</p>
                    }
                    else
                    {
                        @foreach (var comunicado in Model.ComunicadosRecentes)
                        {
                            <article class="aluno-portal-list-item">
                                <strong>@comunicado.Titulo</strong>
                                <span>
                                    @comunicado.PublicadoEmUtc.ToLocalTime().ToString("dd/MM/yyyy")
                                    · @(comunicado.Lido ? I18n["Lido", "Read", "既読"] : I18n["Novo", "New", "未読"])
                                </span>
                            </article>
                        }
                    }
                </div>
            </section>

            <section class="aluno-portal-panel" aria-labelledby="importantEventsTitle">
                <div class="aluno-portal-panel-head">
                    <h2 id="importantEventsTitle">@I18n["Eventos importantes", "Important events", "大切なイベント"]</h2>
                    <a href="/area-do-aluno/eventos">@I18n["Ver eventos", "View events", "イベントを見る"]</a>
                </div>
                <div class="aluno-portal-list">
                    @if (Model.ProximosEventos.Count == 0)
                    {
                        <p class="aluno-portal-empty-inline">@I18n["Nenhum evento futuro cadastrado.", "No upcoming events registered.", "今後のイベントは登録されていません。"]</p>
                    }
                    else
                    {
                        @foreach (var evento in Model.ProximosEventos)
                        {
                            <article class="aluno-portal-list-item">
                                <strong>@evento.Titulo</strong>
                                <span>
                                    @evento.Inicio.ToString("dd/MM HH:mm")
                                    @(evento.Importante ? $"· {I18n["Importante", "Important", "重要"]}" : string.Empty)
                                </span>
                            </article>
                        }
                    }
                </div>
            </section>

            <section class="aluno-portal-panel" aria-labelledby="shortcutsTitle">
                <div class="aluno-portal-panel-head">
                    <h2 id="shortcutsTitle">@I18n["Atalhos", "Shortcuts", "ショートカット"]</h2>
                </div>
                <div class="aluno-portal-actions">
                    <a href="/area-do-aluno/documentos">@I18n["Enviar documentos", "Send documents", "書類を提出"]</a>
                    <a href="/area-do-aluno/frequencia">@I18n["Ver frequência", "View attendance", "出席状況を見る"]</a>
                    <a href="/configuracoes">@I18n["Conta e senha", "Account and password", "アカウントとパスワード"]</a>
                    <a href="/area-do-aluno/conquistas">@I18n["Conquistas", "Achievements", "実績"]</a>
                </div>
            </section>
        </aside>
    </div>
</div>
