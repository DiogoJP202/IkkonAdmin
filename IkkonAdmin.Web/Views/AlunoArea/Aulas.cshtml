@model AreaAlunoAulasViewModel
@{
    Layout = "_AlunoLayout";
    ViewData["Title"] = I18n["Aulas e Horários", "Classes and Schedule"];
}

<section class="aluno-portal-panel mb-3">
    <div class="aluno-portal-panel-head">
        <div>
            <h3>@I18n["Próximas aulas", "Upcoming classes"]</h3>
            <p class="mb-0 text-muted">@I18n["Aulas cadastradas pela equipe para as suas turmas.", "Classes registered by the team for your groups."]</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0 aluno-portal-table">
            <thead>
                <tr>
                    <th>@I18n["Data", "Date"]</th>
                    <th>@I18n["Turma", "Group"]</th>
                    <th>@I18n["Instrutor", "Instructor"]</th>
                    <th>Local</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ProximasAulas.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">@I18n["Nenhuma aula futura cadastrada.", "No upcoming classes registered."]</td></tr>
                }
                else
                {
                    @foreach (var aula in Model.ProximasAulas)
                    {
                        <tr>
                            <td>
                                <strong>@aula.Inicio.ToString("dd/MM/yyyy")</strong>
                                <span class="d-block text-muted">@aula.Inicio.ToString("HH:mm") - @aula.Fim.ToString("HH:mm")</span>
                            </td>
                            <td>@aula.Turma</td>
                            <td>@(string.IsNullOrWhiteSpace(aula.Instrutor) ? "-" : aula.Instrutor)</td>
                            <td>@(string.IsNullOrWhiteSpace(aula.Local) ? "-" : aula.Local)</td>
                            <td><span class="aluno-portal-pill">@I18n.Term(aula.Status)</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

<section class="aluno-portal-panel">
    <div class="aluno-portal-panel-head">
        <h3>@I18n["Horários das turmas", "Group schedules"]</h3>
    </div>
    <div class="aluno-portal-turma-grid">
        @foreach (var turma in Model.Turmas)
        {
            <article class="aluno-portal-turma-card">
                <span>@turma.Modalidade</span>
                <h3>@turma.Nome</h3>
                <p>@(string.IsNullOrWhiteSpace(turma.Instrutor) ? I18n["Instrutor não informado", "Instructor not provided"] : turma.Instrutor)</p>
                @if (turma.Horarios.Count == 0)
                {
                    <small>@(string.IsNullOrWhiteSpace(turma.Horario) ? I18n["Horário não informado", "Schedule not provided"] : turma.Horario)</small>
                }
                else
                {
                    @foreach (var horario in turma.Horarios)
                    {
                        <small>@I18n.Term(horario.DiaSemana) - @horario.HoraInicio.ToString("HH:mm") @I18n["às", "to"] @horario.HoraFim.ToString("HH:mm")</small>
                    }
                }
            </article>
        }
    </div>
</section>
