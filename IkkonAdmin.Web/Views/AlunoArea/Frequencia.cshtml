@model AreaAlunoFrequenciaViewModel
@{
    Layout = "_AlunoLayout";
    ViewData["Title"] = I18n["Frequência", "Attendance"];
}

<section class="aluno-portal-kpis mb-3">
    <article>
        <span>@I18n["Presença", "Attendance"]</span>
        <strong>@Model.PercentualPresenca.ToString("0.#")%</strong>
    </article>
    <article>
        <span>@I18n["Presenças", "Presences"]</span>
        <strong>@Model.Presencas</strong>
    </article>
    <article>
        <span>@I18n["Faltas justificadas", "Excused absences"]</span>
        <strong>@Model.FaltasJustificadas</strong>
    </article>
    <article>
        <span>@I18n["Faltas não justificadas", "Unexcused absences"]</span>
        <strong>@Model.FaltasNaoJustificadas</strong>
    </article>
</section>

<section class="aluno-portal-panel">
    <div class="aluno-portal-panel-head">
        <div>
            <h3>@I18n["Histórico de frequência", "Attendance history"]</h3>
            <p class="mb-0 text-muted">@I18n["Período", "Period"]: @Model.Inicio.ToString("dd/MM/yyyy") @I18n["a", "to"] @Model.Fim.ToString("dd/MM/yyyy")</p>
        </div>
        <form method="get" class="d-flex gap-2 flex-wrap">
            <input type="date" name="inicio" value="@Model.Inicio.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <input type="date" name="fim" value="@Model.Fim.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <button class="btn btn-sm btn-outline-secondary" type="submit">@I18n["Filtrar", "Filter"]</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0 aluno-portal-table">
            <thead>
                <tr>
                    <th>@I18n["Data", "Date"]</th>
                    <th>@I18n["Turma", "Group"]</th>
                    <th>Status</th>
                    <th>@I18n["Justificativa", "Justification"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Registros.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@I18n["Nenhum registro de frequência no período.", "No attendance records in this period."]</td></tr>
                }
                else
                {
                    @foreach (var registro in Model.Registros)
                    {
                        <tr>
                            <td>@registro.Inicio.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@registro.Turma</td>
                            <td><span class="aluno-portal-pill">@I18n.Term(registro.Status)</span></td>
                            <td>@(string.IsNullOrWhiteSpace(registro.Justificativa) ? "-" : registro.Justificativa)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
