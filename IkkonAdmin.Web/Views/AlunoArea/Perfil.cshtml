@model AreaAlunoPerfilViewModel
@{
    Layout = "_AlunoLayout";
    ViewData["Title"] = I18n["Meu Perfil", "My Profile"];
}

<section class="aluno-portal-panel">
    <div class="aluno-portal-panel-head">
        <div>
            <h3>@I18n["Dados cadastrais", "Registration data"]</h3>
            <p class="mb-0 text-muted">@I18n["Informações básicas registradas pela equipe administrativa.", "Basic information registered by the administrative team."]</p>
        </div>
    </div>

    <div class="aluno-portal-data-grid">
        <article><span>@I18n["Nome completo", "Full name"]</span><strong>@Model.NomeCompleto</strong></article>
        <article><span>CPF</span><strong>@Model.CPF</strong></article>
        <article><span>RG</span><strong>@(string.IsNullOrWhiteSpace(Model.RG) ? "-" : Model.RG)</strong></article>
        <article><span>@I18n["Data de nascimento", "Birth date"]</span><strong>@(Model.DataNascimento.HasValue ? Model.DataNascimento.Value.ToString("dd/MM/yyyy") : "-")</strong></article>
        <article><span>E-mail</span><strong>@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</strong></article>
        <article><span>@I18n["Celular", "Mobile"]</span><strong>@(string.IsNullOrWhiteSpace(Model.Celular) ? "-" : Model.Celular)</strong></article>
        <article><span>@I18n["Contato de emergência", "Emergency contact"]</span><strong>@(string.IsNullOrWhiteSpace(Model.ContatoEmergencia) ? "-" : Model.ContatoEmergencia)</strong></article>
        <article><span>Status</span><strong>@I18n.Term(Model.Status)</strong></article>
        <article class="aluno-portal-data-wide"><span>@I18n["Endereço", "Address"]</span><strong>@(string.IsNullOrWhiteSpace(Model.Endereco) ? "-" : Model.Endereco)</strong></article>
    </div>
</section>
