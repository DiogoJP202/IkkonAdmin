@model AreaAlunoConquistasViewModel
@{
    Layout = "_AlunoLayout";
    ViewData["Title"] = "Conquistas";
}

<section class="aluno-portal-panel">
    <div class="aluno-portal-panel-head">
        <div>
            <h3>Insignias e marcos</h3>
            <p class="mb-0 text-muted">Conquistas adicionadas pela equipe ou geradas automaticamente.</p>
        </div>
    </div>

    <div class="aluno-portal-turma-grid">
        @if (Model.Conquistas.Count == 0)
        {
            <p class="text-muted mb-0">Nenhuma conquista registrada ainda.</p>
        }
        else
        {
            @foreach (var conquista in Model.Conquistas)
            {
                <article class="aluno-portal-turma-card">
                    <span>@(string.IsNullOrWhiteSpace(conquista.Categoria) ? "Conquista" : conquista.Categoria)</span>
                    <h3>@conquista.Nome</h3>
                    <p>@(string.IsNullOrWhiteSpace(conquista.Descricao) ? "Marco registrado na sua jornada." : conquista.Descricao)</p>
                    <small>@conquista.Origem | @conquista.ConcedidaEmUtc.ToLocalTime().ToString("dd/MM/yyyy")</small>
                    @if (!string.IsNullOrWhiteSpace(conquista.Observacao))
                    {
                        <small>@conquista.Observacao</small>
                    }
                </article>
            }
        }
    </div>
</section>
