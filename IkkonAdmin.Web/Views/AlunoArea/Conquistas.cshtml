@model AreaAlunoConquistasViewModel
@{
    Layout = "_AlunoLayout";
    ViewData["Title"] = I18n["Conquistas", "Achievements"];
}

<section class="aluno-portal-panel">
    <div class="aluno-portal-panel-head">
        <div>
            <h3>@I18n["Insígnias e marcos", "Badges and milestones"]</h3>
            <p class="mb-0 text-muted">@I18n["Conquistas adicionadas pela equipe ou geradas automaticamente.", "Achievements added by the team or generated automatically."]</p>
        </div>
    </div>

    <div class="aluno-portal-turma-grid">
        @if (Model.Conquistas.Count == 0)
        {
            <p class="text-muted mb-0">@I18n["Nenhuma conquista registrada ainda.", "No achievements registered yet."]</p>
        }
        else
        {
            @foreach (var conquista in Model.Conquistas)
            {
                <article class="aluno-portal-turma-card">
                    <span>@(string.IsNullOrWhiteSpace(conquista.Categoria) ? I18n["Conquista", "Achievement"] : conquista.Categoria)</span>
                    <h3>@conquista.Nome</h3>
                    <p>@(string.IsNullOrWhiteSpace(conquista.Descricao) ? I18n["Marco registrado na sua jornada.", "Milestone registered in your journey."] : conquista.Descricao)</p>
                    <small>@I18n.Term(conquista.Origem) | @conquista.ConcedidaEmUtc.ToLocalTime().ToString("dd/MM/yyyy")</small>
                    @if (!string.IsNullOrWhiteSpace(conquista.Observacao))
                    {
                        <small>@conquista.Observacao</small>
                    }
                </article>
            }
        }
    </div>
</section>
