@model BlogCategoryIndexViewModel
@{
    ViewData["Title"] = "Categorias do blog";
}

<div class="admin-panel-v2-page blog-admin-page">
    <section class="admin-panel-v2-hero is-compact">
        <div class="admin-panel-hero-copy">
            <span class="admin-panel-eyebrow">Categorias</span>
            <h1 class="admin-panel-title">Estrutura editorial do Blog</h1>
            <p class="admin-panel-subtitle">Mantenha categorias ativas para filtros e organização pública futura.</p>
            <div class="admin-panel-meta">
                <span>Total <strong>@Model.TotalCategories</strong></span>
                <span>Ativas <strong>@Model.ActiveCategories</strong></span>
                <span>Inativas <strong>@Model.InactiveCategories</strong></span>
            </div>
        </div>
        <div class="admin-panel-hero-actions">
            <a asp-action="Create" class="btn admin-panel-btn admin-panel-btn-primary">Nova categoria</a>
            <a asp-controller="BlogAdmin" asp-action="Index" class="btn admin-panel-btn admin-panel-btn-ghost">Voltar para posts</a>
        </div>
    </section>

    <section class="admin-panel-card-v2">
        <div class="admin-panel-card-header">
            <div>
                <h2>Categorias cadastradas</h2>
                <p>Use ativação e desativação para controlar disponibilidade sem perder histórico.</p>
            </div>
        </div>

        <div class="admin-panel-table-wrap table-responsive">
            <table class="table admin-panel-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Categoria</th>
                        <th>Slug</th>
                        <th>Descrição</th>
                        <th>Posts</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-panel-empty">Nenhuma categoria cadastrada.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var categoria in Model.Categories)
                        {
                            <tr>
                                <td>
                                    <div class="admin-panel-primary-cell">
                                        <strong>@categoria.Name</strong>
                                        <small>Criada em @categoria.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</small>
                                    </div>
                                </td>
                                <td><code class="admin-panel-code">@categoria.Slug</code></td>
                                <td>@(categoria.Description ?? "-")</td>
                                <td>@categoria.TotalPosts</td>
                                <td>
                                    <span class="admin-panel-badge @(categoria.IsActive ? "is-success" : "is-muted")">
                                        @(categoria.IsActive ? "Ativa" : "Inativa")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="admin-panel-row-actions">
                                        <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn admin-panel-btn-table">Editar</a>
                                        <form asp-action="ToggleStatus" asp-route-id="@categoria.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ativo" value="@(categoria.IsActive ? "false" : "true")" />
                                            <button type="submit" class="btn admin-panel-btn-table @(categoria.IsActive ? "is-warning" : "is-success")">
                                                @(categoria.IsActive ? "Desativar" : "Ativar")
                                            </button>
                                        </form>
                                        @if (categoria.TotalPosts == 0)
                                        {
                                            <form asp-action="Delete" asp-route-id="@categoria.Id" method="post" onsubmit="return confirm('Excluir esta categoria?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn admin-panel-btn-table is-danger">Excluir</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
