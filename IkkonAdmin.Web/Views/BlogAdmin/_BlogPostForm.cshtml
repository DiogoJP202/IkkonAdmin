@using IkkonAdmin.Web.Security
@model BlogPostFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    var canFeature = User.HasPermission(AppPermissions.BlogFeature);
    var canPublish = User.HasPermission(AppPermissions.BlogPublish);
    var canArchive = User.HasPermission(AppPermissions.BlogArchive);
    var canManageCategories = User.HasPermission(AppPermissions.BlogCategoryManage);
    var canManageVersions = isEdit && (User.HasPermission(AppPermissions.BlogCreate) || User.HasPermission(AppPermissions.BlogEdit) || User.HasPermission(AppPermissions.BlogDelete));
}

@functions {
    private static string StatusTexto(BlogPostStatusEnum status)
    {
        return status switch
        {
            BlogPostStatusEnum.Draft => "Rascunho",
            BlogPostStatusEnum.Scheduled => "Agendado",
            BlogPostStatusEnum.Published => "Publicado",
            BlogPostStatusEnum.Archived => "Arquivado",
            _ => status.ToString()
        };
    }

    private static string StatusClasse(BlogPostStatusEnum status)
    {
        return status switch
        {
            BlogPostStatusEnum.Draft => "is-muted",
            BlogPostStatusEnum.Scheduled => "is-warning",
            BlogPostStatusEnum.Published => "is-success",
            BlogPostStatusEnum.Archived => "is-dark",
            _ => "is-muted"
        };
    }
}

<div class="admin-panel-v2-page blog-admin-page">
    <section class="admin-panel-v2-hero">
        <div class="admin-panel-hero-copy">
            <span class="admin-panel-eyebrow">@(isEdit ? "Edição de post" : "Novo post")</span>
            <h1 class="admin-panel-title">@(isEdit ? "Editar post do Blog" : "Criar post do Blog")</h1>
            <p class="admin-panel-subtitle">
                Use o editor para estruturar texto, imagens e vídeos do YouTube. O conteúdo é sanitizado no backend antes de ser publicado.
            </p>
            <div class="admin-panel-meta">
                <span>Status <strong>@StatusTexto(Model.CurrentStatus)</strong></span>
                @if (isEdit)
                {
                    <span>ID <strong>#@Model.Id</strong></span>
                    <span>Idioma <strong>@Model.LanguageLabel</strong></span>
                }
            </div>
        </div>
        <div class="admin-panel-hero-actions">
            @if (isEdit)
            {
                @if (canManageVersions)
                {
                    <button type="button" id="blogVersionsButton" class="btn admin-panel-btn admin-panel-btn-ghost" data-bs-toggle="modal" data-bs-target="#blogVersionsModal">Versões</button>
                }
                <a asp-action="Preview" asp-route-id="@Model.Id" class="btn admin-panel-btn admin-panel-btn-ghost">Preview</a>
            }
            <a asp-action="Index" class="btn admin-panel-btn admin-panel-btn-ghost">Voltar para lista</a>
        </div>
    </section>

    <div class="admin-panel-grid admin-panel-grid-aside">
        <section class="admin-panel-card-v2">
            <form id="blogPostForm" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-panel-form-stack">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="LanguageCode" type="hidden" />
                <input asp-for="TranslationGroupId" type="hidden" />
                <input asp-for="SubmissionAction" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger admin-panel-validation"></div>

                <div class="admin-panel-card-header">
                    <div>
                        <h2>Dados do post</h2>
                        <p>Identificação editorial, SEO básico, capa e parâmetros de publicação.</p>
                    </div>
                    <span class="admin-panel-badge @StatusClasse(Model.CurrentStatus)">@StatusTexto(Model.CurrentStatus)</span>
                </div>

                <div class="admin-panel-form-grid">
                    <div class="admin-panel-field admin-panel-field-wide">
                        <label asp-for="Title">Título</label>
                        <input asp-for="Title" class="form-control admin-panel-control" autocomplete="off" maxlength="180" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="admin-panel-field admin-panel-field-wide">
                        <label asp-for="Slug">Slug</label>
                        <input asp-for="Slug" class="form-control admin-panel-control" autocomplete="off" maxlength="180" />
                        <small class="admin-panel-help">Se deixar vazio, o sistema gera a partir do título.</small>
                        <span asp-validation-for="Slug" class="text-danger"></span>
                    </div>

                    <div class="admin-panel-field admin-panel-field-full">
                        <label asp-for="Summary">Resumo</label>
                        <textarea asp-for="Summary" class="form-control admin-panel-control" rows="3" maxlength="500" placeholder="Resumo curto para cards e SEO básico."></textarea>
                        <span asp-validation-for="Summary" class="text-danger"></span>
                    </div>

                    <div class="admin-panel-field">
                        <label asp-for="CategoryId">Categoria</label>
                        <div class="blog-admin-category-row">
                            <select asp-for="CategoryId" class="form-select admin-panel-control">
                                <option value="">Selecione</option>
                                @foreach (var categoria in Model.CategoryOptions)
                                {
                                    <option value="@categoria.Id">@categoria.Name</option>
                                }
                            </select>
                            @if (canManageCategories)
                            {
                                <button type="button" class="btn admin-panel-btn admin-panel-btn-ghost blog-admin-category-manage" data-bs-toggle="modal" data-bs-target="#blogCategoryModal">
                                    Adicionar
                                </button>
                            }
                        </div>
                        @if (canManageCategories && Model.CategoryOptions.Count == 0)
                        {
                            <small class="admin-panel-help">Nenhuma categoria ativa cadastrada. Use Adicionar para criar a primeira.</small>
                        }
                    </div>

                    <div class="admin-panel-field">
                        <label asp-for="AuthorUserId">Autor responsável</label>
                        <select asp-for="AuthorUserId" class="form-select admin-panel-control">
                            <option value="">Selecione</option>
                            @foreach (var autor in Model.AuthorOptions)
                            {
                                <option value="@autor.Id">@autor.Nome</option>
                            }
                        </select>
                    </div>

                    <div class="admin-panel-field">
                        <label asp-for="PublicationDateLocal">Publicação/agendamento</label>
                        <input id="PublicationDateLocal"
                               name="PublicationDateLocal"
                               type="datetime-local"
                               class="form-control admin-panel-control"
                               value="@(Model.PublicationDateLocal?.ToString("yyyy-MM-ddTHH:mm"))" />
                        <small class="admin-panel-help">Use este campo para agendar ou registrar uma data de publicação.</small>
                    </div>

                    <div class="admin-panel-field">
                        <label asp-for="TagsInput">Tags</label>
                        <textarea asp-for="TagsInput" hidden></textarea>
                        <div class="blog-admin-tag-picker" id="blogTagPicker">
                            <div class="blog-admin-tag-list" id="blogTagList" aria-live="polite"></div>
                            <div class="blog-admin-tag-entry">
                                <input id="blogTagInput" type="text" class="form-control admin-panel-control" list="blogTagSuggestions" placeholder="Digite uma tag e pressione Enter" autocomplete="off" />
                                <button type="button" id="blogAddTagButton" class="btn admin-panel-btn admin-panel-btn-ghost">Adicionar</button>
                            </div>
                        </div>
                        <datalist id="blogTagSuggestions">
                            @foreach (var tag in Model.TagSuggestions)
                            {
                                <option value="@tag"></option>
                            }
                        </datalist>
                        <small class="admin-panel-help">Use Enter para adicionar, clique no X para remover. O limite é de 12 tags.</small>
                    </div>

                    @if (canFeature)
                    {
                        <label class="admin-panel-check-card is-form-check">
                            <input asp-for="IsFeatured" class="form-check-input" />
                            <span>Marcar como destaque</span>
                        </label>

                        <label class="admin-panel-check-card is-form-check">
                            <input asp-for="IsWeeklyHighlight" class="form-check-input" />
                            <span>Marcar como blog da semana</span>
                        </label>
                    }

                    <div class="admin-panel-field admin-panel-field-full">
                        <label asp-for="ContentInput">Conteúdo</label>
                        <div class="blog-admin-editor-shell">
                            <div id="blogEditorToolbar" class="blog-admin-editor-toolbar">
                                <span class="ql-formats">
                                    <select class="ql-header" aria-label="Formato do texto">
                                        <option value="2">Título</option>
                                        <option value="3">Subtítulo</option>
                                        <option selected>Texto</option>
                                    </select>
                                </span>
                                <span class="ql-formats">
                                    <button type="button" class="ql-bold" aria-label="Negrito"></button>
                                    <button type="button" class="ql-italic" aria-label="Itálico"></button>
                                </span>
                                <span class="ql-formats">
                                    <button type="button" class="ql-list" value="ordered" aria-label="Lista numerada"></button>
                                    <button type="button" class="ql-list" value="bullet" aria-label="Lista com marcadores"></button>
                                </span>
                                <span class="ql-formats">
                                    <button type="button" class="ql-link" aria-label="Inserir link"></button>
                                    <button type="button" class="ql-image" aria-label="Inserir imagem"></button>
                                    <button type="button" class="ql-blockquote" aria-label="Citação"></button>
                                    <button type="button" class="ql-video" aria-label="Inserir vídeo do YouTube"></button>
                                </span>
                                <span class="ql-formats">
                                    <button type="button" class="ql-clean" aria-label="Limpar formatação"></button>
                                </span>
                            </div>
                            <div id="blogContentEditor"
                                 class="blog-admin-rich-editor"
                                 data-image-upload-url="@Url.Action("UploadContentImage", "BlogAdmin")"
                                 data-placeholder="Escreva o conteúdo do post com títulos, listas, links, citações e vídeos do YouTube."></div>
                        </div>
                        <textarea asp-for="ContentInput" hidden></textarea>
                        <textarea asp-for="ContentHtmlInput" hidden></textarea>
                        <textarea asp-for="ContentJsonInput" hidden></textarea>
                        <small class="admin-panel-help">O conteúdo é salvo como Delta JSON, HTML sanitizado e texto limpo para busca.</small>
                    </div>

                    <div class="admin-panel-field">
                        <label asp-for="SeoTitle">Meta title</label>
                        <input asp-for="SeoTitle" class="form-control admin-panel-control" maxlength="180" />
                        <span asp-validation-for="SeoTitle" class="text-danger"></span>
                    </div>

                    <div class="admin-panel-field admin-panel-field-wide">
                        <label asp-for="SeoDescription">Meta description</label>
                        <textarea asp-for="SeoDescription" class="form-control admin-panel-control" rows="3" maxlength="320"></textarea>
                        <span asp-validation-for="SeoDescription" class="text-danger"></span>
                    </div>

                    <div class="admin-panel-field admin-panel-field-full">
                        <label asp-for="CoverImage">Imagem de capa</label>
                        <div class="blog-admin-cover-box">
                            <img id="blogCoverPreview"
                                 src="@(string.IsNullOrWhiteSpace(Model.CurrentCoverImageUrl) ? "/Images/Ikkon_Icon.png" : Model.CurrentCoverImageUrl)"
                                 alt="Preview da capa"
                                 class="blog-admin-cover-preview" />
                            <div class="blog-admin-cover-fields">
                                <input asp-for="CoverImage" class="form-control admin-panel-control" type="file" accept="image/png,image/jpeg,image/webp" />
                                <small class="admin-panel-help">JPG, PNG ou WEBP até 3 MB.</small>
                                @if (!string.IsNullOrWhiteSpace(Model.CurrentCoverImageUrl))
                                {
                                    <label class="admin-panel-check-card is-form-check">
                                        <input asp-for="RemoveCoverImage" class="form-check-input" />
                                        <span>Remover capa atual</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="admin-panel-form-actions">
                        <a asp-action="Index" class="btn admin-panel-btn admin-panel-btn-ghost">Cancelar</a>
                        <button type="button" class="btn admin-panel-btn admin-panel-btn-ghost" data-blog-submit="Draft">Salvar rascunho</button>
                        @if (canPublish)
                        {
                            <button type="button" class="btn admin-panel-btn admin-panel-btn-ghost" data-blog-submit="Schedule">Agendar</button>
                        }
                        @if (isEdit && canArchive)
                        {
                            <button type="button" class="btn admin-panel-btn admin-panel-btn-danger" data-blog-submit="Archive">Arquivar</button>
                        }
                        @if (canPublish)
                        {
                            <button type="button" class="btn admin-panel-btn admin-panel-btn-primary" data-blog-submit="Publish">Publicar</button>
                        }
                    </div>
                </div>
            </form>
            @if (canManageCategories)
            {
                <div class="modal fade blog-admin-category-modal"
                     id="blogCategoryModal"
                     tabindex="-1"
                     aria-labelledby="blogCategoryModalLabel"
                     aria-hidden="true"
                     data-modal-data-url="@Url.Action("ModalData", "BlogCategorias")"
                     data-create-url="@Url.Action("ModalCreate", "BlogCategorias")"
                     data-edit-url-template="/admin/blog/categorias/modal/editar/__id__"
                     data-status-url-template="/admin/blog/categorias/modal/status/__id__"
                     data-delete-url-template="/admin/blog/categorias/modal/excluir/__id__">
                    <div class="modal-dialog modal-xl modal-dialog-scrollable">
                        <div class="modal-content blog-admin-category-modal-content">
                            <div class="modal-header">
                                <div>
                                    <p class="admin-panel-eyebrow mb-1">Categorias</p>
                                    <h2 class="modal-title" id="blogCategoryModalLabel">Organizar categorias do Blog</h2>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                            </div>
                            <div class="modal-body">
                                <div id="blogCategoryModalAlert" class="alert d-none" role="alert"></div>
                                <div class="blog-admin-category-modal-grid">
                                    <section class="blog-admin-category-editor">
                                        <input type="hidden" id="blogCategoryEditId" />
                                        <div class="admin-panel-field">
                                            <label for="blogCategoryName">Nome</label>
                                            <input id="blogCategoryName" class="form-control admin-panel-control" maxlength="120" autocomplete="off" />
                                        </div>
                                        <div class="admin-panel-field">
                                            <label for="blogCategorySlug">Slug</label>
                                            <input id="blogCategorySlug" class="form-control admin-panel-control" maxlength="140" autocomplete="off" />
                                            <small class="admin-panel-help">Opcional. Se ficar vazio, o sistema gera pelo nome.</small>
                                        </div>
                                        <div class="admin-panel-field">
                                            <label for="blogCategoryDescription">Descrição</label>
                                            <textarea id="blogCategoryDescription" class="form-control admin-panel-control" rows="3" maxlength="400"></textarea>
                                        </div>
                                        <label class="admin-panel-check-card is-form-check">
                                            <input id="blogCategoryIsActive" type="checkbox" class="form-check-input" checked />
                                            <span>Categoria ativa</span>
                                        </label>
                                        <div class="blog-admin-category-modal-actions">
                                            <button type="button" id="blogCategorySaveButton" class="btn admin-panel-btn admin-panel-btn-primary">Salvar categoria</button>
                                            <button type="button" id="blogCategoryClearButton" class="btn admin-panel-btn admin-panel-btn-ghost">Limpar</button>
                                        </div>
                                    </section>
                                    <section class="blog-admin-category-list-shell">
                                        <div class="admin-panel-card-header">
                                            <div>
                                                <h3>Categorias cadastradas</h3>
                                                <p>Edite, desative ou exclua categorias sem sair do post.</p>
                                            </div>
                                        </div>
                                        <div id="blogCategoryModalList" class="blog-admin-category-list"></div>
                                    </section>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn admin-panel-btn admin-panel-btn-primary" data-bs-dismiss="modal">Concluir</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (canManageVersions)
            {
                <div class="modal fade blog-version-modal"
                     id="blogVersionsModal"
                     tabindex="-1"
                     aria-labelledby="blogVersionsModalLabel"
                     aria-hidden="true"
                     data-versions-url="@Url.Action("Versions", "BlogAdmin", new { id = Model.Id })"
                     data-create-url="@Url.Action("CreateVersion", "BlogAdmin", new { id = Model.Id })"
                     data-delete-url-template="/admin/blog/@Model.Id/versoes/excluir/__id__">
                    <div class="modal-dialog modal-xl modal-dialog-scrollable">
                        <div class="modal-content blog-version-modal-content">
                            <div class="modal-header">
                                <div>
                                    <p class="admin-panel-eyebrow mb-1">Idiomas</p>
                                    <h2 class="modal-title" id="blogVersionsModalLabel">Versões do post</h2>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                            </div>
                            <div class="modal-body">
                                <div id="blogVersionsModalAlert" class="alert d-none" role="alert"></div>
                                <div id="blogVersionsModalBody" class="blog-version-modal-body">
                                    <div class="blog-admin-category-empty">Carregando versões...</div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn admin-panel-btn admin-panel-btn-primary" data-bs-dismiss="modal">Concluir</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </section>

        <aside class="admin-panel-form-stack">
            <section class="admin-panel-card-v2">
                <div class="admin-panel-card-header">
                    <div>
                        <h2>Recursos editoriais</h2>
                        <p>Ferramentas disponíveis para montar e publicar posts do Blog.</p>
                    </div>
                </div>
                <div class="admin-stat-list">
                    <div class="admin-stat-row"><span>Editor</span><strong>Quill com HTML sanitizado</strong></div>
                    <div class="admin-stat-row"><span>Mídia</span><strong>Capa e imagens locais</strong></div>
                    <div class="admin-stat-row"><span>Tags</span><strong>Chips editáveis</strong></div>
                    <div class="admin-stat-row"><span>Preview</span><strong>Administrativo</strong></div>
                </div>
            </section>

            <section class="admin-panel-card-v2">
                <div class="admin-panel-card-header">
                    <div>
                        <h2>Checklist editorial</h2>
                        <p>Para publicar ou agendar, o serviço exige os campos essenciais.</p>
                    </div>
                </div>
                <div class="admin-panel-action-list">
                    <div class="admin-stat-row"><span>Título e slug</span><strong>Obrigatórios</strong></div>
                    <div class="admin-stat-row"><span>Resumo e conteúdo</span><strong>Obrigatórios</strong></div>
                    <div class="admin-stat-row"><span>Categoria e autor</span><strong>Obrigatórios</strong></div>
                    <div class="admin-stat-row"><span>Imagem de capa</span><strong>Obrigatória para publicar</strong></div>
                </div>
            </section>

            @if (isEdit)
            {
                <section class="admin-panel-card-v2">
                    <div class="admin-panel-card-header">
                        <div>
                            <h2>Metadados</h2>
                            <p>Histórico técnico do post atual.</p>
                        </div>
                    </div>
                    <div class="admin-stat-list">
                        <div class="admin-stat-row"><span>Criado em</span><strong>@Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
                        <div class="admin-stat-row"><span>Atualizado em</span><strong>@(Model.UpdatedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</strong></div>
                        <div class="admin-stat-row"><span>Publicado em</span><strong>@(Model.PublishedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</strong></div>
                    </div>
                </section>
            }
        </aside>
    </div>
</div>
